tent":"3"},"1785":{"id":"/docs/deploy-27","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-ladder","content":"Kubernetes"},"1786":{"id":"/docs/deploy-28","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-ladder","content":"You run a cluster — kind/k3d to learn the chart, then on-prem or managed."},"1787":{"id":"/docs/deploy-29","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-ladder","content":"`k8s_job` (Jobs in an isolated namespace)"},"1788":{"id":"/docs/deploy-30","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-ladder","content":"Available · smoke-tested on kind/k3d, contract-tested for on-prem"},"1789":{"id":"/docs/deploy-31","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-ladder","content":"4"},"1790":{"id":"/docs/deploy-32","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-ladder","content":"AWS"},"1791":{"id":"/docs/deploy-33","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-ladder","content":"You want managed Postgres, a managed secret store and a load balancer with a certificate around the same chart."},"1792":{"id":"/docs/deploy-34","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-ladder","content":"`k8s_job`"},"1793":{"id":"/docs/deploy-35","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-ladder","content":"Reference architecture — every piece is supported by the chart; the ready-made values file is not shipped yet"},"1794":{"id":"/docs/deploy-36","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-ladder","content":"—"},"1795":{"id":"/docs/deploy-37","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-ladder","content":"Operations"},"1796":{"id":"/docs/deploy-38","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-ladder","content":"You already run one of the above and need releases, upgrades, secrets, backups, health."},"1797":{"id":"/docs/deploy-39","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"**Eight processes, four databases, one queue.**"},"1798":{"id":"/docs/deploy-40","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"Process"},"1799":{"id":"/docs/deploy-41","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"What it does"},"1800":{"id":"/docs/deploy-42","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"Talks to"},"1801":{"id":"/docs/deploy-43","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"`web`"},"1802":{"id":"/docs/deploy-44","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"Serves NexChat and forwards API and sign-in traffic. The one public origin."},"1803":{"id":"/docs/deploy-45","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"the three APIs, Keycloak"},"1804":{"id":"/docs/deploy-46","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"`core-api`"},"1805":{"id":"/docs/deploy-47","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"The Platform API: sessions, organizations, access policy, capability catalog, models, connections, audit."},"1806":{"id":"/docs/deploy-48","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"its database, Keycloak, model providers, your systems"},"1807":{"id":"/docs/deploy-49","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"`chat-api`"},"1808":{"id":"/docs/deploy-50","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"The Chat API: Projects, chats, agents, skills, flows. Accepts work and puts it on the job bus."},"1809":{"id":"/docs/deploy-51","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"its database, NATS, core-api, tasks-api"},"1810":{"id":"/docs/deploy-52","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"`chat-worker`"},"1811":{"id":"/docs/deploy-53","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"Drains the job bus: agent turns, flow steps, triggers. The API never does this itself."},"1812":{"id":"/docs/deploy-54","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"its database, NATS, core-api, tasks-api"},"1813":{"id":"/docs/deploy-55","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"`sandbox-manager`"},"1814":{"id":"/docs/deploy-56","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"Starts one throw-away container or Job per code execution and collects the result. The only process with that power."},"1815":{"id":"/docs/deploy-57","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"its database, NATS, the isolation backend"},"1816":{"id":"/docs/deploy-58","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"`tasks-api`"},"1817":{"id":"/docs/deploy-59","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"Approvals: requests, decisions, evidence — and, behind `TASKS_WORK_DOMAIN`, VibeBan's work projects, items, iterations, milestones and references. Tells chat-api what was decided."},"1818":{"id":"/docs/deploy-60","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"its database, chat-api, core-api"},"1819":{"id":"/docs/deploy-61","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"`keycloak`"},"1820":{"id":"/docs/deploy-62","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"Sign-up, sign-in, password reset, single sign-on. Own database; public only at `/idp/realms/nexus`."},"1821":{"id":"/docs/deploy-63","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"its database, your mail server, Google or your enterprise IdP"},"1822":{"id":"/docs/deploy-64","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"`sandbox-python`"},"1823":{"id":"/docs/deploy-65","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"The image every sandbox execution runs in. No network, no credentials, read-only."},"1824":{"id":"/docs/deploy-66","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"nothing"},"1825":{"id":"/docs/deploy-67","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-every-target-has-in-common","content":"Plus **PostgreSQL 16** (databases `nexus_core`, `nexus_chat`, `nexus_tasks`, `nexus_keycloak`) and **NATS JetStream**\n(jobs and events — never the business state: if a message is lost, the truth is still in the database)."},"1826":{"id":"/docs/deploy-68","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"NexGraph adds four processes and two small models. They run on the laptop now. The Compose\nfile and the Helm chart are prepared for them — the PostgreSQL image they need is selectable through\n`POSTGRES_IMAGE` (`nexus/postgres`: PostgreSQL 16 with **Apache AGE** and **pgvector**, built from\n`deploy/docker/postgres/Dockerfile`; the stock `postgres:16` stays the default until the family ships), the chart\ncreates the database roles, and chat-api's settings already point at `graph-api` — but the process definitions\nthemselves arrive in a coming release. Plan capacity for them now."},"1827":{"id":"/docs/deploy-69","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"Process"},"1828":{"id":"/docs/deploy-70","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"What it does"},"1829":{"id":"/docs/deploy-71","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"Talks to"},"1830":{"id":"/docs/deploy-72","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"`graph-web`"},"1831":{"id":"/docs/deploy-73","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"Serves NexGraph — Overview, Sources, Pipeline, Graph Studio, Evidence, Review, Vocabulary. Behind `web` at `/graph` on the packaged targets."},"1832":{"id":"/docs/deploy-74","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"graph-api, chat-api, core-api"},"1833":{"id":"/docs/deploy-75","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"`graph-api`"},"1834":{"id":"/docs/deploy-76","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"The Graph API: sources and versions, runs, the allowed subgraph, evidence, claim review, vocabulary, evidence bundles for NexChat. Owns `nexus_graph` as its own role, row-level security on."},"1835":{"id":"/docs/deploy-77","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"its database, NATS, core-api, chat-api, the Model Gateway (reranker)"},"1836":{"id":"/docs/deploy-78","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"`graph-worker` + `dagster-daemon`"},"1837":{"id":"/docs/deploy-79","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"The six-stage pipeline as Dagster assets: snapshot, structure (Docling), extraction (GLiNER-X), subject graph, verification (oracles), index (embeddings). Writes under row-level security, no DDL, **no egress** beyond Postgres, NATS and core-api."},"1838":{"id":"/docs/deploy-80","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"`nexus_graph` as `graph_worker`, `nexus_dagster`, the Model Gateway (embedder)"},"1839":{"id":"/docs/deploy-81","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"`dagster-webserver` (optional, operators)"},"1840":{"id":"/docs/deploy-82","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"The pipeline's own UI. Never behind the public origin."},"1841":{"id":"/docs/deploy-83","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"`nexus_dagster`, graph-worker"},"1842":{"id":"/docs/deploy-84","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"`llama-embedder` · `llama-reranker`"},"1843":{"id":"/docs/deploy-85","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"Qwen3-Embedding-0.6B and Qwen3-Reranker-0.6B on llama.cpp, reached only through the Model Gateway. On the laptop: Ollama for the embedder."},"1844":{"id":"/docs/deploy-86","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"core-api"},"1845":{"id":"/docs/deploy-87","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-knowledge-family--on-the-laptop-today-in-the-release-images-next","content":"Databases `nexus_graph` (Bronze bytes, Silver items and vectors, the Gold graph in AGE) and `nexus_dagster&#x60; (the\nworker's own run history — no Nexi code reads it). Budget roughly **+5 GB*&#x2A; of images and weights (the worker image\nwith Docling and GLiNER-X, the two GGUFs) and **+1.5 GB RAM** at idle, 2 GB more while a document is parsed."},"1846":{"id":"/docs/deploy-88","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#vibeban-and-nexbi--on-the-laptop-today-in-the-release-images-next","content":"The `tasks-api` image already ships and now carries the **work domain** (`TASKS_WORK_DOMAIN`) in the same database\n`nexus_tasks`; the VibeBan web and the whole NexBI pair are laptop processes for now. Their definitions join the Compose\nfile and the chart in a coming release; the chart will need one more database and role."},"1847":{"id":"/docs/deploy-89","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#vibeban-and-nexbi--on-the-laptop-today-in-the-release-images-next","content":"Process"},"1848":{"id":"/docs/deploy-90","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#vibeban-and-nexbi--on-the-laptop-today-in-the-release-images-next","content":"What it does"},"1849":{"id":"/docs/deploy-91","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#vibeban-and-nexbi--on-the-laptop-today-in-the-release-images-next","content":"Talks to"},"1850":{"id":"/docs/deploy-92","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#vibeban-and-nexbi--on-the-laptop-today-in-the-release-images-next","content":"`tasks-web`"},"1851":{"id":"/docs/deploy-93","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#vibeban-and-nexbi--on-the-laptop-today-in-the-release-images-next","content":"Serves VibeBan — My Work, Inbox, projects, boards, iterations, milestones, references. Behind `web` at `/tasks` on the packaged targets."},"1852":{"id":"/docs/deploy-94","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#vibeban-and-nexbi--on-the-laptop-today-in-the-release-images-next","content":"tasks-api, core-api"},"1853":{"id":"/docs/deploy-95","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#vibeban-and-nexbi--on-the-laptop-today-in-the-release-images-next","content":"`bi-api`"},"1854":{"id":"/docs/deploy-96","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#vibeban-and-nexbi--on-the-laptop-today-in-the-release-images-next","content":"The BI API: datasets and versions, the semantic model, metrics, the governed query engine, dashboards, templates, automations. Owns `nexus_bi`; runs governed queries as the read-only role `bi_query` (8 s · 1 000 rows · cost guard). Relays its outbox to chat-api over HTTP."},"1855":{"id":"/docs/deploy-97","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#vibeban-and-nexbi--on-the-laptop-today-in-the-release-images-next","content":"its database, core-api, chat-api, graph-api"},"1856":{"id":"/docs/deploy-98","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#vibeban-and-nexbi--on-the-laptop-today-in-the-release-images-next","content":"`bi-web`"},"1857":{"id":"/docs/deploy-99","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#vibeban-and-nexbi--on-the-laptop-today-in-the-release-images-next","content":"Serves NexBI — Overview, Dashboards, Data, Metrics, Automations, Insights. Behind `web` at `/bi` on the packaged targets."},"1858":{"id":"/docs/deploy-100","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#vibeban-and-nexbi--on-the-laptop-today-in-the-release-images-next","content":"bi-api, core-api"},"1859":{"id":"/docs/deploy-101","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#vibeban-and-nexbi--on-the-laptop-today-in-the-release-images-next","content":"Database `nexus_bi` (datasets as tables, metrics, dashboards and their versions, query records, decision records).\nBudget is small — no models of its own; the query guard bounds the load a dashboard refresh can put on Postgres.\nThe dev stack runs `scripts/product-metrics.py` at start to seed the platform dashboards; on packaged targets that\nmeasurement becomes a scheduled Flow."},"1860":{"id":"/docs/deploy-102","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"NexMap, NexCare and NexForge are **profiles**: `deploy/contract.yaml` lists their APIs under `profile: map | care |\nforge`; Compose starts `migrate-<module>` and `<module>-api` only with the profile; the chart has `map.enabled`,\n`care.enabled` and `forge.enabled`, all off, with a NetworkPolicy that lets a module API reach postgres, core-api and\nchat-api and nothing else. Installing the pack in NexCore does not start a process — the operator turns the profile\non, then the Owner installs the pack; the module's web app shows *not enabled* in between. The laptop stack runs all\nthree."},"1861":{"id":"/docs/deploy-103","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"Process"},"1862":{"id":"/docs/deploy-104","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"What it does"},"1863":{"id":"/docs/deploy-105","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"Talks to"},"1864":{"id":"/docs/deploy-106","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"`map-api` (:3207 · Compose :3307)"},"1865":{"id":"/docs/deploy-107","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"Features, observations, H3 aggregation, zones, saved views, uploads; the module gate; decision records. Owns `nexus_map` — **PostGIS** required (the `nexus/postgres` image carries PostGIS 3.6 next to AGE and pgvector). Demo world only with `MAP_DEMO_WORLD=1`, refused in production."},"1866":{"id":"/docs/deploy-108","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"its database, core-api (gate), chat-api (relations)"},"1867":{"id":"/docs/deploy-109","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"`map-web` (:3217)"},"1868":{"id":"/docs/deploy-110","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"Serves NexMap; MapLibre worker served same-origin, base-map tiles from `NEXT_PUBLIC_MAP_STYLE_LIGHT/DARK` (OpenFreeMap by default; self-hosted PMTiles later)."},"1869":{"id":"/docs/deploy-111","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"map-api, core-api, the tile server"},"1870":{"id":"/docs/deploy-112","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"`care-api` (:3208)"},"1871":{"id":"/docs/deploy-113","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"Suite routes and the **public edge** the widget and Telegram reach; the guardrail port; channel polling (`CARE_CHANNELS_POLL=1`, one replica). Owns `nexus_care`. Needs `CARE_CLIENT_HASH_SALT` (a Secret) and `careApi.publicOrigin`."},"1872":{"id":"/docs/deploy-114","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"its database, core-api, chat-api, tasks-api (cases), graph-api (knowledge), bi-api (datasets)"},"1873":{"id":"/docs/deploy-115","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"`care-worker`"},"1874":{"id":"/docs/deploy-116","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"SLA clock, retention export to the Gold decision dataset, NexBI dataset publishing."},"1875":{"id":"/docs/deploy-117","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"`nexus_care`, bi-api"},"1876":{"id":"/docs/deploy-118","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"`care-web` (:3218)"},"1877":{"id":"/docs/deploy-119","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"Serves NexCare and the widget loader `/widget/v1/care.js` + frame (CSP `frame-ancestors` per installation). The demo host page lives on :3219 on the laptop only."},"1878":{"id":"/docs/deploy-120","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"care-api, core-api"},"1879":{"id":"/docs/deploy-121","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"`forge-api` (:3209)"},"1880":{"id":"/docs/deploy-122","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"Scenes, the op engine, versions, turns (grammar → Scene Agent), proposals, templates; hosts the Scene Agent on the Agent Runtime's model port. Owns `nexus_forge`. `TRANSCRIBER_DRIVER=core_api`, `AGENT_DRIVER=core_api`; fixtures refused in production."},"1881":{"id":"/docs/deploy-123","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"its database, core-api (gate, Gateway), chat-api (relations)"},"1882":{"id":"/docs/deploy-124","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"`forge-web` (:3219)"},"1883":{"id":"/docs/deploy-125","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"Serves NexForge; BFF `/api/forge/*`."},"1884":{"id":"/docs/deploy-126","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"forge-api, core-api"},"1885":{"id":"/docs/deploy-127","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"`asr-local` (:8090, loopback)"},"1886":{"id":"/docs/deploy-128","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"faster-whisper (`large-v3-turbo`, \\~1.6 GB) behind `POST /v1/audio/transcriptions`; the Gateway's local `asr` route. Compose profile `asr-local`, Dockerfile `deploy/docker/asr-local.Dockerfile`, no published port."},"1887":{"id":"/docs/deploy-129","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"core-api only"},"1888":{"id":"/docs/deploy-130","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"`tts-local` (:8091, loopback)"},"1889":{"id":"/docs/deploy-131","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"ukrainian-tts (\\~450 MB) behind `POST /v1/audio/speech`; the Gateway's local `tts` route. Compose profile `tts-local`."},"1890":{"id":"/docs/deploy-132","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"core-api only"},"1891":{"id":"/docs/deploy-133","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#the-modules-and-the-speech-sidecars--profiles-off-by-default","content":"Three more databases — `nexus_map`, `nexus_care`, `nexus_forge` — each with its own role, row-level security\nforced, Alembic migrations run by the `migrate-*` jobs. chat-api needs the voice settings (`VOICE_TRANSCRIBER_DRIVER`,\n`VOICE_SYNTHESIZER_DRIVER`, `VOICE_TRANSPORT_DRIVER=ws`, `VOICE_STREAM_PUBLIC_URL`, `VOICE_VAD_DRIVER`,\n`VOICE_SILERO_MODEL_PATH`, `WEB_SEARCH_DRIVER`) — all required, no defaults; core-api needs\n`NEXUS_ASR_LOCAL_BASE_URL` and `NEXUS_TTS_LOCAL_BASE_URL`. A *confidential* Project must have a local speech route, so a\ndeployment that enables voice should run both sidecars. The chart carries the voice env but **no sidecar profile\nyet*&#x2A;; it joins at UAT-4. Budget roughly **+2.5 GB*&#x2A; of images and weights for the two sidecars and **+1 GB RAM** at\nidle; ASR on a CPU is 8–30 s per clip — a GPU or a cloud `asr` route (≤ confidential) brings it under 2 s."},"1892":{"id":"/docs/deploy-134","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Laptop"},"1893":{"id":"/docs/deploy-135","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Compose"},"1894":{"id":"/docs/deploy-136","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Kubernetes"},"1895":{"id":"/docs/deploy-137","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"AWS (reference)"},"1896":{"id":"/docs/deploy-138","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Processes"},"1897":{"id":"/docs/deploy-139","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"host processes with hot reload"},"1898":{"id":"/docs/deploy-140","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"containers"},"1899":{"id":"/docs/deploy-141","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Deployments"},"1900":{"id":"/docs/deploy-142","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Deployments on EKS"},"1901":{"id":"/docs/deploy-143","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"PostgreSQL"},"1902":{"id":"/docs/deploy-144","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"container (`nexus/postgres`: AGE + pgvector + PostGIS)"},"1903":{"id":"/docs/deploy-145","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"container + named volume (`POSTGRES_IMAGE`)"},"1904":{"id":"/docs/deploy-146","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"in-cluster StatefulSet **or** external — external must offer AGE and pgvector for `nexus_graph`, PostGIS for `nexus_map`"},"1905":{"id":"/docs/deploy-147","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Amazon RDS (external) — RDS has pgvector and PostGIS but **not Apache AGE**: `nexus_graph` needs an in-cluster or self-managed PostgreSQL; `nexus_map` may stay on RDS"},"1906":{"id":"/docs/deploy-148","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"NATS"},"1907":{"id":"/docs/deploy-149","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"host process (or none: Postgres job bus)"},"1908":{"id":"/docs/deploy-150","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"container"},"1909":{"id":"/docs/deploy-151","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"StatefulSet"},"1910":{"id":"/docs/deploy-152","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"StatefulSet on EBS"},"1911":{"id":"/docs/deploy-153","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Sign-in"},"1912":{"id":"/docs/deploy-154","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Keycloak container, mail caught locally"},"1913":{"id":"/docs/deploy-155","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Keycloak container"},"1914":{"id":"/docs/deploy-156","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"`keycloak.enabled=true` Deployment"},"1915":{"id":"/docs/deploy-157","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Deployment; Google / enterprise SSO brokered"},"1916":{"id":"/docs/deploy-158","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Sandbox"},"1917":{"id":"/docs/deploy-159","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Docker socket, ephemeral containers"},"1918":{"id":"/docs/deploy-160","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Docker socket, ephemeral containers"},"1919":{"id":"/docs/deploy-161","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Jobs in `nexus-sandbox`, deny-all, optional gVisor"},"1920":{"id":"/docs/deploy-162","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"same"},"1921":{"id":"/docs/deploy-163","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Secrets"},"1922":{"id":"/docs/deploy-164","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"developer `.env` files"},"1923":{"id":"/docs/deploy-165","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"one generated `.env` (bootstrap) · optional OpenBao"},"1924":{"id":"/docs/deploy-166","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"pre-created `Secret`s · OpenBao / Vault by reference"},"1925":{"id":"/docs/deploy-167","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Secrets Manager → External Secrets → `Secret`s"},"1926":{"id":"/docs/deploy-168","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Public edge"},"1927":{"id":"/docs/deploy-169","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"`http://127.0.0.1:3210`"},"1928":{"id":"/docs/deploy-170","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"`http://localhost:3310`"},"1929":{"id":"/docs/deploy-171","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Ingress + TLS (NodePort on kind)"},"1930":{"id":"/docs/deploy-172","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"ALB + ACM certificate"},"1931":{"id":"/docs/deploy-173","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"Images"},"1932":{"id":"/docs/deploy-174","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"none (source)"},"1933":{"id":"/docs/deploy-175","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"ghcr.io / mirror / local build"},"1934":{"id":"/docs/deploy-176","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"ghcr.io / mirror"},"1935":{"id":"/docs/deploy-177","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#what-differs-between-targets","content":"ECR mirror"},"1936":{"id":"/docs/deploy-178","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#before-you-start","content":"**Docker** (Docker Desktop or Engine 24+) on every rung, including the laptop — Postgres and Keycloak run in it and\nthe sandbox uses it."},"1937":{"id":"/docs/deploy-179","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#before-you-start","content":"**Node 22**, **Python 3.12** and `uv` for the laptop rung only."},"1938":{"id":"/docs/deploy-180","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#before-you-start","content":"**Helm 3.8+** and **kind** or **k3d** for the Kubernetes rung on a laptop; `kubectl` with access to a cluster for\nthe rest."},"1939":{"id":"/docs/deploy-181","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#before-you-start","content":"**A model provider.** Nexi answers nothing without a model: a cloud provider key (OpenAI, Anthropic …) *or* a\nlocal OpenAI-compatible server (llama.cpp, Ollama) for the disconnected profile. Every rung shows where the key\ngoes; it never goes into a file you would commit."},"1940":{"id":"/docs/deploy-182","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#before-you-start","content":"**Ports.** The laptop stack uses `32xx` and `5433`; Compose uses `33xx` and `5533`; local Kubernetes uses `30000`.\nAll three can run side by side."},"1941":{"id":"/docs/deploy-183","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#three-rules-that-never-change","content":"**Secrets never enter images, values files, manifests, prompts or logs.** Every target reads them from its own\nsecret source — a mode-600 `.env`, Kubernetes `Secret`s, a vault, a cloud secret manager — and Nexi holds\n*references* to them (`env://`, `vault://`), never values in configuration files."},"1942":{"id":"/docs/deploy-184","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#three-rules-that-never-change","content":"**Migrations run before the API starts, as their own step.** Compose runs one-shot `migrate-*` services; the chart\nruns one Job per database per release revision and the Deployments wait for it. You never run `alembic` by hand\non a target."},"1943":{"id":"/docs/deploy-185","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#three-rules-that-never-change","content":"**Generated code runs only in the sandbox.** No process except `sandbox-manager` can start an execution; the\nexecution has no network, no credentials and no shell on the host. On Kubernetes that boundary is a namespace\nwith a deny-all NetworkPolicy and Pod Security *restricted*."},"1944":{"id":"/docs/deploy-186","page_id":"/docs/deploy","tags":[],"type":"text","url":"/docs/deploy#three-rules-that-never-change","content":"The full picture of the runtime — applications, services, runtimes, state — is on How Nexi is built. The API every deployment exposes is in API reference. What an operator may and may not do inside a running Nexi is in Access rights."},"1945":{"id":"/docs/deploy/aws","page_id":"/docs/deploy/aws","type":"page","content":"4 · AWS — reference architecture","breadcrumbs":["Nexi Docs","Deploy","The ladder"],"tags":[],"url":"/docs/deploy/aws"},"1946":{"id":"/docs/deploy/aws-0","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws","content":"The Kubernetes target on Amazon EKS with RDS for PostgreSQL, Secrets Manager through External Secrets, an Application Load Balancer with an ACM certificate, and ECR as the release mirror."},"1947":{"id":"/docs/deploy/aws-1","page_id":"/docs/deploy/aws","type":"heading","tags":[],"url":"/docs/deploy/aws#the-picture","content":"The picture"},"1948":{"id":"/docs/deploy/aws-2","page_id":"/docs/deploy/aws","type":"heading","tags":[],"url":"/docs/deploy/aws#before-you-start","content":"Before you start"},"1949":{"id":"/docs/deploy/aws-3","page_id":"/docs/deploy/aws","type":"heading","tags":[],"url":"/docs/deploy/aws#availability-scaling-cost","content":"Availability, scaling, cost"},"1950":{"id":"/docs/deploy/aws-4","page_id":"/docs/deploy/aws","type":"heading","tags":[],"url":"/docs/deploy/aws#production-checklist-for-this-target","content":"Production checklist for this target"},"1951":{"id":"/docs/deploy/aws-5","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws","content":"Nothing on this page is AWS-specific *inside* Nexi. The chart from the Kubernetes rung\nis installed unchanged; what AWS provides is the ground it stands on — the cluster, the database, the secret store,\nthe public edge, the registry. This page maps each of those onto a managed AWS service and gives you the values to\nwrite."},"1952":{"id":"/docs/deploy/aws-6","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws","content":"**Status.** This is a reference architecture: every piece it relies on is a chart feature that exists today\n(`postgres.mode=external`, pre-created or ExternalSecret-fed Secrets, any ingress class, a registry mirror). What\ndoes not ship yet is a ready-made `values-eks.yaml` and the `kms://` envelope-key driver; both are noted where they\nmatter."},"1953":{"id":"/docs/deploy/aws-7","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"Nexi needs"},"1954":{"id":"/docs/deploy/aws-8","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"AWS provides"},"1955":{"id":"/docs/deploy/aws-9","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"Chart setting"},"1956":{"id":"/docs/deploy/aws-10","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"A Kubernetes cluster with enforced NetworkPolicy"},"1957":{"id":"/docs/deploy/aws-11","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"**EKS** with the VPC CNI in network-policy mode (or Calico/Cilium)"},"1958":{"id":"/docs/deploy/aws-12","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"—"},"1959":{"id":"/docs/deploy/aws-13","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"PostgreSQL 16 for four databases"},"1960":{"id":"/docs/deploy/aws-14","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"**RDS for PostgreSQL 16**, Multi-AZ, private subnets, TLS"},"1961":{"id":"/docs/deploy/aws-15","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"`postgres.mode: external`, `postgres.host`, `postgres.sslmode: require`"},"1962":{"id":"/docs/deploy/aws-16","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"Secrets the pods mount"},"1963":{"id":"/docs/deploy/aws-17","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"**Secrets Manager** → **External Secrets Operator** → `Secret`s"},"1964":{"id":"/docs/deploy/aws-18","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"`externalSecrets.enabled: true`, `secrets.create: false`"},"1965":{"id":"/docs/deploy/aws-19","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"An envelope key for stored credentials"},"1966":{"id":"/docs/deploy/aws-20","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"**KMS** (planned `kms://` driver) — until then a Secrets Manager entry"},"1967":{"id":"/docs/deploy/aws-21","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"`nexus-keys/broker-master-key`"},"1968":{"id":"/docs/deploy/aws-22","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"A public origin with TLS"},"1969":{"id":"/docs/deploy/aws-23","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"**Application Load Balancer** via the **AWS Load Balancer Controller** + **ACM** certificate + **Route 53**"},"1970":{"id":"/docs/deploy/aws-24","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"`ingress.className: alb` + annotations"},"1971":{"id":"/docs/deploy/aws-25","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"Images and the chart"},"1972":{"id":"/docs/deploy/aws-26","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"**ECR** as the mirror of a signed release"},"1973":{"id":"/docs/deploy/aws-27","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"`image.registry: <account>.dkr.ecr.<region>.amazonaws.com/nexus`"},"1974":{"id":"/docs/deploy/aws-28","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"Block storage for NATS and the credential store"},"1975":{"id":"/docs/deploy/aws-29","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"**EBS** through the EBS CSI driver (`gp3`)"},"1976":{"id":"/docs/deploy/aws-30","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"`nats.storageClassName`, `coreApi.secretsStore.storageClassName`"},"1977":{"id":"/docs/deploy/aws-31","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"Mail for sign-up and reset"},"1978":{"id":"/docs/deploy/aws-32","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"**SES** SMTP endpoint"},"1979":{"id":"/docs/deploy/aws-33","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"`keycloak.smtp.*`, `nexus-idp/smtp-user`, `smtp-password`"},"1980":{"id":"/docs/deploy/aws-34","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"Models"},"1981":{"id":"/docs/deploy/aws-35","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"**Bedrock** as a Tier-4 provider (planned) · a provider key in Secrets Manager · **a GPU node group** with vLLM/llama.cpp"},"1982":{"id":"/docs/deploy/aws-36","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#the-picture","content":"registry references"},"1983":{"id":"/docs/deploy/aws-37","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"An AWS account with a VPC that has public subnets (for the ALB) and private subnets in at least two AZs (for\nnodes and RDS), NAT for outbound traffic, and the subnets tagged for the Load Balancer Controller\n(`kubernetes.io/role/elb`, `kubernetes.io/role/internal-elb`)."},"1984":{"id":"/docs/deploy/aws-38","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"`aws`, `kubectl`, `helm`, `eksctl` (or your Terraform) on an operator machine; `skopeo` and `cosign` for the mirror step."},"1985":{"id":"/docs/deploy/aws-39","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"A registered domain in Route 53 and the ability to request an ACM certificate for `nexus.example.com`."},"1986":{"id":"/docs/deploy/aws-40","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Cluster provisioning itself is your platform team's concern: the chart installs on any conformant cluster and\ndoes not ship Terraform. The steps below name what the cluster must have."},"1987":{"id":"/docs/deploy/aws-41","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Create the cluster with managed node groups in the private subnets, then install four add-ons the chart relies on\nbut does not contain:"},"1988":{"id":"/docs/deploy/aws-42","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Add-on"},"1989":{"id":"/docs/deploy/aws-43","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Why"},"1990":{"id":"/docs/deploy/aws-44","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Note"},"1991":{"id":"/docs/deploy/aws-45","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"**EBS CSI driver** + a `gp3` StorageClass (default)"},"1992":{"id":"/docs/deploy/aws-46","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"NATS volume, core-api credential store"},"1993":{"id":"/docs/deploy/aws-47","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"IAM role via IRSA"},"1994":{"id":"/docs/deploy/aws-48","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"**AWS Load Balancer Controller**"},"1995":{"id":"/docs/deploy/aws-49","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Ingress → ALB"},"1996":{"id":"/docs/deploy/aws-50","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"IAM role via IRSA; subnets tagged"},"1997":{"id":"/docs/deploy/aws-51","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"**External Secrets Operator**"},"1998":{"id":"/docs/deploy/aws-52","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Secrets Manager → Kubernetes Secrets"},"1999":{"id":"/docs/deploy/aws-53","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"IAM role via IRSA (step 3)"},"2000":{"id":"/docs/deploy/aws-54","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"**Network policy enforcement**"},"2001":{"id":"/docs/deploy/aws-55","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"the chart's default-deny only bites when the CNI enforces it"},"2002":{"id":"/docs/deploy/aws-56","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"VPC CNI with network policy enabled, or Calico/Cilium"},"2003":{"id":"/docs/deploy/aws-57","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"For the sandbox's kernel isolation (`sandbox.runtimeClassName: gvisor`) EKS managed node groups do not ship gVisor;\nuse a self-managed node group with the gVisor containerd shim or leave `runtimeClassName` empty — the platform then\nrefuses the strictest data-classification sandbox profiles instead of running them less isolated. A GPU node group\n(`g5`/`g6` instances) is optional and only needed for models you host yourself."},"2004":{"id":"/docs/deploy/aws-58","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Create eight repositories under one prefix (`nexus/core-api`, `nexus/chat-api`, `nexus/chat-worker`,\n`nexus/sandbox-manager`, `nexus/tasks-api`, `nexus/web`, `nexus/keycloak`, `nexus/sandbox-python`) plus\n`nexus/charts/nexus` for the chart, then copy the release by digest with signature verification:"},"2005":{"id":"/docs/deploy/aws-59","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"`RELEASE.json` is the manifest each release publishes — every image by digest. Nodes pull from ECR with their node\nrole; no `imagePullSecret` is needed inside the account. Turn on ECR image scanning and immutable tags on the\nrepositories: the tags you install by (`v0.1.0`) then cannot be moved."},"2006":{"id":"/docs/deploy/aws-60","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Create one entry per value under a common prefix, for example `nexus/prod/…`:"},"2007":{"id":"/docs/deploy/aws-61","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Entry"},"2008":{"id":"/docs/deploy/aws-62","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Becomes"},"2009":{"id":"/docs/deploy/aws-63","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"In Secret · key"},"2010":{"id":"/docs/deploy/aws-64","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"`nexus/prod/db-password`"},"2011":{"id":"/docs/deploy/aws-65","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"the `nexus` role's password"},"2012":{"id":"/docs/deploy/aws-66","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"`nexus-db` · `password`"},"2013":{"id":"/docs/deploy/aws-67","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"`nexus/prod/broker-master-key`"},"2014":{"id":"/docs/deploy/aws-68","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"32 random bytes, base64"},"2015":{"id":"/docs/deploy/aws-69","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"`nexus-keys` · `broker-master-key`"},"2016":{"id":"/docs/deploy/aws-70","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"`nexus/prod/hook-master-key`"},"2017":{"id":"/docs/deploy/aws-71","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"32 random bytes, base64"},"2018":{"id":"/docs/deploy/aws-72","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"`nexus-keys` · `hook-master-key`"},"2019":{"id":"/docs/deploy/aws-73","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"`nexus/prod/service-tokens`"},"2020":{"id":"/docs/deploy/aws-74","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"JSON with keys `core-api` … `tasks-api`"},"2021":{"id":"/docs/deploy/aws-75","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"`nexus-service-tokens` (one key each)"},"2022":{"id":"/docs/deploy/aws-76","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"`nexus/prod/idp`"},"2023":{"id":"/docs/deploy/aws-77","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"JSON with the eight Keycloak values"},"2024":{"id":"/docs/deploy/aws-78","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"`nexus-idp` (one key each)"},"2025":{"id":"/docs/deploy/aws-79","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"`nexus/prod/provider-keys`"},"2026":{"id":"/docs/deploy/aws-80","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"JSON `{\"NEXUS_OPENAI_API_KEY\": \"…\"}`"},"2027":{"id":"/docs/deploy/aws-81","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"`nexus-provider-keys` (verbatim env)"},"2028":{"id":"/docs/deploy/aws-82","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Give External Secrets an IAM role (IRSA) allowed `secretsmanager:GetSecretValue` on `nexus/prod/*` and nothing\nelse, and create a `ClusterSecretStore` named `nexus` for the region. The chart's `externalSecrets` block then\nrenders `ExternalSecret`s for the first three entries:"},"2029":{"id":"/docs/deploy/aws-83","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"For `nexus-service-tokens`, `nexus-idp` and `nexus-provider-keys` write two short `ExternalSecret` manifests of your\nown (the chart maps only the three above today) with `dataFrom: [{ extract: { key: nexus/prod/idp } }]`, which turns\neach JSON field into a Secret key. Apply them before the chart; they refresh on ESO's interval, so rotating a value in\nSecrets Manager reaches the pods on their next restart."},"2030":{"id":"/docs/deploy/aws-84","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"**About the envelope key.** Until the `kms://` driver lands, `broker-master-key` is a Secrets Manager entry like the\nothers. Protect it accordingly: a separate KMS key for that entry's encryption, restricted resource policy, and a\nbackup outside the account — without it, every stored connection credential is unreadable."},"2031":{"id":"/docs/deploy/aws-85","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Create a PostgreSQL 16 instance (or Aurora PostgreSQL) in the private subnets, Multi-AZ, storage encrypted with\nKMS, `rds.force_ssl=1`, with a security group that admits the cluster's node security group on 5432 and nothing\nelse. Then, from a bastion or a one-off pod that can reach it, create the roles and databases:"},"2032":{"id":"/docs/deploy/aws-86","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Point the chart at it:"},"2033":{"id":"/docs/deploy/aws-87","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"The migration Jobs run `alembic upgrade head` against the instance on every release; automated backups with a\n7–35 day window plus a manual snapshot before each upgrade are the whole backup story for the databases."},"2034":{"id":"/docs/deploy/aws-88","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"**NexGraph and RDS.** The knowledge family (a coming release on the packaged targets) keeps its graph in **Apache\nAGE**, which RDS and Aurora do not offer — `pgvector` yes, AGE no. Plan for `nexus_graph` and `nexus_dagster` on a\nPostgreSQL you control: the chart's in-cluster StatefulSet with the suite image `nexus/postgres` on an EBS volume, or\na self-managed instance on EC2. The four databases above stay on RDS; only the graph moves. Everything else in this\nchapter applies unchanged."},"2035":{"id":"/docs/deploy/aws-89","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Request an ACM certificate for `nexus.example.com` (DNS validation in Route 53), then let the chart's Ingress\nbecome an ALB:"},"2036":{"id":"/docs/deploy/aws-90","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"The controller creates the ALB and a target group per Service; create an alias record `nexus.example.com → the ALB`\nin Route 53. The three routes the chart renders (`/idp/realms/nexus`, `/idp/resources`, `/`) are exactly what the\nALB needs — do not add a rule for `/api/v1`; `web` forwards it."},"2037":{"id":"/docs/deploy/aws-91","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Keycloak sits behind the ALB with `xforwarded` proxy headers already set by the chart, so every URL it emits is under\n`https://nexus.example.com/idp`. For sign-up mail, verify the sending domain in SES and put the SMTP credentials in\n`nexus/prod/idp` (`smtp-user`, `smtp-password`); `keycloak.smtp.host` is `email-smtp.<region>.amazonaws.com`, port\n`587`, `starttls: \"true\"`, `auth: \"true\"`."},"2038":{"id":"/docs/deploy/aws-92","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#before-you-start","content":"Putting it together — this is the file the platform will one day ship as `values-eks.yaml`:"},"2039":{"id":"/docs/deploy/aws-93","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#availability-scaling-cost","content":"**What scales horizontally today:** `web`, `chat-api`, `tasks-api`, `chat-worker` (more workers = more concurrent\nagent turns and flow steps). `sandbox-manager` scales too, bounded by the sandbox ResourceQuota."},"2040":{"id":"/docs/deploy/aws-94","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#availability-scaling-cost","content":"**What does not yet:** `core-api` runs one replica while its credential store is a ReadWriteOnce volume; moving\ncredentials to a vault (`coreApi.vault.addr`, or Secrets Manager entries referenced from the registry) removes that\nlimit. `nats` is a single StatefulSet replica in the chart; JetStream's file store on EBS survives a pod restart,\nand a lost message is never lost state — the truth is in RDS."},"2041":{"id":"/docs/deploy/aws-95","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#availability-scaling-cost","content":"**Zones:** spread node groups across two or three AZs; Multi-AZ RDS; the ALB is regional by nature."},"2042":{"id":"/docs/deploy/aws-96","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#availability-scaling-cost","content":"**Sizing to start:** three `m6i.large` nodes carry the release comfortably; RDS `db.t4g.medium` Multi-AZ for a\nsmall organization, `db.m6g.large` when flows and agents are busy. Models are the real cost line: a GPU node group\nfor self-hosted inference, or per-token Bedrock/provider spend — the Model Gateway records both per call, and\nNexCore shows them."},"2043":{"id":"/docs/deploy/aws-97","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#production-checklist-for-this-target","content":"`nexusEnv: production` refused nothing at start (every health body shows production-grade drivers)"},"2044":{"id":"/docs/deploy/aws-98","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#production-checklist-for-this-target","content":"Keycloak enabled, SES verified, a real account registered and verified through mail"},"2045":{"id":"/docs/deploy/aws-99","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#production-checklist-for-this-target","content":"Provider keys only in Secrets Manager (no `NEXUS_*_API_KEY` in any values file or shell history)"},"2046":{"id":"/docs/deploy/aws-100","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#production-checklist-for-this-target","content":"`broker-master-key` backed up outside the account"},"2047":{"id":"/docs/deploy/aws-101","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#production-checklist-for-this-target","content":"RDS automated backups on; a manual snapshot taken before the install"},"2048":{"id":"/docs/deploy/aws-102","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#production-checklist-for-this-target","content":"ECR tags immutable, scan-on-push on, `mirror.sh` verified signatures"},"2049":{"id":"/docs/deploy/aws-103","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#production-checklist-for-this-target","content":"Network policy enforcement confirmed: a pod in `nexus-sandbox` cannot reach RDS or the internet"},"2050":{"id":"/docs/deploy/aws-104","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#production-checklist-for-this-target","content":"Smoke report archived with the release version"},"2051":{"id":"/docs/deploy/aws-105","page_id":"/docs/deploy/aws","tags":[],"type":"text","url":"/docs/deploy/aws#production-checklist-for-this-target","content":"Everything after the install — releases, mirroring, upgrades, rotation, backups, health — is on Operations. The chart itself is described rung by rung on Kubernetes."},"2052":{"id":"/docs/deploy/compose","page_id":"/docs/deploy/compose","type":"page","content":"2 · Docker Compose","breadcrumbs":["Nexi Docs","Deploy","The ladder"],"tags":[],"url":"/docs/deploy/compose"},"2053":{"id":"/docs/deploy/compose-0","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose","content":"The packaged product on one machine — signed images, one generated .env, one public port. For trials, demos, small teams and air-gapped sites."},"2054":{"id":"/docs/deploy/compose-1","page_id":"/docs/deploy/compose","type":"heading","tags":[],"url":"/docs/deploy/compose#what-you-get","content":"What you get"},"2055":{"id":"/docs/deploy/compose-2","page_id":"/docs/deploy/compose","type":"heading","tags":[],"url":"/docs/deploy/compose#before-you-start","content":"Before you start"},"2056":{"id":"/docs/deploy/compose-3","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose","content":"Compose is the first rung on which you run **the product as it ships**: the same signed images every other target\ninstalls, started as containers on one machine. Nothing is built locally, nothing hot-reloads. It is the right\ntarget for a trial, a demo, a small team on one server, and — with the disconnected profile — a site without\ninternet."},"2057":{"id":"/docs/deploy/compose-4","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"Container"},"2058":{"id":"/docs/deploy/compose-5","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"Host port"},"2059":{"id":"/docs/deploy/compose-6","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"Notes"},"2060":{"id":"/docs/deploy/compose-7","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"`web`"},"2061":{"id":"/docs/deploy/compose-8","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"**3310** — the public origin"},"2062":{"id":"/docs/deploy/compose-9","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"`http://localhost:3310/chat`"},"2063":{"id":"/docs/deploy/compose-10","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"`keycloak`"},"2064":{"id":"/docs/deploy/compose-11","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"3320 (loopback)"},"2065":{"id":"/docs/deploy/compose-12","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"admin console `http://localhost:3320/idp/admin/`; users sign in through `web` at `/signin`"},"2066":{"id":"/docs/deploy/compose-13","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"`core-api` · `chat-api` · `tasks-api`"},"2067":{"id":"/docs/deploy/compose-14","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"3300 · 3301 · 3304"},"2068":{"id":"/docs/deploy/compose-15","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"health probes for operators; the browser never uses them"},"2069":{"id":"/docs/deploy/compose-16","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"`sandbox-manager`"},"2070":{"id":"/docs/deploy/compose-17","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"3303"},"2071":{"id":"/docs/deploy/compose-18","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"`/health`"},"2072":{"id":"/docs/deploy/compose-19","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"`postgres`"},"2073":{"id":"/docs/deploy/compose-20","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"5533"},"2074":{"id":"/docs/deploy/compose-21","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"for `psql` and backups"},"2075":{"id":"/docs/deploy/compose-22","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"`chat-worker` · `nats` · `migrate-*`"},"2076":{"id":"/docs/deploy/compose-23","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"—"},"2077":{"id":"/docs/deploy/compose-24","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"internal"},"2078":{"id":"/docs/deploy/compose-25","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"`llama-server` (profile `disconnected`) · `openbao` (`--vault`)"},"2079":{"id":"/docs/deploy/compose-26","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"—"},"2080":{"id":"/docs/deploy/compose-27","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"internal"},"2081":{"id":"/docs/deploy/compose-28","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"`map-api` (profile `map`) · `care-api` (profile `care`, `docker-compose.care.yml`) · `forge-api` (profile `forge`) + their `migrate-*`"},"2082":{"id":"/docs/deploy/compose-29","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"3307 (map, loopback) · — · —"},"2083":{"id":"/docs/deploy/compose-30","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"the module APIs; `postgres` must be the `nexus/postgres` image (PostGIS for `nexus_map`); the module web apps are not in the Compose file yet"},"2084":{"id":"/docs/deploy/compose-31","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"`asr-local` (profile `asr-local`) · `tts-local` (profile `tts-local`) · `livekit` (profile `media`)"},"2085":{"id":"/docs/deploy/compose-32","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"—"},"2086":{"id":"/docs/deploy/compose-33","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#what-you-get","content":"the speech sidecars behind core-api's Gateway — `deploy/docker/{asr,tts}-local.Dockerfile`; no published ports; audio never leaves the network"},"2087":{"id":"/docs/deploy/compose-34","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"A Linux server or a laptop with **Docker Engine 24+ / Docker Desktop** and the Compose plugin (`docker compose version`)."},"2088":{"id":"/docs/deploy/compose-35","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"The Nexi repository checked out — the Compose file, scripts and image contract live in it — or just the\n`deploy/compose` folder and `deploy/scripts` folder copied over."},"2089":{"id":"/docs/deploy/compose-36","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Access to a registry with the Nexi images: `ghcr.io` on a connected machine, or your own mirror\n(see Operations → Releases)."},"2090":{"id":"/docs/deploy/compose-37","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"4 vCPU and 8 GB RAM are comfortable for the stack itself; the disconnected model server wants more (see step 5)."},"2091":{"id":"/docs/deploy/compose-38","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"An SMTP relay if people will sign up themselves: verification and password-reset mails have to go somewhere.\n(On the laptop rung Mailpit caught them; Compose is a product contour and ships no mail catcher.)"},"2092":{"id":"/docs/deploy/compose-39","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"One command, one file. `compose-init.sh` copies the annotated example to `deploy/compose/.env`, generates every\nbootstrap secret — database passwords, the two master keys, the Keycloak client secrets, the session signing key —\nand sets the file to mode 600. The file is the **bootstrap tier** of secrets and lives only on this machine. It is\nidempotent: an existing `.env` is never overwritten unless you pass `--force`, which rotates every key."},"2093":{"id":"/docs/deploy/compose-40","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Useful flags (combine freely):"},"2094":{"id":"/docs/deploy/compose-41","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Flag"},"2095":{"id":"/docs/deploy/compose-42","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Effect"},"2096":{"id":"/docs/deploy/compose-43","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`--registry <host/path> --tag <tag>`"},"2097":{"id":"/docs/deploy/compose-44","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Where the images come from — `ghcr.io/<owner>` or your mirror — and which release. Default: the values in the example file."},"2098":{"id":"/docs/deploy/compose-45","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`--local-images`"},"2099":{"id":"/docs/deploy/compose-46","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Use images you built yourself with `npm run images:build` (`local/nexus/<process>:dev`). Laptops only; never an artifact."},"2100":{"id":"/docs/deploy/compose-47","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`--disconnected`"},"2101":{"id":"/docs/deploy/compose-48","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Add the `llama-server` container and switch core-api to the disconnected model registry. No cloud provider is ever called."},"2102":{"id":"/docs/deploy/compose-49","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`--vault`"},"2103":{"id":"/docs/deploy/compose-50","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Add OpenBao as the secret store; provider keys move out of `.env` into it (step 6)."},"2104":{"id":"/docs/deploy/compose-51","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`--force`"},"2105":{"id":"/docs/deploy/compose-52","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Regenerate `.env` from scratch. Every password and key changes — existing data becomes unreadable."},"2106":{"id":"/docs/deploy/compose-53","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Then open `deploy/compose/.env` once and set:"},"2107":{"id":"/docs/deploy/compose-54","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`NEXUS_PUBLIC_URL` — the URL people will type. `http://localhost:3310` for a trial; `https://nexus.example.com` when\na reverse proxy in front terminates TLS (see step 7)."},"2108":{"id":"/docs/deploy/compose-55","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`NEXUS_OPENAI_API_KEY` (or another provider key) for the connected profile. `compose-init` already copies it from\nyour shell or from `apps/core-api/.env` if it finds one there; it never prints it."},"2109":{"id":"/docs/deploy/compose-56","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`KEYCLOAK_SMTP_HOST`, `_PORT`, `_FROM`, `_USER`, `_PASSWORD` — your mail relay."},"2110":{"id":"/docs/deploy/compose-57","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`KEYCLOAK_GOOGLE_CLIENT_ID` / `_SECRET` if you want *Sign in with Google* on the page."},"2111":{"id":"/docs/deploy/compose-58","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Compose pulls the images, starts Postgres and NATS, waits for Postgres to be healthy, runs the four database\ninitialisations and the three `migrate-*` one-shot services, then starts the APIs, waits for their health probes,\nand finally starts `web`. On a fresh machine this takes two to four minutes; the images are around 2 GB together."},"2112":{"id":"/docs/deploy/compose-59","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"The smoke script asks every process for its health, goes through `web` to each API the way a browser would, and\nprints one JSON report with a line of `✓ <check>` on the way. It exits non-zero on the first failure and names the\ncheck. Keep the report: it is the evidence that this installation is sound."},"2113":{"id":"/docs/deploy/compose-60","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Each health body also names the drivers the process runs with — `job_bus_driver`, `sandbox.driver`,\n`repository_driver` — so the report doubles as a configuration receipt."},"2114":{"id":"/docs/deploy/compose-61","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Then open `http://localhost:3310/chat`. You land on the sign-in page served by Keycloak *through* `web` — the only\npublic origin. Register, verify through the mail your relay delivered, create your organization, and continue with\nGet started."},"2115":{"id":"/docs/deploy/compose-62","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"The file has five groups. Nothing outside it is configuration; nothing inside it is code."},"2116":{"id":"/docs/deploy/compose-63","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Group"},"2117":{"id":"/docs/deploy/compose-64","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Variables"},"2118":{"id":"/docs/deploy/compose-65","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Who sets them"},"2119":{"id":"/docs/deploy/compose-66","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"**Artifacts**"},"2120":{"id":"/docs/deploy/compose-67","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`NEXUS_IMAGE_REGISTRY` · `NEXUS_IMAGE_TAG` · `NEXUS_PULL_POLICY` · `SANDBOX_IMAGE`"},"2121":{"id":"/docs/deploy/compose-68","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"you, or `--registry/--tag`"},"2122":{"id":"/docs/deploy/compose-69","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"**Environment**"},"2123":{"id":"/docs/deploy/compose-70","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`NEXUS_ENV` · `DEPLOYMENT_PROFILE` (`on_prem` \\| `disconnected`) · `NEXUS_PUBLIC_URL`"},"2124":{"id":"/docs/deploy/compose-71","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"you"},"2125":{"id":"/docs/deploy/compose-72","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"**Bootstrap secrets**"},"2126":{"id":"/docs/deploy/compose-73","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"database passwords, `NEXUS_BROKER_MASTER_KEY`, `HOOK_SECRETS_MASTER_KEY`, Keycloak client secrets, `SESSION_SIGNING_KEY`"},"2127":{"id":"/docs/deploy/compose-74","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"generated — never edit by hand, never copy elsewhere"},"2128":{"id":"/docs/deploy/compose-75","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"**Model access**"},"2129":{"id":"/docs/deploy/compose-76","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`MODEL_GATEWAY_DRIVER` · `MODEL_REGISTRY_PATH` · `SYNAPSE_CONNECTIONS_PATH` · provider keys · `NEXUS_OLLAMA_BASE_URL` · `VAULT_ADDR`/`VAULT_TOKEN`"},"2130":{"id":"/docs/deploy/compose-77","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"you"},"2131":{"id":"/docs/deploy/compose-78","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"**Identity**"},"2132":{"id":"/docs/deploy/compose-79","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`KEYCLOAK_*` — admin user, Google broker, SMTP relay, host port"},"2133":{"id":"/docs/deploy/compose-80","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"you"},"2134":{"id":"/docs/deploy/compose-81","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"**Host ports**"},"2135":{"id":"/docs/deploy/compose-82","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`WEB_HOST_PORT` · `CORE_API_HOST_PORT` · … · `POSTGRES_HOST_PORT`"},"2136":{"id":"/docs/deploy/compose-83","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"change only to avoid a clash"},"2137":{"id":"/docs/deploy/compose-84","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"**Images of infrastructure**"},"2138":{"id":"/docs/deploy/compose-85","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`POSTGRES_IMAGE` · `NATS_IMAGE`"},"2139":{"id":"/docs/deploy/compose-86","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"you — `POSTGRES_IMAGE=nexus/postgres:…` (PostgreSQL 16 with Apache AGE and pgvector) is what the knowledge family will need; the stock `postgres:16` is the default until it ships. Same major version: an existing volume needs no migration"},"2140":{"id":"/docs/deploy/compose-87","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Two variables deserve a sentence each. `NEXUS_BROKER_MASTER_KEY` seals every credential the Credential Broker\nstores for connections; lose it and every stored credential is unrecoverable (back it up with the volume, step 8).\n`SESSION_SIGNING_KEY` signs the five-minute assertions chat-api and tasks-api trust; rotate it by changing\n`SESSION_SIGNING_KID` together with the key."},"2141":{"id":"/docs/deploy/compose-88","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"A site with no route to a cloud provider runs a local model server as a container next to the stack:"},"2142":{"id":"/docs/deploy/compose-89","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`DEPLOYMENT_PROFILE=disconnected` makes core-api read the disconnected registry, in which the only provider is the\n`llama-server` container; cloud providers are not listed, so nothing can call them even by mistake. Bring the model\nweights in the way the site allows (artifact store, removable media) — the contour never downloads. A 1.7 B model\nruns on CPU; give the machine 8 GB more RAM and expect slow but honest answers. Larger models want a GPU host,\nwhich is where Kubernetes with a GPU node pool takes over."},"2143":{"id":"/docs/deploy/compose-90","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"An operator's own Ollama on the same machine works too: set `NEXUS_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1`.\nThe gateway only accepts endpoints inside the contour — `*.internal`, `*.svc`, private IP ranges — and refuses\nanything else with `model.provider.egress_denied`."},"2144":{"id":"/docs/deploy/compose-91","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`.env` is the bootstrap tier, not a secret store. For anything beyond a trial, keep provider keys and connection\ncredentials in a KV store and let core-api resolve **references**:"},"2145":{"id":"/docs/deploy/compose-92","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"`--vault` adds an OpenBao container (one node, file storage on a named volume, no host port, TLS off inside the\nnetwork), moves the provider keys from `.env` into a seed file the initialiser loads once, rewrites the model\nregistry's references from `env://…` to `vault:kv/nexus/<provider>#api_key`, and leaves core-api with a read-only\ntoken — the one bootstrap secret that remains in `.env`. Set `NEXUS_ALLOW_ENV_SECRETS=false` afterwards and no key\ncan reach a process through the environment at all. The same reference grammar works against any OpenBao or\nHashiCorp Vault you already run: point `VAULT_ADDR` and `VAULT_TOKEN` at it and skip the bundled container."},"2146":{"id":"/docs/deploy/compose-93","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"To rotate a key: put the new value in `openbao/seed.env`, run `docker compose run --rm openbao-init`, delete the file."},"2147":{"id":"/docs/deploy/compose-94","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Compose publishes plain HTTP on 3310. For anything people reach by name, put a reverse proxy in front — Caddy,\nnginx, Traefik — that terminates TLS for `nexus.example.com` and forwards to `127.0.0.1:3310`, then set\n`NEXUS_PUBLIC_URL=https://nexus.example.com` and restart (`docker compose up -d`). Every URL the platform emits —\nOAuth callbacks, sign-in redirects, e-mail links — is built from that one variable, and Keycloak is told that it\nsits behind a proxy (`xforwarded`). Forward `/` as a whole; `/api/v1/*` and `/idp/*` are routed inside `web`."},"2148":{"id":"/docs/deploy/compose-95","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Two things to *not* expose: the API host ports (3300–3304) and the Keycloak admin port (3320). They are bound to the\nloopback for a reason; leave them there and reach them over SSH when you must."},"2149":{"id":"/docs/deploy/compose-96","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"**Upgrade.** Edit `NEXUS_IMAGE_TAG` in `.env` to the new release, then"},"2150":{"id":"/docs/deploy/compose-97","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Compose re-runs the `migrate-*` services with the new images before the new APIs start; nothing else is needed.\nDowngrades are not supported once a migration has run — take a backup first."},"2151":{"id":"/docs/deploy/compose-98","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"**Back up.** Three named volumes hold everything: `pgdata` (all four databases), `natsdata` (in-flight jobs; safe to\nlose, unpleasant to lose mid-run) and `broker-secrets` (the sealed credential store). Back up Postgres logically and\nthe credential store with its master key:"},"2152":{"id":"/docs/deploy/compose-99","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"**Stop and reset.**"},"2153":{"id":"/docs/deploy/compose-100","page_id":"/docs/deploy/compose","tags":[],"type":"text","url":"/docs/deploy/compose#before-you-start","content":"Next rung: Kubernetes — the same images from the Helm chart, with migrations as Jobs, a deny-all network and the sandbox as isolated Jobs. Day-2 topics for this rung: Operations."},"2154":{"id":"/docs/deploy/kubernetes","page_id":"/docs/deploy/kubernetes","type":"page","content":"3 · Kubernetes","breadcrumbs":["Nexi Docs","Deploy","The ladder"],"tags":[],"url":"/docs/deploy/kubernetes"},"2155":{"id":"/docs/deploy/kubernetes-0","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes","content":"The Helm chart on any conformant cluster — first on kind or k3d to learn it, then on-prem or on a managed cluster with your own Postgres, secrets, ingress and TLS."},"2156":{"id":"/docs/deploy/kubernetes-1","page_id":"/docs/deploy/kubernetes","type":"heading","tags":[],"url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"What the chart installs"},"2157":{"id":"/docs/deploy/kubernetes-2","page_id":"/docs/deploy/kubernetes","type":"heading","tags":[],"url":"/docs/deploy/kubernetes#before-you-start","content":"Before you start"},"2158":{"id":"/docs/deploy/kubernetes-3","page_id":"/docs/deploy/kubernetes","type":"heading","tags":[],"url":"/docs/deploy/kubernetes#the-sandbox-boundary-in-kubernetes-terms","content":"The sandbox boundary, in Kubernetes terms"},"2159":{"id":"/docs/deploy/kubernetes-4","page_id":"/docs/deploy/kubernetes","type":"heading","tags":[],"url":"/docs/deploy/kubernetes#the-production-switch","content":"The production switch"},"2160":{"id":"/docs/deploy/kubernetes-5","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes","content":"One chart, one `values.yaml` whose defaults *are* the environment contract, and one small values file per kind of\ncluster. The chart installs exactly the same processes Compose starts, with three things Kubernetes does better:\nmigrations become Jobs the Deployments wait for, the network becomes default-deny with only the contract's edges\nopen, and the sandbox becomes Jobs in their own locked-down namespace."},"2161":{"id":"/docs/deploy/kubernetes-6","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"Object"},"2162":{"id":"/docs/deploy/kubernetes-7","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"Name"},"2163":{"id":"/docs/deploy/kubernetes-8","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"Purpose"},"2164":{"id":"/docs/deploy/kubernetes-9","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"Deployments"},"2165":{"id":"/docs/deploy/kubernetes-10","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"`nexus-web` · `nexus-core-api` · `nexus-chat-api` · `nexus-chat-worker` · `nexus-sandbox-manager` · `nexus-tasks-api` · `nexus-keycloak`"},"2166":{"id":"/docs/deploy/kubernetes-11","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"the processes; each API pod has a `migrate-wait` initContainer that blocks until its schema is at head"},"2167":{"id":"/docs/deploy/kubernetes-12","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"Services"},"2168":{"id":"/docs/deploy/kubernetes-13","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"`web` · `core-api` · `chat-api` · `tasks-api` · `keycloak` · `postgres` · `nats`"},"2169":{"id":"/docs/deploy/kubernetes-14","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"**the names are part of the contract** — the web image forwards to `core-api:8000` etc., so one release per namespace, no name prefix"},"2170":{"id":"/docs/deploy/kubernetes-15","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"Jobs"},"2171":{"id":"/docs/deploy/kubernetes-16","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"`nexus-migrate-{core,chat,tasks}-r<revision>`"},"2172":{"id":"/docs/deploy/kubernetes-17","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"`alembic upgrade head` per database, a fresh Job on every upgrade, cleaned up after an hour"},"2173":{"id":"/docs/deploy/kubernetes-18","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"StatefulSets"},"2174":{"id":"/docs/deploy/kubernetes-19","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"`nexus-postgres` · `nexus-nats`"},"2175":{"id":"/docs/deploy/kubernetes-20","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"in-cluster state for kind and on-prem; `postgres.mode=external` replaces the first with a host name"},"2176":{"id":"/docs/deploy/kubernetes-21","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"PVC"},"2177":{"id":"/docs/deploy/kubernetes-22","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"`nexus-core-secrets`"},"2178":{"id":"/docs/deploy/kubernetes-23","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"the sealed credential store of core-api (`file://`) — the reason core-api runs one replica until you move to `vault://`"},"2179":{"id":"/docs/deploy/kubernetes-24","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"Namespace"},"2180":{"id":"/docs/deploy/kubernetes-25","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"`nexus-sandbox`"},"2181":{"id":"/docs/deploy/kubernetes-26","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"Pod Security *restricted*, deny-all NetworkPolicy, ResourceQuota, Role + RoleBinding for the manager, a runner ServiceAccount with no rights"},"2182":{"id":"/docs/deploy/kubernetes-27","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"NetworkPolicies"},"2183":{"id":"/docs/deploy/kubernetes-28","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"default-deny + one policy per edge"},"2184":{"id":"/docs/deploy/kubernetes-29","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"web → APIs; APIs → postgres/nats; chat family → core-api/tasks-api; core-api → keycloak, vault, model endpoints; migration Jobs → postgres only"},"2185":{"id":"/docs/deploy/kubernetes-30","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"Ingress"},"2186":{"id":"/docs/deploy/kubernetes-31","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"`nexus`"},"2187":{"id":"/docs/deploy/kubernetes-32","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"`/idp/realms/nexus` and `/idp/resources` → keycloak, `/` → web; TLS from a Secret you name"},"2188":{"id":"/docs/deploy/kubernetes-33","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"Secrets"},"2189":{"id":"/docs/deploy/kubernetes-34","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"`nexus-db` · `nexus-keys` · `nexus-service-tokens` · `nexus-idp` (· `nexus-vault`)"},"2190":{"id":"/docs/deploy/kubernetes-35","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"**pre-created by you** on every real cluster; created from values only on kind"},"2191":{"id":"/docs/deploy/kubernetes-36","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"Optional"},"2192":{"id":"/docs/deploy/kubernetes-37","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"`model-server` Deployment (llama.cpp) · `ExternalSecret`s"},"2193":{"id":"/docs/deploy/kubernetes-38","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"disconnected inference in-cluster · cloud secret managers"},"2194":{"id":"/docs/deploy/kubernetes-39","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"Modules (off by default)"},"2195":{"id":"/docs/deploy/kubernetes-40","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"`map.enabled` → `nexus-map-api` + `migrate-map` · `care.enabled` → `nexus-care-api` (`careApi.publicOrigin`, `channelsPoll`, Secret `care-client-hash-salt`) · `forge.enabled` → `nexus-forge-api` + NetworkPolicy (egress postgres · core-api · chat-api)"},"2196":{"id":"/docs/deploy/kubernetes-41","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"the module APIs; databases `nexus_map` (PostGIS), `nexus_care`, `nexus_forge` — an external PostgreSQL must offer PostGIS for `nexus_map`; the module web apps join the `web` image in a coming release"},"2197":{"id":"/docs/deploy/kubernetes-42","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"Voice"},"2198":{"id":"/docs/deploy/kubernetes-43","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"the `VOICE_*` keys in `configmaps.yaml`, the `LIVEKIT_API_SECRET` seam"},"2199":{"id":"/docs/deploy/kubernetes-44","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#what-the-chart-installs","content":"the chart carries the configuration; the `asr-local` / `tts-local` sidecar Deployments join at UAT-4 — until then point `NEXUS_ASR_LOCAL_BASE_URL` / `NEXUS_TTS_LOCAL_BASE_URL` at your own Services"},"2200":{"id":"/docs/deploy/kubernetes-45","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"**Helm 3.8+**, `kubectl`, and either **kind** or **k3d** on the laptop, or credentials for the cluster."},"2201":{"id":"/docs/deploy/kubernetes-46","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"A cluster with a CNI that **enforces** NetworkPolicy (Calico, Cilium, most managed CNIs). kind's default CNI only\nstores the policies; the local script offers a Calico cluster config for that reason."},"2202":{"id":"/docs/deploy/kubernetes-47","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"A default StorageClass for Postgres and NATS volumes (in-cluster mode) and for core-api's credential store."},"2203":{"id":"/docs/deploy/kubernetes-48","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"For a real cluster: an ingress controller, a TLS certificate (cert-manager or your PKI), a mail relay, and — for\ndisconnected sites — a registry mirror with the release copied into it."},"2204":{"id":"/docs/deploy/kubernetes-49","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"`k8s-local.sh up` does four things you will later do by hand: creates the cluster if it is missing (kind or k3d,\nwhichever is installed; `K8S_TOOL` to choose), loads the images into it, writes a **one-time secrets file outside\nthe repository** with random passwords and keys, and runs"},"2205":{"id":"/docs/deploy/kubernetes-50","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"then smoke-tests through the NodePort. Open `http://localhost:30000/chat`."},"2206":{"id":"/docs/deploy/kubernetes-51","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"Watch the release come up: `kubectl -n nexus get pods -w`. The API pods sit in `Init` until their migration Job has\nfinished — that is the `migrate-wait` initContainer doing its job."},"2207":{"id":"/docs/deploy/kubernetes-52","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"Create the namespace and **the Secrets first** — the chart mounts them and never creates them when\n`secrets.create=false` (the default). Use sealed-secrets, an OpenBao/Vault injector, External Secrets or plain\n`kubectl` from a machine that holds the values; the point is that no value ever appears in a values file or in\nHelm's release history."},"2208":{"id":"/docs/deploy/kubernetes-53","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"Secret"},"2209":{"id":"/docs/deploy/kubernetes-54","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"Keys"},"2210":{"id":"/docs/deploy/kubernetes-55","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"What it is"},"2211":{"id":"/docs/deploy/kubernetes-56","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"`nexus-db`"},"2212":{"id":"/docs/deploy/kubernetes-57","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"`password`"},"2213":{"id":"/docs/deploy/kubernetes-58","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"the `nexus` role's password"},"2214":{"id":"/docs/deploy/kubernetes-59","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"`nexus-keys`"},"2215":{"id":"/docs/deploy/kubernetes-60","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"`broker-master-key` · `hook-master-key`"},"2216":{"id":"/docs/deploy/kubernetes-61","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"two random 32-byte values, base64 — seal stored credentials and webhook secrets"},"2217":{"id":"/docs/deploy/kubernetes-62","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"`nexus-service-tokens`"},"2218":{"id":"/docs/deploy/kubernetes-63","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"`core-api` · `chat-api` · `chat-worker` · `sandbox-manager` · `tasks-api`"},"2219":{"id":"/docs/deploy/kubernetes-64","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"one credential per process, presented on service-to-service calls"},"2220":{"id":"/docs/deploy/kubernetes-65","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"`nexus-idp`"},"2221":{"id":"/docs/deploy/kubernetes-66","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"`db-password` · `admin-password` · `web-client-secret` · `admin-client-secret` · `session-signing-key` · `google-client-secret` · `smtp-user` · `smtp-password`"},"2222":{"id":"/docs/deploy/kubernetes-67","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"Keycloak's own database role, its bootstrap admin, the two OIDC clients core-api uses, the Ed25519 seed that signs session assertions, the Google broker, the mail relay"},"2223":{"id":"/docs/deploy/kubernetes-68","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"`nexus-vault`"},"2224":{"id":"/docs/deploy/kubernetes-69","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"`token`"},"2225":{"id":"/docs/deploy/kubernetes-70","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"only when `coreApi.vault.addr` points at an OpenBao/Vault (a read-only token)"},"2226":{"id":"/docs/deploy/kubernetes-71","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"`nexus-registry`"},"2227":{"id":"/docs/deploy/kubernetes-72","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"docker-registry type"},"2228":{"id":"/docs/deploy/kubernetes-73","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"only when images come from a private registry (also copied into `nexus-sandbox`)"},"2229":{"id":"/docs/deploy/kubernetes-74","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"`nexus-tls`"},"2230":{"id":"/docs/deploy/kubernetes-75","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"tls type"},"2231":{"id":"/docs/deploy/kubernetes-76","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"the certificate the Ingress terminates"},"2232":{"id":"/docs/deploy/kubernetes-77","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"Back up `nexus-keys` the way you back up a master password: without `broker-master-key`, every credential the\nplatform has stored for connections is unreadable."},"2233":{"id":"/docs/deploy/kubernetes-78","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"**Postgres.** Either let the chart run it (`postgres.mode=incluster`, a StatefulSet with the role, the four databases\nand the storage you size in values) or bring your own (`postgres.mode=external`, `postgres.host`, `postgres.sslmode=require`).\nOn an external instance create the roles and databases yourself before the first install:"},"2234":{"id":"/docs/deploy/kubernetes-79","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"`NOBYPASSRLS` matters: the schemas use row-level security per tenant, and the application role must be subject to it."},"2235":{"id":"/docs/deploy/kubernetes-80","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"**Preparing for the knowledge family.** NexGraph's processes join the chart in a coming release; its databases can\nbe ready before that. `nexus_graph` needs the **Apache AGE** and **pgvector** extensions — in-cluster, set\n`postgres.incluster.image` to the suite image (`nexus/postgres`, built from `deploy/docker/postgres/Dockerfile`; the chart's\ninit script then creates the extensions in `nexus_graph` only). On an external instance the extensions must be\ninstallable there — managed services differ: pgvector is common, Apache AGE is not — and the roles follow the same\npattern, each with its own least privilege:"},"2236":{"id":"/docs/deploy/kubernetes-81","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"Start from the on-prem example the chart ships and change only what is marked as target-specific. A complete\nfile for a cluster with its own ingress and in-cluster state looks like this:"},"2237":{"id":"/docs/deploy/kubernetes-82","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"Provider keys for cloud models are not in this file either. Give them to core-api as a Secret whose keys become\nenvironment variables verbatim (`secrets.providerKeys.existingSecret: nexus-provider-keys` with a key\n`NEXUS_OPENAI_API_KEY`), or — better — keep them in a vault and set `coreApi.vault.addr`; the registry then holds\n`vault://kv/nexus/openai#api_key` and `allowEnvSecrets` can be `\"false\"`."},"2238":{"id":"/docs/deploy/kubernetes-83","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"A site with its own model registry passes the two files in as content rather than mounting anything:"},"2239":{"id":"/docs/deploy/kubernetes-84","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"Both are **references only** — a literal key in either file is a core-api startup error."},"2240":{"id":"/docs/deploy/kubernetes-85","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"Install from the OCI registry the release was published to, or from your mirror, or from the chart directory:"},"2241":{"id":"/docs/deploy/kubernetes-86","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"`helm get notes nexus -n nexus` prints these commands adapted to the values you used. Then open the public URL,\nregister the first account, and continue with Get started."},"2242":{"id":"/docs/deploy/kubernetes-87","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"Every upgrade renders three new migration Jobs (`-r<revision>`), the new API pods wait for them, the old pods keep\nserving until then. `helm rollback` restores the previous images and configuration, **not** the schema — migrations\nare forward-only. Take a database backup before an upgrade and treat a rollback as an emergency measure, never as a\nroutine."},"2243":{"id":"/docs/deploy/kubernetes-88","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"A cluster without internet takes the release from a mirror and answers with a model it hosts itself:"},"2244":{"id":"/docs/deploy/kubernetes-89","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"On a connected machine: `deploy/scripts/mirror.sh --release RELEASE.json --to registry.example.internal/nexus`\ncopies the eight images and the chart by digest and verifies their signatures\n(Operations → Releases)."},"2245":{"id":"/docs/deploy/kubernetes-90","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"Copy the model weights (a GGUF file) into a PVC named in `modelServer.modelPvc`."},"2246":{"id":"/docs/deploy/kubernetes-91","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"Set `deploymentProfile: disconnected`, `modelServer.enabled: true` with `modelFile` and `alias`, and a node\nselector for the pool that has the memory (or the GPU). The site registry's `local_ollama`/local provider points at\n`http://model-server:8080/v1`, inside the contour; `egressPrivateCidrs` and `egressAllowHttp: \"true\"` let the\ngateway reach it over plain HTTP inside the cluster."},"2247":{"id":"/docs/deploy/kubernetes-92","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#before-you-start","content":"Install as in step 4. The smoke report and the first chat turn prove the loop is closed with no route outside."},"2248":{"id":"/docs/deploy/kubernetes-93","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#the-sandbox-boundary-in-kubernetes-terms","content":"Every code execution an agent asks for becomes a Job in `nexus-sandbox`. The manager is the only identity that can\ncreate it; the Job runs the `sandbox-python` image as a non-root user on a read-only root filesystem with a\ndeny-all NetworkPolicy — it cannot reach the APIs, the database, the internet or another sandbox. A ResourceQuota\ncaps how many can run at once. With a gVisor RuntimeClass (`sandbox.runtimeClassName: gvisor`) the kernel is\nisolated too, which is what the strictest data-classification profiles require; without it the platform simply\nrefuses to run those profiles rather than running them less safely."},"2249":{"id":"/docs/deploy/kubernetes-94","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#the-production-switch","content":"`nexusEnv` is `dev` in every shipped values file, on purpose: in `dev` the platform accepts development-only drivers\nand prints the fact in its health body. `production` makes every process refuse anything that is not\nproduction-grade — a mock session, fixture identity providers, a fake sandbox, a dev mail sink. Flip it when\nKeycloak is enabled with a real mail relay, provider keys live in a vault or a cloud secret manager, and the\nsmoke report is green. Nothing else in the values changes."},"2250":{"id":"/docs/deploy/kubernetes-95","page_id":"/docs/deploy/kubernetes","tags":[],"type":"text","url":"/docs/deploy/kubernetes#the-production-switch","content":"Next rung: AWS — the same chart with RDS, Secrets Manager and an ALB around it. Releases, mirroring, backups and rotation for every cluster: Operations."},"2251":{"id":"/docs/deploy/local","page_id":"/docs/deploy/local","type":"page","content":"1 · Developer laptop","breadcrumbs":["Nexi Docs","Deploy","The ladder"],"tags":[],"url":"/docs/deploy/local"},"2252":{"id":"/docs/deploy/local-0","page_id":"/docs/deploy/local","tags":[],"type":"text","url":"/docs/deploy/local","content":"One command starts everything with hot reload — Postgres, Keycloak and a mail catcher in Docker; the APIs, the web apps and the knowledge pipeline as host processes."},"2253":{"id":"/docs/deploy/local-1","page_id":"/docs/deploy/local","type":"heading","tags":[],"url":"/docs/deploy/local#what-you-get","content":"What you get"},"2254":{"id":"/docs/deploy/local-2","page_id":"/docs/deploy/local","type":"heading","tags":[],"url":"/docs/deploy/local#before-you-start","content":"Before you start"},"2255":{"id":"/docs/deploy/local-3","page_id":"/docs/deploy/local","type":"heading","tags":[],"url":"/docs/deploy/local#where-things-are","content":"Where things are"},"2256":{"id":"/docs/deploy/local-4","page_id":"/docs/deploy/local","type":"heading","tags":[],"url":"/docs/deploy/local#reset","content":"Reset"},"2257":{"id":"/docs/deploy/local-5","page_id":"/docs/deploy/local","tags":[],"type":"text","url":"/docs/deploy/local","content":"The laptop stack exists for one purpose: **changing Nexi itself**. Every API restarts when you save a file, every\nweb app reloads in the browser, logs stream into one terminal. It is not a way to run Nexi for other people —\nthat starts one rung up, with Docker Compose."},"2258":{"id":"/docs/deploy/local-6","page_id":"/docs/deploy/local","tags":[],"type":"text","url":"/docs/deploy/local#what-you-get","content":"Process"},"2259":{"id":"/docs/deploy/local-7","page_id":"/docs/deploy/local","tags":[],"type":"text","url":"/docs/deploy/local#what-you-get","content":"Where"},"2260":{"id":"/docs/deploy/local-8","page_id":"/docs/deploy/local","tags":[],"type":"text","url":"/docs/deploy/local#what-you-get","content":"Address"},"2261":{"id":"/docs/deploy/local-9","page_id":"/docs/deploy/local","tags":[],"type":"text","url":"/docs/deploy/local#what-you-get","content":"NexChat web"},"2262":{"id":"/docs/deploy/local-10","page_id":"/docs/deploy/local","tags":[],"type":"text","url":"/docs/deploy/local#what-you-get","content":"host, hot reload"},"2263":{"id":"/docs/deploy/local-11","page_id":"/docs/deploy/local","tags":[],"type":"text","url":"/docs/deploy/local#what-you-get","content":"`http://127.0.0.1:3210`"},"2264":{"id":"/docs/deploy/local-12","page_id":"/docs/deploy/local","tags":[],"type":"text","url":"/docs/deploy/local#what-you-get","content":"NexCore web"},"2265":{"id":"/docs/deploy/local-13","page_