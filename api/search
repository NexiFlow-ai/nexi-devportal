ulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Scene**"},"7665":{"id":"/docs/technical/vocabulary-135","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"NexForge's object: objects, relations, layers, cameras and a colour key — not a drawing — projected as Board, Diagram, 3D and Present."},"7666":{"id":"/docs/technical/vocabulary-136","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Scene operation**"},"7667":{"id":"/docs/technical/vocabulary-137","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"One of twenty-six closed edits every hand compiles to; applied on the server, with an inverse; a batch is a version."},"7668":{"id":"/docs/technical/vocabulary-138","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Proposal**"},"7669":{"id":"/docs/technical/vocabulary-139","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"What the Scene Agent returns — a ghost on the canvas with Apply · Modify · Cancel · Why this?; the person applies."},"7670":{"id":"/docs/technical/vocabulary-140","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Dictation**"},"7671":{"id":"/docs/technical/vocabulary-141","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"Speaking into a field: the words land there and no turn runs. A command speaks to the scene."},"7672":{"id":"/docs/technical/vocabulary-142","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Door**"},"7673":{"id":"/docs/technical/vocabulary-143","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"A link from one application into another — *Ask in Chat*, *Open in Graph*, *Open in VibeBan*, Forge's Backlog · Flows · Knowledge — always a reference, never a copy."},"7674":{"id":"/docs/technical/vocabulary-144","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"The knowledge words — the ones you meet in NexGraph and in an answer *from the knowledge graph*:"},"7675":{"id":"/docs/technical/vocabulary-145","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"Word"},"7676":{"id":"/docs/technical/vocabulary-146","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"One sentence"},"7677":{"id":"/docs/technical/vocabulary-147","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Source · binding**"},"7678":{"id":"/docs/technical/vocabulary-148","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"A place NexGraph may read from, bound to one Project — an Upload box, a Server folder, a Google Drive folder — with five states."},"7679":{"id":"/docs/technical/vocabulary-149","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Source version**"},"7680":{"id":"/docs/technical/vocabulary-150","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"One pinned set of bytes with its SHA-256; the identity of a document. A changed file is a new version, the old one stays."},"7681":{"id":"/docs/technical/vocabulary-151","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Tier**"},"7682":{"id":"/docs/technical/vocabulary-152","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"Whose knowledge it is: Project, Organization, Personal — or Base, the platform's own documentation. Never widened downstream."},"7683":{"id":"/docs/technical/vocabulary-153","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Lexical · Subject · Domain**"},"7684":{"id":"/docs/technical/vocabulary-154","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"The three layers: what was written · what a model proposes it means · what an oracle or a person decided."},"7685":{"id":"/docs/technical/vocabulary-155","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Bronze · Silver · Gold**"},"7686":{"id":"/docs/technical/vocabulary-156","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"The three stores, all in PostgreSQL: raw bytes · fragments, mentions and vectors (pgvector) · entities and verified facts (Apache AGE)."},"7687":{"id":"/docs/technical/vocabulary-157","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Mention**"},"7688":{"id":"/docs/technical/vocabulary-158","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"A span the extractor labelled with a type and a score. A proposal."},"7689":{"id":"/docs/technical/vocabulary-159","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Entity · term**"},"7690":{"id":"/docs/technical/vocabulary-160","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"What mentions resolve to across documents; in Vocabulary, a *term in use*."},"7691":{"id":"/docs/technical/vocabulary-161","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Claim**"},"7692":{"id":"/docs/technical/vocabulary-162","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"A numeric statement read from a table cell — metric, value, locator — *proposed* until an oracle or a person decides; *contested* when sources disagree; *superseded* by a newer version."},"7693":{"id":"/docs/technical/vocabulary-163","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Oracle**"},"7694":{"id":"/docs/technical/vocabulary-164","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"A deterministic, versioned check — transcription re-reads the cell, arithmetic checks a Total against its parts. Never a model."},"7695":{"id":"/docs/technical/vocabulary-165","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Curator**"},"7696":{"id":"/docs/technical/vocabulary-166","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"A person with the editor relation who confirms a claim within a named scope or returns it for clarification."},"7697":{"id":"/docs/technical/vocabulary-167","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Run**"},"7698":{"id":"/docs/technical/vocabulary-168","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"One pass of the six-stage pipeline over one source version, kept as a receipt: steps, executors, produced counts, log."},"7699":{"id":"/docs/technical/vocabulary-169","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Evidence bundle**"},"7700":{"id":"/docs/technical/vocabulary-170","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"What an answer is grounded in: the fragments, verified facts and figures the asker may read — each with *why* it is there."},"7701":{"id":"/docs/technical/vocabulary-171","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"**Capture policy**"},"7702":{"id":"/docs/technical/vocabulary-172","page_id":"/docs/technical/vocabulary","tags":[],"type":"text","url":"/docs/technical/vocabulary","content":"A Project's rule on whether outcomes of Agent and Flow runs become *proposed* knowledge (Memory, preview)."},"7703":{"id":"/docs/technical/voice-and-screen-context","page_id":"/docs/technical/voice-and-screen-context","type":"page","content":"Voice, screen context, search and research","breadcrumbs":["Nexi Docs","Technical documentation","Building blocks"],"tags":[],"url":"/docs/technical/voice-and-screen-context"},"7704":{"id":"/docs/technical/voice-and-screen-context-0","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context","content":"How a spoken sentence becomes a message, a command or a confirmation without gaining a single right; how speech runs through the Model Gateway on local sidecars; what a context snapshot is and when pronouns bind to it; why session files and shared frames never enter the organization's memory; and how web search and research leave the platform under the classification ceiling."},"7705":{"id":"/docs/technical/voice-and-screen-context-1","page_id":"/docs/technical/voice-and-screen-context","type":"heading","tags":[],"url":"/docs/technical/voice-and-screen-context#voice-in","content":"Voice in"},"7706":{"id":"/docs/technical/voice-and-screen-context-2","page_id":"/docs/technical/voice-and-screen-context","type":"heading","tags":[],"url":"/docs/technical/voice-and-screen-context#voice-out","content":"Voice out"},"7707":{"id":"/docs/technical/voice-and-screen-context-3","page_id":"/docs/technical/voice-and-screen-context","type":"heading","tags":[],"url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"The sidecars"},"7708":{"id":"/docs/technical/voice-and-screen-context-4","page_id":"/docs/technical/voice-and-screen-context","type":"heading","tags":[],"url":"/docs/technical/voice-and-screen-context#platform-actions","content":"Platform actions"},"7709":{"id":"/docs/technical/voice-and-screen-context-5","page_id":"/docs/technical/voice-and-screen-context","type":"heading","tags":[],"url":"/docs/technical/voice-and-screen-context#screen-context","content":"Screen context"},"7710":{"id":"/docs/technical/voice-and-screen-context-6","page_id":"/docs/technical/voice-and-screen-context","type":"heading","tags":[],"url":"/docs/technical/voice-and-screen-context#session-files-and-shared-frames","content":"Session files and shared frames"},"7711":{"id":"/docs/technical/voice-and-screen-context-7","page_id":"/docs/technical/voice-and-screen-context","type":"heading","tags":[],"url":"/docs/technical/voice-and-screen-context#web-search","content":"Web search"},"7712":{"id":"/docs/technical/voice-and-screen-context-8","page_id":"/docs/technical/voice-and-screen-context","type":"heading","tags":[],"url":"/docs/technical/voice-and-screen-context#research-built-awaiting-approval","content":"Research (built, awaiting approval)"},"7713":{"id":"/docs/technical/voice-and-screen-context-9","page_id":"/docs/technical/voice-and-screen-context","type":"heading","tags":[],"url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"What is stored, what is not"},"7714":{"id":"/docs/technical/voice-and-screen-context-10","page_id":"/docs/technical/voice-and-screen-context","type":"heading","tags":[],"url":"/docs/technical/voice-and-screen-context#security-in-one-list","content":"Security in one list"},"7715":{"id":"/docs/technical/voice-and-screen-context-11","page_id":"/docs/technical/voice-and-screen-context","type":"heading","tags":[],"url":"/docs/technical/voice-and-screen-context#where-to-read-more","content":"Where to read more"},"7716":{"id":"/docs/technical/voice-and-screen-context-12","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context","content":"The chapters Speak to Nexi, Act from anywhere\nand Search the web and research a question show these from the outside. This\npage is the inside of voice and actions: the composer microphone, the platform-action arm, the\n`ContextSnapshot`, session material, the `web.search` port and the research Flow. Three fitness rules hold them\ntogether: **voice adds no rights**, **audio and frames are never stored**, and **what you show Nexi is quoted data,\nnever instructions**."},"7717":{"id":"/docs/technical/voice-and-screen-context-13","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#voice-in","content":"The composer mic (`NexusComposer`, testid `composer-mic`) is the real entry point; the shell *Voice Dock* renders only\nunder `?voice_demo=` and is a UAT-1 fixture. One tap opens the mic; a browser **energy endpointer** ends the turn —\nspeech ≥ 200 ms above 0.09 RMS, then **1.5 s** of silence; 7 s of nothing → &#x2A;Didn't hear anything.*; 60 s cap;\ntap again = *Send now*; `Esc` cancels. While open, the card is **the wave alone**: no status words, the text\nbox hidden, the state for assistive technology in `nexus-sr-only`."},"7718":{"id":"/docs/technical/voice-and-screen-context-14","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#voice-in","content":"The clip (≤ 2 MiB, ≤ 60 s, `audio_base64`) goes once to `POST /chat/voice/transcriptions`; chat-api runs the thread's\nPEP as a message write **before a byte moves**, then core-api `POST /synapse/inference/transcribe&#x60; with the **`asr`\nrole** (floor 0.8): `faster-whisper-large-v3-turbo` on the local sidecar is tier 1 and the default;\n`gpt-4o-mini-transcribe` is tier 4 and eligible only up to *confidential*. The transcript becomes the person's bubble\nwith a *Spoken* mark (`Spoken · edited` if corrected; confidence \\< 0.5 leaves it in the composer). The UI locale is the\nhint; the corpus covers uk · en · ru · de."},"7719":{"id":"/docs/technical/voice-and-screen-context-15","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#voice-in","content":"**Talk** (hands-free, S3b): `+` → *Talk hands-free*; 16 kHz PCM over an authenticated WebSocket\n(`VOICE_TRANSPORT_DRIVER=ws`, `VOICE_STREAM_PUBLIC_URL`), server-side **Silero VAD v5** (`VOICE_VAD_DRIVER=auto|silero|\nenergy`; the energy fallback shows *Basic voice detection on this server*), barge-in by speaking (82 ms measured,\n300 ms budget), spoken stop words in en/uk/de, Mute, End, 300 s idle. Access is re-checked on every turn\n(`access_lost`). A `livekit` transport is declared and not wired — it yields *Hands-free isn't available in this\ndeployment*."},"7720":{"id":"/docs/technical/voice-and-screen-context-16","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#voice-out","content":"`POST /chat/voice/speech` derives **one sentence server-side** from the settled turn: a card speaks its result\n(&#x2A;Opening Inbox.* · &#x2A;Which one: A or B?* · &#x2A;Task created — MKT-1.*); a text answer is spoken as a **gist** — one\n`chat_fast` call with `prompts/voice_spoken_gist.md`, ≤ 35 words, first sentence as fallback — preceded by an\nacknowledgement (&#x2A;Let me look.* · &#x2A;One moment.* · &#x2A;On it.&#x2A;) the moment the words are understood. The **`tts`\nrole** (floor 0.7) is served by `ukrainian-tts` (Tetiana) for Ukrainian and `gpt-4o-mini-tts` for en/ru/de up to\n*confidential*; at *secret* a non-Ukrainian answer stays text. One `SpeechPlayer` per tab; the strip offers **Stop** and\n**Text only** (sessionStorage — no `synthesize` call leaves); `+` → *Turn voice answers off*. Tapping the mic over\nspeech is barge-in."},"7721":{"id":"/docs/technical/voice-and-screen-context-17","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"`apps/asr-local`"},"7722":{"id":"/docs/technical/voice-and-screen-context-18","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"`apps/tts-local`"},"7723":{"id":"/docs/technical/voice-and-screen-context-19","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"Engine"},"7724":{"id":"/docs/technical/voice-and-screen-context-20","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"faster-whisper / CTranslate2 (MIT), `deepdml/faster-whisper-large-v3-turbo-ct2` (\\~1.6 GB)"},"7725":{"id":"/docs/technical/voice-and-screen-context-21","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"`ukrainian-tts` 6.0 (MIT wrapper, ESPnet2 VITS Apache-2.0), 5 voices, \\~450 MB"},"7726":{"id":"/docs/technical/voice-and-screen-context-22","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"Door"},"7727":{"id":"/docs/technical/voice-and-screen-context-23","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"`POST /v1/audio/transcriptions&#x60; (OpenAI-shaped), loopback **:8090**"},"7728":{"id":"/docs/technical/voice-and-screen-context-24","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"`POST /v1/audio/speech&#x60;, loopback **:8091**"},"7729":{"id":"/docs/technical/voice-and-screen-context-25","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"Reached by"},"7730":{"id":"/docs/technical/voice-and-screen-context-26","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"core-api only — `NEXUS_ASR_LOCAL_BASE_URL`"},"7731":{"id":"/docs/technical/voice-and-screen-context-27","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"core-api only — `NEXUS_TTS_LOCAL_BASE_URL`"},"7732":{"id":"/docs/technical/voice-and-screen-context-28","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"Speed"},"7733":{"id":"/docs/technical/voice-and-screen-context-29","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"≈ 8 s per command on an M4 CPU with a language hint"},"7734":{"id":"/docs/technical/voice-and-screen-context-30","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"≈ 0.7 s per sentence"},"7735":{"id":"/docs/technical/voice-and-screen-context-31","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"Doubles"},"7736":{"id":"/docs/technical/voice-and-screen-context-32","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"`ASR_ENGINE=fixture` (refused in production)"},"7737":{"id":"/docs/technical/voice-and-screen-context-33","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"—"},"7738":{"id":"/docs/technical/voice-and-screen-context-34","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"Logs"},"7739":{"id":"/docs/technical/voice-and-screen-context-35","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"counts only; no audio, no text"},"7740":{"id":"/docs/technical/voice-and-screen-context-36","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"counts only"},"7741":{"id":"/docs/technical/voice-and-screen-context-37","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#the-sidecars","content":"The dev stack starts each when `.venv/bin/asr-local` / `tts-local` exists (`uv pip install -e \".[dev,whisper]\"` /\n`\".[dev,ukrainian]\"`), installs `platform/media[silero]` into chat-api's venv and migrates chat-api's `.env` with the\n`VOICE_*` keys — all **required, no defaults**; `fixture` drivers are refused in production. Compose has profiles\n`asr-local`, `tts-local` and `media` (LiveKit, unused by the browser yet) with no published ports; Helm carries the\nenv but no sidecar profile yet (UAT-4). A *confidential* Project **must** have a local `asr`/`tts` route — a fitness\ncheck enforces it."},"7742":{"id":"/docs/technical/voice-and-screen-context-38","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#platform-actions","content":"Each app declares its commands in the tool registry as `ToolDefinition`s with `execution = client_action |\nplatform_tool` and a `platform_action` block (`core_api/tools/platform_tools.py`): `home.open · chat.open ·\nchat.open_thread · chat.open_project · chat.open_flow · tasks.open · tasks.open_inbox · tasks.open_board ·\ntasks.open_sprint · tasks.open_backlog · graph.open · graph.open_studio · graph.open_sources · map.open · bi.open ·\nbi.open_dashboard · core.open · core.open_approvals · core.open_access · task.create · task.assign · task.move ·\nflow.start · flow.explain_last_run · answer.save · knowledge.add_session_file · web.search · research.run`. No product\nnoun lives in arm code — the registry is the source."},"7743":{"id":"/docs/technical/voice-and-screen-context-39","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#platform-actions","content":"The **platform-action arm** (`chat_api/auto/platform_action_arm.py`) runs **before any model**: verb cue ∧ object cue\n→ candidates → target resolved **through the owning app's door as the person** (`SearchService`, `tasks.list_projects`)\n→ PDP `read` on the exact target → a `client_action` message with status `resolved` (auto-navigates once if newest and\n≤ 15 s), `choice` (2…8 targets with kinds) or `not_found` (identical for missing and not-permitted). Hrefs\ncome from registry templates filled from the resolved resource, never from the sentence. Exclusions `foreign_family`,\n`not_a_command`, `asks_how` keep questions and other systems' nouns out. **Confirmation levels** (ADR-0052 §2): 1 runs\nat once; 2 previews and reads back, a *yes* required (`task.create`, `flow.start`, `answer.save`); 3 shows the exact\nchange and waits (`task.assign`, `task.move`, `knowledge.add_session_file`); 4 is an on-screen door only\n(`access.change`). A *yes* binds to `proposal_id` + `version`; a correction voids it; TTL 600 s. Writes go\nthrough tasks-api, graph-api and the Flow Runtime with their own PEP and `idempotency_key = request_id`. No action is\n`agent_bindable`."},"7744":{"id":"/docs/technical/voice-and-screen-context-40","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#screen-context","content":"`ContextSnapshot` (`context-snapshot.schema.json`): `snapshot_id · app · resource_ref · resource_kind · label ·\nselection_ref · filters · time_range · screen_surface · frame_ref · captured_at · org_id · verified` — references and\nclosed values, never DOM or pixels. Another app's Ask bar hands over\n`/chat?project=…&context=nexus://…&kind=…&label=…&q=…`; the ref becomes the **context chip** above the composer. The\nsnapshot travels on every send and Confirm; the server stamps `snapshot_id` and `org_id` and sets `verified` only\nafter the owning app's door answered READ as the person. Pronouns (*this · it · це · этот · dies*) bind to a verified\nsnapshot; nothing verified → `context_missing`; Confirm from another resource → `context_stale` (both choices shown);\nrelation gone → `context_access_changed`. There is no \"Talk about this\" button — the chip is the mechanism."},"7745":{"id":"/docs/technical/voice-and-screen-context-41","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#session-files-and-shared-frames","content":"**Session file**: `+` → *Provide a file for this session* → `POST /chat/voice/files` (≤ 20 MiB), parsed in-process,\n**text family only** (txt · md · csv · tsv · json · html · xml); PDF/Office refused typed `parser_unavailable`. Never a\nSource, an attachment, a Bronze blob or an index; `retention = session_only` on both the file and its answers —\ngraph-api capture and digests skip them. The **FileAnswerCard** cites exact quotes (`Temporary source ·\np. N`; a quote not in the extract is dropped) and lists what the file does not say. Lifetime 8 h\n(`tuning.voice.session_file_lifetime_s`), one per thread, `content`/`extract` purged on Remove or sweep, filename and\nsha kept. Saving is separate and confirmed: *save this answer* (level 2, a Project artifact, `retention = saved`) or\n*add this to the project knowledge* (level 3, graph-api `POST /graph/internal/uploads` as the person)."},"7746":{"id":"/docs/technical/voice-and-screen-context-42","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#session-files-and-shared-frames","content":"**Shared screen**: `getDisplayMedia` (video only) on the person's click; **one frame per question** (PNG/JPEG ≤ 2 MiB,\noptional crop) → one Gateway `vision` call → bytes dropped (`voice_frames.image` nulled, sha256 kept). Stop keeps facts\nfor an hour; *End and clear* purges now. A frame or file turn offers the model **no tools** and cannot propose an\naction: it is quoted data."},"7747":{"id":"/docs/technical/voice-and-screen-context-43","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#web-search","content":"The `web.search` **provider port** lives in core-api (`POST /synapse/web-search/{providers,query}`), adapters in\n`platform/synapse/nexus_synapse/web/search.py&#x60;. Four classes: &#x2A;*`api`** Tavily · Brave · Mojeek · LangSearch (keys as\nSynapse connections, `config/synapse/integrations/web-search-*.yaml&#x60;); &#x2A;*`open_data`*&#x2A; Wikipedia · Wikidata ·\nOpenStreetMap; &#x2A;*`own`** `nexus_index&#x60; (Project knowledge only); &#x2A;*`model_native`** OpenRouter `web` plugin (off by\ndefault). **SearXNG and Oxylabs are rejected** and there is no SERP-in-a-browser. Order is the\nBlueprint's `tuning.web_search.providers` (default Tavily → LangSearch → open data → own; a layer may only narrow),\nopen data first for `places`/`facts`, first answer wins, ≤ 10 results. **Classification ceiling**\n`tuning.web_search.max_classification = confidential`: on a *secret* thread no query leaves. Auto hears a closed\nen/uk/ru/de lexicon (`chat_api/auto/search.py`); one model call with results **quoted as untrusted data, no tools**\n(`prompts/search_answer.md`), `[n]` validated against ranks. No provider → *No web answer* + a typed reason + **Ask the\nadministrator** (one `CapabilityRequest` on `web.search`). Queries leave only through core-api's door as the person,\nand `session_only` content never routes to a provider whose retention is not `none`."},"7748":{"id":"/docs/technical/voice-and-screen-context-44","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#research-built-awaiting-approval","content":"The base-pack Flow `web-research` (pack 1.26.0): `plan (agent) → search (web.search) → scope → allow (approval) →\nreading loop (read agent → ledger tool → enough evaluator) → narrate → report`. A research cue (en/uk/de, no ru)\nroutes to the **Resolver**, which runs the Flow as a child run. The reading plane is **graph-api over HTTP**\n(`browser.open` / `browser.follow`, `render: http`; Playwright in the Sandbox is S6c): the model names a **link id**,\nnever a URL; CAPTCHA, anti-bot, paywall and auth walls stop the host unsolved; budgets are tool-side\n(`tuning.web_research`: 30 pages · depth 2 · 8/host · 2 s jittered · 6 min · 24 MB); only allow-listed hosts through the\nSynapse egress pipeline, redirects re-admitted against the list. The report's confidence chip is the **engine's\ncorroboration count**; `[n]` links only to pages read; a proposed source becomes a `web` binding of the Project **as\nthe person** (`POST /chat/flow-runs/{run_id}/research-source`) and then follows NexGraph's pipeline as proposed\nclaims. Live-run findings of 2026-10-01: F-1 Gateway refused tool calls under an output schema (fixed), F-2 the\n`research_scope` row hit a DB constraint (fixed, migration 0060), F-3 a how-to sentence routed to *Create a work item*\n(fixed, `asks_how`), F-4 knowledge fallback leaks mechanism text in a fresh organization (open). The UX verdict — one\ncard, result in the thread — ships with the NexChat backbone work."},"7749":{"id":"/docs/technical/voice-and-screen-context-45","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"Thing"},"7750":{"id":"/docs/technical/voice-and-screen-context-46","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"Kept"},"7751":{"id":"/docs/technical/voice-and-screen-context-47","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"Not kept"},"7752":{"id":"/docs/technical/voice-and-screen-context-48","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"Audio clip, Talk stream"},"7753":{"id":"/docs/technical/voice-and-screen-context-49","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"—"},"7754":{"id":"/docs/technical/voice-and-screen-context-50","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"never stored or logged anywhere; sidecars log counts"},"7755":{"id":"/docs/technical/voice-and-screen-context-51","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"Transcript"},"7756":{"id":"/docs/technical/voice-and-screen-context-52","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"text + facts, 1 h if unsent, then the message"},"7757":{"id":"/docs/technical/voice-and-screen-context-53","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"in decision rows (only language, confidence, duration, candidates)"},"7758":{"id":"/docs/technical/voice-and-screen-context-54","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"Spoken sentence"},"7759":{"id":"/docs/technical/voice-and-screen-context-55","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"`voice_speeches` facts"},"7760":{"id":"/docs/technical/voice-and-screen-context-56","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"audio"},"7761":{"id":"/docs/technical/voice-and-screen-context-57","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"Shared frame"},"7762":{"id":"/docs/technical/voice-and-screen-context-58","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"sha256; facts 1 h after Stop"},"7763":{"id":"/docs/technical/voice-and-screen-context-59","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"pixels after the one vision call"},"7764":{"id":"/docs/technical/voice-and-screen-context-60","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"Session file"},"7765":{"id":"/docs/technical/voice-and-screen-context-61","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"filename, sha, pages"},"7766":{"id":"/docs/technical/voice-and-screen-context-62","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"`content`/`extract` after Remove, sweep or 8 h"},"7767":{"id":"/docs/technical/voice-and-screen-context-63","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"Search / research"},"7768":{"id":"/docs/technical/voice-and-screen-context-64","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"provider, class, ranks, hosts, counts"},"7769":{"id":"/docs/technical/voice-and-screen-context-65","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"query text, titles, URLs or pixels in decision rows"},"7770":{"id":"/docs/technical/voice-and-screen-context-66","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#what-is-stored-what-is-not","content":"Decision kinds: `platform_action`, `voice_transcript_pick`, `voice_speak`, `voice_utterance_route`,\n`voice_confirmation`, `web_search_provider`, `web_search`, `web_page_selection`, `research_scope`,\n`research_source_proposal`; outcomes `client_action.acked/picked`, `transcript_*`, `speech_*`, `proposal_*`,\n`action_*`, `context_*`, `frame_*`, `file_*`, `search_answered/refused`, `scope_*`, `source_added/dismissed`.\nMigrations 0050–0058 and 0060."},"7771":{"id":"/docs/technical/voice-and-screen-context-67","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#security-in-one-list","content":"Every voice door is PEP-checked on the exact thread before any byte moves; Mallory gets 404; agents and services get\n403 on person-only doors. Targets resolve through the owning app as the person; writes carry their own PEP and\nidempotency key; access is re-checked on every Confirm and every hands-free turn. Level 4 never completes by voice.\nVoice is not authentication and VAD is never speaker identification. Frames, files, snippets and pages are quoted\ndata — a frame or file turn offers no tools; the search call has no tools and flattens results so a snippet cannot\nforge `[n]`; the research model picks link ids only. Forbidden by fitness checks: voice adding\nrights; a Source or claim from a frame or session file without the separate route; product nouns in arm code;\ntranscript text in decision rows; audio or frames in JetStream, logs, traces or backups; persistent capture without a\nfresh gesture; a results page in a headless browser; CAPTCHA solving or residential proxies."},"7772":{"id":"/docs/technical/voice-and-screen-context-68","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#where-to-read-more","content":"Synapse — the Model Gateway the speech roles belong to."},"7773":{"id":"/docs/technical/voice-and-screen-context-69","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#where-to-read-more","content":"Auto — where the platform-action and search arms sit in the pipeline."},"7774":{"id":"/docs/technical/voice-and-screen-context-70","page_id":"/docs/technical/voice-and-screen-context","tags":[],"type":"text","url":"/docs/technical/voice-and-screen-context#where-to-read-more","content":"NexForge — dictation vs command on the same rails."}},"count":7774},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":2131,"2":7539,"3":4913,"4":6875,"5":5105,"6":7325,"7":6027,"8":3940,"9":6408,"10":7138,"11":5669,"12":6369,"13":7139,"14":7256,"15":6410,"16":7140,"17":2531,"18":5811,"19":7141,"20":1611,"21":7257,"22":3508,"23":4662,"24":2105,"25":2084,"26":2052,"27":2371,"28":4785,"29":4684,"30":6571,"31":1915,"32":2065,"33":5501,"34":5871,"35":7443,"36":7197,"37":2357,"38":2113,"39":2368,"40":4637,"41":2353,"42":2115,"43":2114,"44":4710,"45":2354,"46":6711,"47":1997,"48":6374,"49":4069,"50":6671,"51":6527,"52":1963,"53":2358,"54":2111,"55":2369,"56":1889,"57":7222,"58":4737,"59":7218,"60":7346,"61":7382,"62":137,"63":7714,"64":5462,"65":135,"66":6734,"67":5713,"68":129,"69":6790,"70":2476,"71":584,"72":4231,"73":2825,"74":3507,"75":4048,"76":700,"77":941,"78":5197,"79":702,"80":2373,"81":699,"82":944,"83":6989,"84":698,"85":940,"86":2015,"87":701,"88":943,"89":384,"90":692,"91":942,"92":6176,"93":691,"94":5896,"95":1931,"96":4031,"97":694,"98":3374,"99":3597,"100":2431,"101":950,"102":935,"103":685,"104":920,"105":946,"106":931,"107":693,"108":4769,"109":4646,"110":951,"111":933,"112":690,"113":922,"114":947,"115":929,"116":684,"117":4770,"118":4715,"119":952,"120":937,"121":689,"122":923,"123":930,"124":695,"125":954,"126":924,"127":919,"128":945,"129":932,"130":683,"131":2060,"132":6028,"133":2873,"134":4504,"135":1194,"136":1596,"137":4725,"138":1199,"139":1298,"140":4305,"141":1202,"142":1501,"143":4789,"144":1205,"145":1587,"146":6687,"147":1208,"148":1589,"149":6680,"150":1211,"151":1515,"152":6629,"153"