page","type":"heading","tags":[],"url":"/docs/design-system/patterns/overview-page#rests-on","content":"Rests on"},"3799":{"id":"/docs/design-system/patterns/overview-page-3","page_id":"/docs/design-system/patterns/overview-page","type":"heading","tags":[],"url":"/docs/design-system/patterns/overview-page#in-the-workshop","content":"In the workshop"},"3800":{"id":"/docs/design-system/patterns/overview-page-4","page_id":"/docs/design-system/patterns/overview-page","tags":[],"type":"text","url":"/docs/design-system/patterns/overview-page","content":"A `wide` frame: the `PulseStrip` on top, a row of `Stat`s, then `Section`s with `StatusList`s and &#x2A;View all →* links. Monochrome; no pie, no dashboard tiles with their own colours."},"3801":{"id":"/docs/design-system/patterns/overview-page-5","page_id":"/docs/design-system/patterns/overview-page","tags":[],"type":"text","url":"/docs/design-system/patterns/overview-page#built-from","content":"PageFrame · PulseStrip · Stat · Section · StatusList · Bands"},"3802":{"id":"/docs/design-system/patterns/overview-page-6","page_id":"/docs/design-system/patterns/overview-page","tags":[],"type":"text","url":"/docs/design-system/patterns/overview-page#rests-on","content":"DS-2004 — Page frame widths · DS-0002 — Typography, spacing and borders over decorative colour"},"3803":{"id":"/docs/design-system/patterns/settings-surface","page_id":"/docs/design-system/patterns/settings-surface","type":"page","content":"DS-7007 Settings surface","breadcrumbs":["Nexi Docs","Design system","Patterns"],"tags":[],"url":"/docs/design-system/patterns/settings-surface"},"3804":{"id":"/docs/design-system/patterns/settings-surface-0","page_id":"/docs/design-system/patterns/settings-surface","tags":[],"type":"text","url":"/docs/design-system/patterns/settings-surface","content":"Settings are a PropertyList: one quiet row per property with the control as the value; grouped by InspectorSection idiom=\"rule\" when there are more than six."},"3805":{"id":"