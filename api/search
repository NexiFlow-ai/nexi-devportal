d-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#an-administrator-without-a-project-relation","content":"An administrator without a project relation"},"38":{"id":"/docs/access-rights/denied-screens-16","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#a-viewer-tries-to-create-or-move-an-item","content":"A viewer tries to create or move an item"},"39":{"id":"/docs/access-rights/denied-screens-17","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#an-agent-tries-a-human-only-action","content":"An agent tries a human-only action"},"40":{"id":"/docs/access-rights/denied-screens-18","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#nexbi","content":"NexBI"},"41":{"id":"/docs/access-rights/denied-screens-19","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#an-administrator-opens-a-dashboard-without-a-project-relation","content":"An administrator opens a dashboard without a Project relation"},"42":{"id":"/docs/access-rights/denied-screens-20","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#a-viewer-whose-clearance-is-below-a-blocks-data","content":"A viewer whose clearance is below a block's data"},"43":{"id":"/docs/access-rights/denied-screens-21","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#a-viewer-tries-to-publish-certify-or-automate","content":"A viewer tries to publish, certify or automate"},"44":{"id":"/docs/access-rights/denied-screens-22","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#nexgraph","content":"NexGraph"},"45":{"id":"/docs/access-rights/denied-screens-23","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#an-administrator-opens-graph-studio-without-a-project-relation","content":"An administrator opens Graph Studio without a Project relation"},"46":{"id":"/docs/access-rights/denied-screens-24","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#the-same-administrator-on-sources","content":"The same administrator on Sources"},"47":{"id":"/docs/access-rights/denied-screens-25","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#a-person-tries-to-verify-what-a-model-wrote","content":"A person tries to verify what a model wrote"},"48":{"id":"/docs/access-rights/denied-screens-26","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#the-evidence-behind-a-claim-moved-out-of-reach","content":"The evidence behind a claim moved out of reach"},"49":{"id":"/docs/access-rights/denied-screens-27","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#in-the-api","content":"In the API"},"50":{"id":"/docs/access-rights/denied-screens-28","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#the-reason-codes","content":"The reason codes"},"51":{"id":"/docs/access-rights/denied-screens-29","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#the-modules--nexmap-nexcare-nexforge","content":"The modules — NexMap, NexCare, NexForge"},"52":{"id":"/docs/access-rights/denied-screens-30","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#a-module-the-organization-has-not-enabled","content":"A module the organization has not enabled"},"53":{"id":"/docs/access-rights/denied-screens-31","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#an-administrator-without-a-project-relation-1","content":"An administrator without a Project relation"},"54":{"id":"/docs/access-rights/denied-screens-32","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#a-viewer-in-nexforge","content":"A viewer in NexForge"},"55":{"id":"/docs/access-rights/denied-screens-33","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#an-agent-tries-to-apply-delete-publish-or-join","content":"An agent tries to apply, delete, publish or join"},"56":{"id":"/docs/access-rights/denied-screens-34","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#a-customer-from-a-page-that-is-not-allowed","content":"A customer from a page that is not allowed"},"57":{"id":"/docs/access-rights/denied-screens-35","page_id":"/docs/access-rights/denied-screens","type":"heading","tags":[],"url":"/docs/access-rights/denied-screens#voice-refused","content":"Voice refused"},"58":{"id":"/docs/access-rights/denied-screens-36","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"Nexi refuses in four different voices, and each one tells you something different:"},"59":{"id":"/docs/access-rights/denied-screens-37","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"Voice"},"60":{"id":"/docs/access-rights/denied-screens-38","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"What it means"},"61":{"id":"/docs/access-rights/denied-screens-39","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"What to do"},"62":{"id":"/docs/access-rights/denied-screens-40","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"**A statement where the content would be** — &#x2A;Your access does not allow this. …*"},"63":{"id":"/docs/access-rights/denied-screens-41","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"You are known and this screen is for another role."},"64":{"id":"/docs/access-rights/denied-screens-42","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"Read the role it names; ask an administrator."},"65":{"id":"/docs/access-rights/denied-screens-43","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"**A red note under a form** you were allowed to open"},"66":{"id":"/docs/access-rights/denied-screens-44","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"The screen is shared; the *write* is not yours to make."},"67":{"id":"/docs/access-rights/denied-screens-45","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"Same — the note names the role."},"68":{"id":"/docs/access-rights/denied-screens-46","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"**A greyed row with a reason**"},"69":{"id":"/docs/access-rights/denied-screens-47","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"The thing exists here but is switched off for this Project, this classification or this kind of caller."},"70":{"id":"/docs/access-rights/denied-screens-48","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"Ask a Project owner or an administrator to enable it; nothing is broken."},"71":{"id":"/docs/access-rights/denied-screens-49","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"**Not found**"},"72":{"id":"/docs/access-rights/denied-screens-50","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"It is outside your organization or above your clearance — Nexi does not confirm it exists."},"73":{"id":"/docs/access-rights/denied-screens-51","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"Check you are in the right organization; ask the owner to add you."},"74":{"id":"/docs/access-rights/denied-screens-52","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens","content":"Every refusal is also written to the organization's audit log as a **Deny** row with a reason code — the same codes\nlisted at the end of this page. Screens below are the real ones, taken from the fixture\norganizations *Mission A* and *Northwind Traders*."},"75":{"id":"/docs/access-rights/denied-screens-53","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-tool-you-may-not-bind","content":"In **Agent Studio › Tools › Add a tool**, a tool that exists but is not available *here* stays in the list with a\ngrey **Add** and the reason in its tags — *Disabled in this Project*, *No healthy connection*, or a classification\nceiling lower than the Project's."},"76":{"id":"/docs/access-rights/denied-screens-54","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-tool-you-may-not-bind","content":"**Reason codes:** `TOOL_DISABLED` (an administrator has not enabled it, or disabled it for this Project) ·\n`POLICY_TOOL_NOT_ENTITLED` (the Blueprint does not allow it) · `TOOL_BUILDER_ONLY` (raw `http.request` /\n`mcp.invoke` — never for business users or agents)."},"77":{"id":"/docs/access-rights/denied-screens-55","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-tool-you-may-not-bind","content":"**Who can move it:** an organization administrator, in *NexCore › Tools* (enable, posture) or *Blueprints*\n(ceilings). See Give the agent Tools."},"78":{"id":"/docs/access-rights/denied-screens-56","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-skill-you-may-read-but-not-edit","content":"Platform skills open in the Skill Studio read-only: every field greyed, no **Save** row, the header says *Platform\nskill · read-only*."},"79":{"id":"/docs/access-rights/denied-screens-57","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-skill-you-may-read-but-not-edit","content":"**Reason:** not a denial at all — it is the resource's *state*: platform skills are owned by the pack, not by the\nProject. Copy the skill into the Project to change it."},"80":{"id":"/docs/access-rights/denied-screens-58","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-run-you-may-watch-but-not-decide","content":"An approval card in a chat shows the same steps to everyone in the Project — but the **Approve / Reject** buttons only\nto the people who may decide. Everyone else sees *Waiting for approval · Waiting for a Project owner*."},"81":{"id":"/docs/access-rights/denied-screens-59","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-run-you-may-watch-but-not-decide","content":"**Reason codes:** `NOT_DECIDER` (you hold no deciding relation in this Project) · `SELF_APPROVAL` (you requested it\n— nobody approves their own side effect) · `AUTHOR_NOT_HUMAN` (an agent or a service tried to decide)."},"82":{"id":"/docs/access-rights/denied-screens-60","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-run-you-may-watch-but-not-decide","content":"**Who can move it:** the Project owner, by giving you the relation the card names\n(who may decide an approval)."},"83":{"id":"/docs/access-rights/denied-screens-61","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-answer-you-are-not-allowed-to-have","content":"Two lines you may meet in a chat. If your clearance is below the Project's classification, the turn is refused\nbefore it starts: &#x2A;Your access level does not cover this Project's data classification.* If a tool the agent wanted\nis not allowed for you, the answer still arrives, with a note: &#x2A;Some information was not included because your\ncurrent access does not allow it.* — Nexi never silently pretends the tool ran. The upper bounds an agent works\nunder are visible on its **Permissions** tab:"},"84":{"id":"/docs/access-rights/denied-screens-62","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-answer-you-are-not-allowed-to-have","content":"**Reason codes:** `CLEARANCE_INSUFFICIENT` (your clearance is below the Project) · `POLICY_MODEL_NOT_ENTITLED`\n(the model is not entitled at this classification) · `AGENT_NOT_DELEGATED` (the agent acts for nobody — it has no\nhuman behind the turn)."},"85":{"id":"/docs/access-rights/denied-screens-63","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-answer-you-are-not-allowed-to-have","content":"**Who can move it:** an administrator, by changing the Project's classification, the model entitlement, or your\nclearance. The agent's own tab can only *lower* the bound."},"86":{"id":"/docs/access-rights/denied-screens-64","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#not-found","content":"A Project, thread, file or approval outside your organization — or one you were removed from — opens on the\nplatform's *Not found* page, is absent from the Project switcher, and never appears in **Search**. Nexi does not\ndistinguish *does not exist* from *not yours*: that difference would itself be information."},"87":{"id":"/docs/access-rights/denied-screens-65","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#not-found","content":"**Reason codes** (in the audit log only — the screen says nothing): `CROSS_TENANT_DENIED` ·\n`RELATION_MISSING`."},"88":{"id":"/docs/access-rights/denied-screens-66","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#not-found","content":"**Who can move it:** the Project owner (add you as a member) or, across organizations, nobody."},"89":{"id":"/docs/access-rights/denied-screens-67","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-organization-wide-screens","content":"**Executions**, **Audit**, **Connections**, **Blueprints**, **People › Requests** and every *write* on **Models** are\nfor the Owner and Admin of the organization. A member who opens one gets the screen's frame and a statement in\nplace of its content:"},"90":{"id":"/docs/access-rights/denied-screens-68","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-organization-wide-screens","content":"**Reason code:** `NOT_AN_ADMINISTRATOR`."},"91":{"id":"/docs/access-rights/denied-screens-69","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-organization-wide-screens","content":"**Who can move it:** an Owner, by giving you the *Admin* preset in *People*. Project owners do **not** need it:\ntheir runs are on the Project's own **Runs** tab."},"92":{"id":"/docs/access-rights/denied-screens-70","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-form-that-opens-for-everyone-and-refuses-on-submit","content":"The **Add model** panel is drawn for every member; the refusal arrives when a non-administrator presses **Register**,\nin red, under the form, naming the roles that may:"},"93":{"id":"/docs/access-rights/denied-screens-71","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-form-that-opens-for-everyone-and-refuses-on-submit","content":"**Reason code:** `NOT_AN_ADMINISTRATOR` — the same wall, met one step later."},"94":{"id":"/docs/access-rights/denied-screens-72","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-section-that-is-simply-not-there","content":"Some screens do not refuse; they omit. **People** as a member has no *Requests* and no *Invitations* section — join\nrequests and invitations are administrators' business. (This build still draws an **Invite** button; the server\nrefuses it — a known gap.)"},"95":{"id":"/docs/access-rights/denied-screens-73","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#refused-before-you-are-in","content":"A join request to an organization that does not accept your e-mail domain is refused on the form, with the way in:\n*ask an administrator for an invitation*."},"96":{"id":"/docs/access-rights/denied-screens-74","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#signed-out-from-elsewhere","content":"If you (or an administrator) revoke a session from **Account › Sessions**, the next request from that browser lands\non the sign-in card with the reason: &#x2A;This session was signed out from another device.*"},"97":{"id":"/docs/access-rights/denied-screens-75","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#signed-out-from-elsewhere","content":"**Reason code:** `SESSION_REVOKED` (API: `401`)."},"98":{"id":"/docs/access-rights/denied-screens-76","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#where-every-refusal-ends-up","content":"Each refusal above is a **Deny** row in *NexCore › Audit*, with the actor, the resource, the reason code and a\ncorrelation id you can quote when you ask for help:"},"99":{"id":"/docs/access-rights/denied-screens-77","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#where-every-refusal-ends-up","content":"Filtering the log to *Deny* is the fastest way for an administrator to see who hit which wall today\n(Read the audit trail of a run)."},"100":{"id":"/docs/access-rights/denied-screens-78","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#vibeban-nextasks","content":"Approvals still appear as the cards in NexChat shown above, with the same codes (`NOT_DECIDER`, `SELF_APPROVAL`,\n`AUTHOR_NOT_HUMAN`) returned as `403` by the Tasks API. The work-management screens add\ntwo walls of their own."},"101":{"id":"/docs/access-rights/denied-screens-79","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-administrator-without-a-project-relation","content":"**Who:** an Organization Admin who is not `owner`, `editor`, `viewer` or `agent_member` of the work project."},"102":{"id":"/docs/access-rights/denied-screens-80","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-administrator-without-a-project-relation","content":"**What you see:** the project row with the chip **Content hidden** and its id in place of a name; health, progress\nand the counts *Open · Blocked · Overdue* stay. Opening the project answers &#x2A;You have no relation to this project. A\nproject owner grants viewer, editor or owner in NexCore.*"},"103":{"id":"/docs/access-rights/denied-screens-81","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-administrator-without-a-project-relation","content":"**Reason code:** `content_visible = false` on the row; on the project itself `NO_PROJECT_RELATION` — the API answers\n`404` for anything under `/tasks/projects/{id}` so an id never proves the project exists."},"104":{"id":"/docs/access-rights/denied-screens-82","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-administrator-without-a-project-relation","content":"**What to do:** a project owner adds you — only if you need to *read* the work; administering the organization needs\nnothing more."},"105":{"id":"/docs/access-rights/denied-screens-83","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-viewer-tries-to-create-or-move-an-item","content":"**Who:** a project `viewer`."},"106":{"id":"/docs/access-rights/denied-screens-84","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-viewer-tries-to-create-or-move-an-item","content":"**What you see:** the board is readable; **New item** and drag are absent, and an attempt answers the toast\n&#x2A;Requires work\\_item.create on this project — ask a project owner.* Every card carries the `allowed_actions[]` the\nserver decided for you; the board never authorises in the browser."},"107":{"id":"/docs/access-rights/denied-screens-85","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-viewer-tries-to-create-or-move-an-item","content":"**Reason code:** `PEP_DENIED` (`403`) with the action name; a classification above the project's ceiling is\n`CLASSIFICATION_CEILING`."},"108":{"id":"/docs/access-rights/denied-screens-86","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-agent-tries-a-human-only-action","content":"No screen — the refusal never reaches a person's screen because an agent cannot open one. Starting or completing an\niteration, setting a milestone's status, verifying an acceptance criterion, deciding an approval, sharing or archiving a\nproject, importing references and binding an automation answer `403 AUTHOR_NOT_HUMAN` to any agent or service\nprincipal, before OpenFGA is even asked. A move to *Done* with unverified criteria answers `422 ACCEPTANCE_OPEN`\nunless a person supplies an override reason."},"109":{"id":"/docs/access-rights/denied-screens-87","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#nexbi","content":"NexBI applies *administering is not reading* to numbers, and adds a wall no other application has: a block you may\nnot see keeps its place."},"110":{"id":"/docs/access-rights/denied-screens-88","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-administrator-opens-a-dashboard-without-a-project-relation","content":"**Who:** an Organization Admin with no relation in the Project."},"111":{"id":"/docs/access-rights/denied-screens-89","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-administrator-opens-a-dashboard-without-a-project-relation","content":"**What you see:** the header shows the dashboard's **id, not its title**; the body reads &#x2A;Not found — This object\ndoes not exist in your allowed data.* The Overview for the same person shows counts only, with the notice\n&#x2A;Administering is not reading — you have no Project relation here. Counts and ids stay visible; dashboards, data\nand metrics do not.*"},"112":{"id":"/docs/access-rights/denied-screens-90","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-administrator-opens-a-dashboard-without-a-project-relation","content":"**Reason code:** `NO_PROJECT_RELATION` on screen; on the API a `404`."},"113":{"id":"/docs/access-rights/denied-screens-91","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-administrator-opens-a-dashboard-without-a-project-relation","content":"**What to do:** ask a Project owner — &#x2A;You have no relation to this Project's data. Ask a Project owner if you need\nit.*"},"114":{"id":"/docs/access-rights/denied-screens-92","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-viewer-whose-clearance-is-below-a-blocks-data","content":"**Who:** a Project viewer whose classification clearance is below one metric's dataset."},"115":{"id":"/docs/access-rights/denied-screens-93","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-viewer-whose-clearance-is-below-a-blocks-data","content":"**What you see:** the banner *1 block hidden by policy*; the KPI **keeps its place** and reads *Not available to you\n— The data sits above your clearance*; every other block is computed for you, with the row policy applied before\naggregation — so your total may differ from your colleague's, by design."},"116":{"id":"/docs/access-rights/denied-screens-94","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-viewer-whose-clearance-is-below-a-blocks-data","content":"**Reason code:** `CLASSIFICATION_CEILING` per block; the query record names the policy that applied."},"117":{"id":"/docs/access-rights/denied-screens-95","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-viewer-tries-to-publish-certify-or-automate","content":"No screen: **Publish**, **Certify**, **New automation** and **Stop serving** are absent for a viewer, and the API\nanswers `403 PEP_DENIED` (`dashboard.publish`, `metric.certify`, `automation.create`, `dataset.revoke_ack`). Publishing\nand certification are also **human-only** — a service or agent principal receives `403 AUTHOR_NOT_HUMAN`. A dashboard\nblock that carries a spec copy instead of a reference is refused with `422 SPEC_COPY_REJECTED` regardless of rights."},"118":{"id":"/docs/access-rights/denied-screens-96","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#nexgraph","content":"NexGraph draws the *administering is not reading* rule more visibly than any other application, because an\nOrganization Admin has legitimate work there — bindings, grants, run health — without any right to the knowledge\nitself."},"119":{"id":"/docs/access-rights/denied-screens-97","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-administrator-opens-graph-studio-without-a-project-relation","content":"**Who:** an Organization Admin with no relation in the Project."},"120":{"id":"/docs/access-rights/denied-screens-98","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-administrator-opens-graph-studio-without-a-project-relation","content":"**What you see:** the stage is replaced by &#x2A;Your access does not allow this — Administering is not reading — you\nhave no Project relation here. Bindings, grants and run health stay available under Sources and Processing.* The\nsame notice replaces the Overview's knowledge pulse and the Evidence Workspace."},"121":{"id":"/docs/access-rights/denied-screens-99","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-administrator-opens-graph-studio-without-a-project-relation","content":"**Reason code:** `NO_PROJECT_RELATION` — surfaced to the screen as this notice; on the API the object is a `404`, so\nan id never proves a Project exists."},"122":{"id":"/docs/access-rights/denied-screens-100","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-administrator-opens-graph-studio-without-a-project-relation","content":"**What to do:** ask a Project owner to add you — and only if you need to *read* its knowledge; administering it\nneeds nothing more."},"123":{"id":"/docs/access-rights/denied-screens-101","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-same-administrator-on-sources","content":"**What you see:** the bindings by id and kind — *BND-021 · operational metadata* — with their five states, the\nbackground grant and the *Pause* · *Revoke* operations; no document names, no counts of knowledge, no content, and\n*Add source* disabled. The footnote says why."},"124":{"id":"/docs/access-rights/denied-screens-102","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-same-administrator-on-sources","content":"**Reason code:** none — this is an *allow* for the operational actions and the operational projection of the\nrows; the content columns are simply not part of the answer."},"125":{"id":"/docs/access-rights/denied-screens-103","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-person-tries-to-verify-what-a-model-wrote","content":"**Who:** anyone whose relation is viewer or operator, and every agent or service."},"126":{"id":"/docs/access-rights/denied-screens-104","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-person-tries-to-verify-what-a-model-wrote","content":"**What you see:** *Verify* disabled with *Requires verify\\_claim*; on the API `403 NOT_EDITOR` for the person,\n`403 AUTHOR_NOT_HUMAN` for an agent or a service — even one acting for a curator."},"127":{"id":"/docs/access-rights/denied-screens-105","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-person-tries-to-verify-what-a-model-wrote","content":"**What to do:** a person with the editor relation verifies within a named scope, or returns the claim for\nclarification. Nothing else writes *verified*."},"128":{"id":"/docs/access-rights/denied-screens-106","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-evidence-behind-a-claim-moved-out-of-reach","content":"**Who:** a person whose clearance or Project relation changed after a claim was shown to them."},"129":{"id":"/docs/access-rights/denied-screens-107","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-evidence-behind-a-claim-moved-out-of-reach","content":"**What you see:** the claim card stays; the Evidence Workspace shows &#x2A;Evidence unavailable — Access to the source\nchanged. The claim card stays; the page is not rendered and no cached text appears.*"},"130":{"id":"/docs/access-rights/denied-screens-108","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-evidence-behind-a-claim-moved-out-of-reach","content":"**Reason code:** `404 NOT_FOUND` on the page render and on the item text — the same answer as for a source that\nnever existed."},"131":{"id":"/docs/access-rights/denied-screens-109","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"A script meets the same walls as HTTP status codes. Every body carries a `correlation_id` (what an administrator\nfinds in Audit) and a `user_message_key` (the line the applications show). A **policy** refusal is the Policy\nEnforcement Point's own answer — `decision: \"deny\"` with a `reason_code` from the table below; every other error\nnames itself in `error_code`."},"132":{"id":"/docs/access-rights/denied-screens-110","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"Status"},"133":{"id":"/docs/access-rights/denied-screens-111","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"Code"},"134":{"id":"/docs/access-rights/denied-screens-112","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"Meaning"},"135":{"id":"/docs/access-rights/denied-screens-113","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"`401`"},"136":{"id":"/docs/access-rights/denied-screens-114","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"`UNAUTHENTICATED` · `SESSION_REQUIRED` · `SESSION_REVOKED`"},"137":{"id":"/docs/access-rights/denied-screens-115","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"Nexi does not know who is calling — authenticate."},"138":{"id":"/docs/access-rights/denied-screens-116","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"`403`"},"139":{"id":"/docs/access-rights/denied-screens-117","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"`decision: \"deny\"` + `reason_code` (below), or `error_code: \"FORBIDDEN\"`"},"140":{"id":"/docs/access-rights/denied-screens-118","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"Known, and not allowed this action on this resource."},"141":{"id":"/docs/access-rights/denied-screens-119","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"`404`"},"142":{"id":"/docs/access-rights/denied-screens-120","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"`NOT_FOUND`"},"143":{"id":"/docs/access-rights/denied-screens-121","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"Not yours, or nowhere — deliberately the same answer."},"144":{"id":"/docs/access-rights/denied-screens-122","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"`409`"},"145":{"id":"/docs/access-rights/denied-screens-123","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"`TOOL_DISABLED` · `FLOW_NOT_PUBLISHED` · version conflicts"},"146":{"id":"/docs/access-rights/denied-screens-124","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"The resource's *state* refuses, not your rights."},"147":{"id":"/docs/access-rights/denied-screens-125","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"`422`"},"148":{"id":"/docs/access-rights/denied-screens-126","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"`TOOL_POLICY_CEILING` (`TOOL_BUILDER_ONLY`) · `POLICY_WIDENS`"},"149":{"id":"/docs/access-rights/denied-screens-127","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"The request asks for something the platform ceiling never allows — or, in NexGraph, a capture policy that would widen a tier."},"150":{"id":"/docs/access-rights/denied-screens-128","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"`503`"},"151":{"id":"/docs/access-rights/denied-screens-129","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"`POLICY_UNAVAILABLE`"},"152":{"id":"/docs/access-rights/denied-screens-130","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#in-the-api","content":"The policy engine or its signed bundle is not available: Nexi fails closed and refuses every protected operation rather than guessing."},"153":{"id":"/docs/access-rights/denied-screens-131","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"Code"},"154":{"id":"/docs/access-rights/denied-screens-132","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"Which check"},"155":{"id":"/docs/access-rights/denied-screens-133","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"Plain words"},"156":{"id":"/docs/access-rights/denied-screens-134","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"`CROSS_TENANT_DENIED` · `CROSS_ENTERPRISE_DENIED`"},"157":{"id":"/docs/access-rights/denied-screens-135","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"organization"},"158":{"id":"/docs/access-rights/denied-screens-136","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"The resource belongs to another organization. Shown as *Not found*."},"159":{"id":"/docs/access-rights/denied-screens-137","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"`CLEARANCE_INSUFFICIENT`"},"160":{"id":"/docs/access-rights/denied-screens-138","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"clearance"},"161":{"id":"/docs/access-rights/denied-screens-139","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"Your clearance is below the resource's classification."},"162":{"id":"/docs/access-rights/denied-screens-140","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"`AUTHOR_NOT_HUMAN` · `ACTOR_NOT_HUMAN`"},"163":{"id":"/docs/access-rights/denied-screens-141","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"identity kind"},"164":{"id":"/docs/access-rights/denied-screens-142","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"An agent or a service tried to do something only a person may — create, publish, decide."},"165":{"id":"/docs/access-rights/denied-screens-143","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"`AGENT_NOT_DELEGATED` · `POLICY_TOOL_AGENT_NOT_DELEGATED`"},"166":{"id":"/docs/access-rights/denied-screens-144","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"identity kind"},"167":{"id":"/docs/access-rights/denied-screens-145","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"The agent has no human behind this turn, or the tool is not delegated to it."},"168":{"id":"/docs/access-rights/denied-screens-146","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"`RELATION_MISSING`"},"169":{"id":"/docs/access-rights/denied-screens-147","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"relation"},"170":{"id":"/docs/access-rights/denied-screens-148","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"You hold no relation in this Project that allows the action."},"171":{"id":"/docs/access-rights/denied-screens-149","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"`NOT_DECIDER` · `SELF_APPROVAL`"},"172":{"id":"/docs/access-rights/denied-screens-150","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"relation"},"173":{"id":"/docs/access-rights/denied-screens-151","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"You may not decide this approval — no deciding relation, or it is your own request."},"174":{"id":"/docs/access-rights/denied-screens-152","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"`NOT_AN_ADMINISTRATOR`"},"175":{"id":"/docs/access-rights/denied-screens-153","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"role"},"176":{"id":"/docs/access-rights/denied-screens-154","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"The action is for the organization's Owner or Admin."},"177":{"id":"/docs/access-rights/denied-screens-155","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"`PURPOSE_REQUIRED`"},"178":{"id":"/docs/access-rights/denied-screens-156","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"purpose"},"179":{"id":"/docs/access-rights/denied-screens-157","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"The action needs a stated purpose and none was given."},"180":{"id":"/docs/access-rights/denied-screens-158","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"`POLICY_MODEL_NOT_ENTITLED` · `POLICY_TOOL_NOT_ENTITLED`"},"181":{"id":"/docs/access-rights/denied-screens-159","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"Blueprint"},"182":{"id":"/docs/access-rights/denied-screens-160","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"The model or tool is not entitled for this classification or Project."},"183":{"id":"/docs/access-rights/denied-screens-161","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"`POLICY_CONNECTION_NOT_OWNED` · `CONNECTION_ADMINISTER_DENIED` · `CREDENTIAL_READ_DENIED`"},"184":{"id":"/docs/access-rights/denied-screens-162","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"Blueprint / role"},"185":{"id":"/docs/access-rights/denied-screens-163","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"The connection or credential is not yours to use or administer."},"186":{"id":"/docs/access-rights/denied-screens-164","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"`TOOL_DISABLED` · `TOOL_BUILDER_ONLY`"},"187":{"id":"/docs/access-rights/denied-screens-165","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"state / ceiling"},"188":{"id":"/docs/access-rights/denied-screens-166","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"The tool is switched off here, or is a raw builder tool that is never exposed to users or agents."},"189":{"id":"/docs/access-rights/denied-screens-167","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"`SESSION_REQUIRED` · `SESSION_REVOKED` · `UNAUTHENTICATED`"},"190":{"id":"/docs/access-rights/denied-screens-168","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"authentication"},"191":{"id":"/docs/access-rights/denied-screens-169","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"No valid session or token reached the server."},"192":{"id":"/docs/access-rights/denied-screens-170","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-reason-codes","content":"The order in which these checks run — and why *organization* comes first — is drawn in\nHow Nexi decides what you may do."},"193":{"id":"/docs/access-rights/denied-screens-171","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#the-modules--nexmap-nexcare-nexforge","content":"A module adds one refusal of its own before all the others: the **module gate**."},"194":{"id":"/docs/access-rights/denied-screens-172","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-module-the-organization-has-not-enabled","content":"**Who:** anyone who follows a link to `/map`, `/care` or `/forge` in an organization that has not installed the\npack — or whose core-api could not be reached when the module asked."},"195":{"id":"/docs/access-rights/denied-screens-173","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-module-the-organization-has-not-enabled","content":"**What you see:** one quiet state in place of the application — &#x2A;NexMap is not enabled for your organization — An\nOrganization Owner adds the Map module from Core › Blueprints & Packs. Until then this link shows nothing.* /\n*NexCare isn't enabled for this organization* / &#x2A;NexForge is not enabled here — The Creative Studio module is not\npart of this workspace's Blueprint.* — each with **Open Blueprints & Packs**. The App Launcher shows **no tile** for a\nmodule that is off; never a greyed one."},"196":{"id":"/docs/access-rights/denied-screens-174","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-module-the-organization-has-not-enabled","content":"**Reason code:** `MODULE_NOT_ENABLED` (or `MODULE_DISABLED_BY_PROJECT`, `MODULE_FORBIDDEN_BY_POLICY`); when the\ngate could not ask, `MODULE_STATE_UNKNOWN` — an uncertain gate is a closed gate, there is no base floor."},"197":{"id":"/docs/access-rights/denied-screens-175","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-module-the-organization-has-not-enabled","content":"**What to do:** an Owner or Admin installs the pack — Install a module.\nNothing else helps; a relation in a Project does not open a module the organization did not enable."},"198":{"id":"/docs/access-rights/denied-screens-176","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-administrator-without-a-project-relation-1","content":"**Who:** an Organization Admin who installed the module and opens it."},"199":{"id":"/docs/access-rights/denied-screens-177","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-administrator-without-a-project-relation-1","content":"**What you see:** NexMap: &#x2A;Your access does not allow this — You have no relation to this Project's data. Ask a\nProject owner if you need it. Administering is not reading.* NexForge: &#x2A;You do not have access to this scene. Ask the\nscene owner or your project admin for a project relation.* NexCare: the Care Project's desk is not listed."},"200":{"id":"/docs/access-rights/denied-screens-178","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-administrator-without-a-project-relation-1","content":"**Reason code:** `NO_PROJECT_RELATION` — identical to the suite's."},"201":{"id":"/docs/access-rights/denied-screens-179","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-viewer-in-nexforge","content":"**What you see:** the scene opens; there is no palette, no element bar, no inline editor; the composer reads *You can\nask about this scene, but not change it*. Nothing is greyed — the controls are absent."},"202":{"id":"/docs/access-rights/denied-screens-180","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-viewer-in-nexforge","content":"**Reason code:** none on the screen; on the API `403 FORBIDDEN` for `forge.scene.edit`."},"203":{"id":"/docs/access-rights/denied-screens-181","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-agent-tries-to-apply-delete-publish-or-join","content":"**Who:** the Scene Agent, the Care assistant, or any service identity."},"204":{"id":"/docs/access-rights/denied-screens-182","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-agent-tries-to-apply-delete-publish-or-join","content":"**What you see:** nothing — these doors are not offered to agents. On the API: `403 AUTHOR_NOT_HUMAN`."},"205":{"id":"/docs/access-rights/denied-screens-183","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#an-agent-tries-to-apply-delete-publish-or-join","content":"**Why:** AI proposes, the person applies (NexForge); exactly one human or the assistant holds a conversation and\nonly a person Joins (NexCare); uploads and views are authored by people (NexMap)."},"206":{"id":"/docs/access-rights/denied-screens-184","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-customer-from-a-page-that-is-not-allowed","content":"**Who:** a visitor whose page embeds the Care widget from an origin the installation does not list."},"207":{"id":"/docs/access-rights/denied-screens-185","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-customer-from-a-page-that-is-not-allowed","content":"**What you see:** the launcher appears (the script is public) but the panel reads *Nova is offline right now* —\nno session is minted."},"208":{"id":"/docs/access-rights/denied-screens-186","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#a-customer-from-a-page-that-is-not-allowed","content":"**Reason code:** `403 ORIGIN_NOT_ALLOWED` on `POST /care/public/v1/sessions` — the same answer for every\nmismatch, so nothing can be enumerated; the frame also refuses to render under a foreign `frame-ancestors`."},"209":{"id":"/docs/access-rights/denied-screens-187","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#voice-refused","content":"**Who:** anyone whose thread's classification has no eligible speech route, or whose browser blocked the microphone."},"210":{"id":"/docs/access-rights/denied-screens-188","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#voice-refused","content":"**What you see:** &#x2A;Voice isn't available for this conversation's classification — type instead.* /\n&#x2A;Microphone access is blocked — allow it for this site in the browser and try again.*; in NexForge &#x2A;Voice is not\nconfigured for this workspace — text still works.*"},"211":{"id":"/docs/access-rights/denied-screens-189","page_id":"/docs/access-rights/denied-screens","tags":[],"type":"text","url":"/docs/access-rights/denied-screens#voice-refused","content":"**Reason code:** `MODEL_UNAVAILABLE_USER_RIGHTS` from the Gateway — decided for the **person's** actor context,\nnot the service's. Voice never adds a right, and a level-4 action (an access change) never completes by a spoken yes:\n&#x2A;Confirm on screen to continue.*"},"212":{"id":"/docs/access-rights/how-access-is-decided","page_id":"/docs/access-rights/how-access-is-decided","type":"page","content":"How Nexi decides what you may do","breadcrumbs":["Nexi Docs","Access rights"],"tags":[],"url":"/docs/access-rights/how-access-is-decided"},"213":{"id":"/docs/access-rights/how-access-is-decided-0","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided","content":"Four kinds of identity, one organization boundary, five checks in a fixed order, and one rule that surprises administrators — administering an organization is not reading its content. With the screens each answer produces."},"214":{"id":"/docs/access-rights/how-access-is-decided-1","page_id":"/docs/access-rights/how-access-is-decided","type":"heading","tags":[],"url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"Four kinds of identity"},"215":{"id":"/docs/access-rights/how-access-is-decided-2","page_id":"/docs/access-rights/how-access-is-decided","type":"heading","tags":[],"url":"/docs/access-rights/how-access-is-decided#the-organization-is-the-outer-wall","content":"The organization is the outer wall"},"216":{"id":"/docs/access-rights/how-access-is-decided-3","page_id":"/docs/access-rights/how-access-is-decided","type":"heading","tags":[],"url":"/docs/access-rights/how-access-is-decided#five-checks-in-order","content":"Five checks, in order"},"217":{"id":"/docs/access-rights/how-access-is-decided-4","page_id":"/docs/access-rights/how-access-is-decided","type":"heading","tags":[],"url":"/docs/access-rights/how-access-is-decided#organization-versus-project--the-rule-to-remember","content":"Organization versus Project — the rule to remember"},"218":{"id":"/docs/access-rights/how-access-is-decided-5","page_id":"/docs/access-rights/how-access-is-decided","type":"heading","tags":[],"url":"/docs/access-rights/how-access-is-decided#what-a-denial-looks-like","content":"What a denial looks like"},"219":{"id":"/docs/access-rights/how-access-is-decided-6","page_id":"/docs/access-rights/how-access-is-decided","type":"heading","tags":[],"url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Where this is configured"},"220":{"id":"/docs/access-rights/how-access-is-decided-7","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided","content":"Every request that reaches Nexi — a click in NexChat, a page in Core, a call from a script, a Tool an agent wants\nto use — is answered by the server with one of three things: the result, **403 · you may not**, or **404 · there\nis nothing here**. This page explains how that answer is made, in the order it is made, so that when you see a\ndenied screen you know which wall you hit and who can move it."},"221":{"id":"/docs/access-rights/how-access-is-decided-8","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided","content":"The user interface never decides. It asks, and it shows the answer. A button you can see is not a permission; a\nbutton you cannot see is not a denial — the server would refuse the request either way."},"222":{"id":"/docs/access-rights/how-access-is-decided-9","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"Nexi tells four kinds of actor apart, and several checks below depend on which one is asking."},"223":{"id":"/docs/access-rights/how-access-is-decided-10","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"Identity"},"224":{"id":"/docs/access-rights/how-access-is-decided-11","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"What it is"},"225":{"id":"/docs/access-rights/how-access-is-decided-12","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"What only it may do"},"226":{"id":"/docs/access-rights/how-access-is-decided-13","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"**Person** (human)"},"227":{"id":"/docs/access-rights/how-access-is-decided-14","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"Someone signed in through the organization's identity provider; a session in a browser."},"228":{"id":"/docs/access-rights/how-access-is-decided-15","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"Author agents, skills, tools and flows; decide approvals; read captured prompts and answers; administer."},"229":{"id":"/docs/access-rights/how-access-is-decided-16","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"**Agent**"},"230":{"id":"/docs/access-rights/how-access-is-decided-17","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"A run of an agent acting on a person's behalf inside a Project."},"231":{"id":"/docs/access-rights/how-access-is-decided-18","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"Read and invoke what the delegating person may read and invoke — never more, and never without that person above *Confidential*."},"232":{"id":"/docs/access-rights/how-access-is-decided-19","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"**Service**"},"233":{"id":"/docs/access-rights/how-access-is-decided-20","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"A Nexi component talking to another (chat-api parking a run on tasks-api, core-api publishing a revocation)."},"234":{"id":"/docs/access-rights/how-access-is-decided-21","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"Create approval requests; read any record of its tenant for the platform's own purposes."},"235":{"id":"/docs/access-rights/how-access-is-decided-22","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"**Device**"},"236":{"id":"/docs/access-rights/how-access-is-decided-23","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"A registered device identity (reserved for on-premise deployments)."},"237":{"id":"/docs/access-rights/how-access-is-decided-24","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"—"},"238":{"id":"/docs/access-rights/how-access-is-decided-25","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#four-kinds-of-identity","content":"An agent is not a person with fewer rights; it is a different identity with a person behind it. That is why an\naudit row for a run names the agent *and* the human it acted for, and why an agent can never publish a skill or\napprove its own request (see Roles and relations)."},"239":{"id":"/docs/access-rights/how-access-is-decided-26","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#the-organization-is-the-outer-wall","content":"Everything belongs to exactly one **organization** (the *tenant*): people, Projects, agents, models, connections,\nruns, audit. The first check on every request is whether the actor and the thing asked for belong to the same\norganization. When they do not, the answer is **404** — not 403 — so that an outsider cannot even learn that the\nthing exists. A Project id from another organization, a thread, a file, an approval: *Not found*, every time."},"240":{"id":"/docs/access-rights/how-access-is-decided-27","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#five-checks-in-order","content":"The server runs the same sequence for every protected operation. The first check that fails is the answer."},"241":{"id":"/docs/access-rights/how-access-is-decided-28","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#five-checks-in-order","content":"**Organization.** Actor and resource in the same tenant, or *404*."},"242":{"id":"/docs/access-rights/how-access-is-decided-29","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#five-checks-in-order","content":"**Clearance.** Every person has a **clearance** (*Public · Confidential · DSK · Secret · Top secret*), set by the\nadministrators in People; every Project, file, agent and run has a **classification**. A person reads and acts\nonly at or below their clearance. Olena, with *Secret*, may open a *Confidential* Project; a member cleared to\n*Confidential* never sees a *Secret* one, whatever their role."},"243":{"id":"/docs/access-rights/how-access-is-decided-30","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#five-checks-in-order","content":"**Identity kind.** Some actions are for people only: authoring (agents, skills, tool bindings, flows),\napproving, reading captured payloads, administering an organization. An agent acting above *Confidential* must\nbe able to name the person it acts for."},"244":{"id":"/docs/access-rights/how-access-is-decided-31","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#five-checks-in-order","content":"**Relation.** What ties the actor to the resource — *owner*, *editor*, *viewer*, *operator* of the Project it\nlives in, or *administrator* of the organization — and whether that relation allows this action. The table is in\nRoles and relations."},"245":{"id":"/docs/access-rights/how-access-is-decided-32","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#five-checks-in-order","content":"**Purpose.** Exporting something classified *DSK* or above needs a stated purpose, recorded with the export."},"246":{"id":"/docs/access-rights/how-access-is-decided-33","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#five-checks-in-order","content":"Whatever the outcome, an **audit record** is written: who, what, on which resource, allowed or denied, and why.\nAdministrators read them in Core › Audit; see Read the audit trail of a run."},"247":{"id":"/docs/access-rights/how-access-is-decided-34","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#organization-versus-project--the-rule-to-remember","content":"> **Administering an organization is not reading its content.**"},"248":{"id":"/docs/access-rights/how-access-is-decided-35","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#organization-versus-project--the-rule-to-remember","content":"An Organization Owner or Admin governs every Project: creates and archives them, grants and removes members, sets\nthe policies they inherit, reads every run's *record* in Executions and every governance event in Audit. But the\n**content** of a Project — its threads, files, answers, artifacts — is readable only through a relation *in that\nProject*: owner, editor, viewer, operator. An administrator who is not a member of *Autumn catalogue* sees it in\nCore › Projects, can add themselves as a member (an audited act), and until then does not see a single message in\nit."},"249":{"id":"/docs/access-rights/how-access-is-decided-36","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#organization-versus-project--the-rule-to-remember","content":"The reverse holds too: a Project owner governs their Project fully — members, agents, flows, approvals — and sees\nnothing of the organization's other Projects, nor Executions, nor Audit."},"250":{"id":"/docs/access-rights/how-access-is-decided-37","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#organization-versus-project--the-rule-to-remember","content":"*Where this build stands:* the write side of the rule is fully enforced — an administrator who is not a member\ncannot send a message, change an agent or run a flow in a Project. The read side is not yet closed: the current\npolicy engine still lets an Organization Owner or Admin *open* a Project's threads without a relation of their own.\nIt closes with the authorization engine of the next release; until then, treat administrators as able to read."},"251":{"id":"/docs/access-rights/how-access-is-decided-38","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#organization-versus-project--the-rule-to-remember","content":"Two screens make the rule visible. Kate, an Operator of the organization, opens Core › Projects before anyone has\ngiven her a place in a Project:"},"252":{"id":"/docs/access-rights/how-access-is-decided-39","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#organization-versus-project--the-rule-to-remember","content":"After Olena grants her *viewer* on *Autumn catalogue*, Kate sees exactly that Project — and still not *General*,\nof which she is not a member:"},"253":{"id":"/docs/access-rights/how-access-is-decided-40","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#what-a-denial-looks-like","content":"Nexi distinguishes *you may not* from *there is nothing here*, and its screens say which."},"254":{"id":"/docs/access-rights/how-access-is-decided-41","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#what-a-denial-looks-like","content":"**Not an administrator.** Core's organization-wide screens — People › Requests, Models (writes), Connections,\nExecutions, Audit, Blueprints — answer a member with a statement, not an empty list:"},"255":{"id":"/docs/access-rights/how-access-is-decided-42","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#what-a-denial-looks-like","content":"**Refused write.** A form may open for everyone and be refused on submit; the refusal is written where it\nhappened and explains the role that would be allowed:"},"256":{"id":"/docs/access-rights/how-access-is-decided-43","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#what-a-denial-looks-like","content":"**Not found.** A thread, file, Project or approval outside your organization, or above your clearance, is *Not\nfound* — NexChat's Project switcher does not list it, and its URL opens on the platform's 404. Nothing tells you\nwhether it exists."},"257":{"id":"/docs/access-rights/how-access-is-decided-44","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#what-a-denial-looks-like","content":"**Waiting for someone else.** An approval you may *see* but may not *decide* shows the card without buttons and\nnames who can — you are in the Project, you are not a decider:"},"258":{"id":"/docs/access-rights/how-access-is-decided-45","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"You want to…"},"259":{"id":"/docs/access-rights/how-access-is-decided-46","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Where"},"260":{"id":"/docs/access-rights/how-access-is-decided-47","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Who"},"261":{"id":"/docs/access-rights/how-access-is-decided-48","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Give someone a role in the organization"},"262":{"id":"/docs/access-rights/how-access-is-decided-49","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Core › People (invite, or edit the person)"},"263":{"id":"/docs/access-rights/how-access-is-decided-50","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Organization Owner · Admin"},"264":{"id":"/docs/access-rights/how-access-is-decided-51","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Set a person's clearance"},"265":{"id":"/docs/access-rights/how-access-is-decided-52","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Core › People › Invite — the clearance is chosen with the role and travels with the invitation"},"266":{"id":"/docs/access-rights/how-access-is-decided-53","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Organization Owner · Admin"},"267":{"id":"/docs/access-rights/how-access-is-decided-54","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Put someone in a Project (owner · editor · viewer · operator)"},"268":{"id":"/docs/access-rights/how-access-is-decided-55","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Core › Projects › Members — in this build through `POST /chat/projects/{id}/members`, see Create a Project and give people a place in it"},"269":{"id":"/docs/access-rights/how-access-is-decided-56","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Project owner · Organization Admin"},"270":{"id":"/docs/access-rights/how-access-is-decided-57","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Decide what cloud models, tools and sharing a Project may use"},"271":{"id":"/docs/access-rights/how-access-is-decided-58","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Core › Blueprints & Packs (organization layer) and Core › Projects › Governance (tighten only)"},"272":{"id":"/docs/access-rights/how-access-is-decided-59","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Organization Owner · Admin"},"273":{"id":"/docs/access-rights/how-access-is-decided-60","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"See every decision that was made"},"274":{"id":"/docs/access-rights/how-access-is-decided-61","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Core › Audit"},"275":{"id":"/docs/access-rights/how-access-is-decided-62","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Organization Owner · Admin"},"276":{"id":"/docs/access-rights/how-access-is-decided-63","page_id":"/docs/access-rights/how-access-is-decided","tags":[],"type":"text","url":"/docs/access-rights/how-access-is-decided#where-this-is-configured","content":"Continue with Roles in an organization, relations in a Project."},"277":{"id":"/docs/access-rights/roles-and-relations","page_id":"/docs/access-rights/roles-and-relations","type":"page","content":"Roles in an organization, relations in a Project","breadcrumbs":["Nexi Docs","Access rights"],"tags":[],"url":"/docs/access-rights/roles-and-relations"},"278":{"id":"/docs/access-rights/roles-and-relations-0","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations","content":"The roles Core lets you give a person, what each one really unlocks today, the four relations a person can hold in a Project and the action table they map to, who may decide an approval, and why an agent is never a decider."},"279":{"id":"/docs/access-rights/roles-and-relations-1","page_id":"/docs/access-rights/roles-and-relations","type":"heading","tags":[],"url":"/docs/access-rights/roles-and-relations#organization-roles","content":"Organization roles"},"280":{"id":"/docs/access-rights/roles-and-relations-2","page_id":"/docs/access-rights/roles-and-relations","type":"heading","tags":[],"url":"/docs/access-rights/roles-and-relations#project-relations","content":"Project relations"},"281":{"id":"/docs/access-rights/roles-and-relations-3","page_id":"/docs/access-rights/roles-and-relations","type":"heading","tags":[],"url":"/docs/access-rights/roles-and-relations#the-same-relations-in-nexgraph","content":"The same relations in NexGraph"},"282":{"id":"/docs/access-rights/roles-and-relations-4","page_id":"/docs/access-rights/roles-and-relations","type":"heading","tags":[],"url":"/docs/access-rights/roles-and-relations#the-same-relations-in-nexbi","content":"The same relations in NexBI"},"283":{"id":"/docs/access-rights/roles-and-relations-5","page_id":"/docs/access-rights/roles-and-relations","type":"heading","tags":[],"url":"/docs/access-rights/roles-and-relations#the-same-relations-in-vibeban","content":"The same relations in VibeBan"},"284":{"id":"/docs/access-rights/roles-and-relations-6","page_id":"/docs/access-rights/roles-and-relations","type":"heading","tags":[],"url":"/docs/access-rights/roles-and-relations#the-same-relations-in-the-modules--nexmap-nexcare-nexforge","content":"The same relations in the modules — NexMap, NexCare, NexForge"},"285":{"id":"/docs/access-rights/roles-and-relations-7","page_id":"/docs/access-rights/roles-and-relations","type":"heading","tags":[],"url":"/docs/access-rights/roles-and-relations#who-may-decide-an-approval","content":"Who may decide an approval"},"286":{"id":"/docs/access-rights/roles-and-relations-8","page_id":"/docs/access-rights/roles-and-relations","type":"heading","tags":[],"url":"/docs/access-rights/roles-and-relations#clearance-and-classification","content":"Clearance and classification"},"287":{"id":"/docs/access-rights/roles-and-relations-9","page_id":"/docs/access-rights/roles-and-relations","type":"heading","tags":[],"url":"/docs/access-rights/roles-and-relations#agents-are-not-people-with-fewer-rights","content":"Agents are not people with fewer rights"},"288":{"id":"/docs/access-rights/roles-and-relations-10","page_id":"/docs/access-rights/roles-and-relations","type":"heading","tags":[],"url":"/docs/access-rights/roles-and-relations#checklist-for-administrators","content":"Checklist for administrators"},"289":{"id":"/docs/access-rights/roles-and-relations-11","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations","content":"Two different things are called \"a role\" in everyday talk, and Nexi keeps them apart:"},"290":{"id":"/docs/access-rights/roles-and-relations-12","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations","content":"an **organization role** — what Core › People gives a person when they are invited: &#x2A;Owner, Admin, Builder,\nMember …*. It says what the person may do **to the organization**."},"291":{"id":"/docs/access-rights/roles-and-relations-13","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations","content":"a **Project relation** — *owner, editor, viewer, operator* — what a person is **inside one Project**. It says what\nthey may do with that Project's threads, files, agents, flows and approvals."},"292":{"id":"/docs/access-rights/roles-and-relations-14","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations","content":"Effective access is the intersection of both with the person's clearance, the Project's classification, and the\nBlueprint's ceilings — never the union. This page lists each side and the table that turns them into *yes* or\n*no*."},"293":{"id":"/docs/access-rights/roles-and-relations-15","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"These are the presets Core offers when you invite or edit a person. The organization's checks group them into\nthree tiers today; the finer presets are recorded on the person and used by the Blueprint's role-based policies\n(for example *Pinning a model id: roles only*)."},"294":{"id":"/docs/access-rights/roles-and-relations-16","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"Role"},"295":{"id":"/docs/access-rights/roles-and-relations-17","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"Tier today"},"296":{"id":"/docs/access-rights/roles-and-relations-18","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"What it unlocks in the organization"},"297":{"id":"/docs/access-rights/roles-and-relations-19","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"**Organization Owner**"},"298":{"id":"/docs/access-rights/roles-and-relations-20","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"administrator"},"299":{"id":"/docs/access-rights/roles-and-relations-21","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"Everything an Admin can, and the organization itself: settings, Blueprint binding, pack installation; the Owner is the one member who cannot be removed. One per organization — the person who created it."},"300":{"id":"/docs/access-rights/roles-and-relations-22","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"**Organization Admin**"},"301":{"id":"/docs/access-rights/roles-and-relations-23","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"administrator"},"302":{"id":"/docs/access-rights/roles-and-relations-24","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"People (invite, approve join requests, roles, clearance, suspend), Projects (every one, by reference), Models and Connections (register, enable, delete), Blueprints & Packs, Executions, Audit, Tools posture. Content of a Project only as a member (see the note above)."},"303":{"id":"/docs/access-rights/roles-and-relations-25","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"**Security Admin**"},"304":{"id":"/docs/access-rights/roles-and-relations-26","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"administrator"},"305":{"id":"/docs/access-rights/roles-and-relations-27","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"Same tier as Admin — the preset for the person who owns policies and audit rather than day-to-day people work."},"306":{"id":"/docs/access-rights/roles-and-relations-28","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"**Auditor**"},"307":{"id":"/docs/access-rights/roles-and-relations-29","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"auditor"},"308":{"id":"/docs/access-rights/roles-and-relations-30","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"Intended for read-only access to the audit trail and Executions *records* — never a Project's content, never payloads. In this build the Audit and Executions screens are still Owner/Admin only, so the preset is recorded but unlocks nothing extra yet."},"309":{"id":"/docs/access-rights/roles-and-relations-31","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"**Capability Admin**"},"310":{"id":"/docs/access-rights/roles-and-relations-32","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"member"},"311":{"id":"/docs/access-rights/roles-and-relations-33","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"Intended for whoever curates the Capabilities registry — publishing and retiring organization-wide agents, skills and patterns after Project owners authored them. Recorded as a preset today."},"312":{"id":"/docs/access-rights/roles-and-relations-34","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"**Project Owner**"},"313":{"id":"/docs/access-rights/roles-and-relations-35","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"member"},"314":{"id":"/docs/access-rights/roles-and-relations-36","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"A preset for someone expected to own Projects; the ownership itself is granted per Project."},"315":{"id":"/docs/access-rights/roles-and-relations-37","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"**Builder**"},"316":{"id":"/docs/access-rights/roles-and-relations-38","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"member"},"317":{"id":"/docs/access-rights/roles-and-relations-39","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"The preset for people who author agents, skills, tools and flows in the Projects they belong to — their Project relation (editor or owner) is what actually allows it. Intended holder of the builder-only tools (`http.request`, `mcp.invoke`)."},"318":{"id":"/docs/access-rights/roles-and-relations-40","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"**Operator**"},"319":{"id":"/docs/access-rights/roles-and-relations-41","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"member"},"320":{"id":"/docs/access-rights/roles-and-relations-42","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"The preset for people who run and watch flows in the Projects they belong to; their Project relation decides whether they may run."},"321":{"id":"/docs/access-rights/roles-and-relations-43","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"**Member**"},"322":{"id":"/docs/access-rights/roles-and-relations-44","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"member"},"323":{"id":"/docs/access-rights/roles-and-relations-45","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"The default: works in the Projects they are given, with whatever relation they are given there."},"324":{"id":"/docs/access-rights/roles-and-relations-46","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"**Viewer**"},"325":{"id":"/docs/access-rights/roles-and-relations-47","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"member"},"326":{"id":"/docs/access-rights/roles-and-relations-48","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"Reads in the Projects they are given; a preset for guests and reviewers."},"327":{"id":"/docs/access-rights/roles-and-relations-49","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"**Service Account**"},"328":{"id":"/docs/access-rights/roles-and-relations-50","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"—"},"329":{"id":"/docs/access-rights/roles-and-relations-51","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"A service identity; not a person. Created by administrators for integrations, never invited."},"330":{"id":"/docs/access-rights/roles-and-relations-52","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"*What \"tier today\" means.* The organization-level server checks in this release know three answers: *is an\nadministrator* (Owner, Admin, Security Admin), *is an auditor*, *is a member* (everyone else). So a Builder and an\nOperator are refused the same organization screens and allowed the same organization reads — their difference is\nin the Projects they belong to and in what the Blueprint's role policies let them pick. One consequence worth\nknowing: the builder-only tools are, in this build, available to administrators only; a Builder preset does not\nyet unlock them. The Blueprint's *Builder-only tools* row still shows what will be gated on that role."},"331":{"id":"/docs/access-rights/roles-and-relations-53","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#organization-roles","content":"An organization role is set at invitation, together with the person's **clearance**, and changed later in\nPeople. You cannot change your own role."},"332":{"id":"/docs/access-rights/roles-and-relations-54","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#project-relations","content":"Inside a Project a person (or an agent) holds one relation. The Project's creator is its **owner**; everyone else\nis added by the owner or an organization administrator."},"333":{"id":"/docs/access-rights/roles-and-relations-55","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#project-relations","content":"Relation"},"334":{"id":"/docs/access-rights/roles-and-relations-56","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#project-relations","content":"Who it is for"},"335":{"id":"/docs/access-rights/roles-and-relations-57","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#project-relations","content":"Read"},"336":{"id":"/docs/access-rights/roles-and-relations-58","page_id":"/docs/access-rights/roles-and-relations","tags":[],"type":"text","url":"/docs/access-rights/roles-and-relations#project-relations","content":"Write · run · invoke"},"337":{"id":"/docs/access-rights/roles-and-relations-59",