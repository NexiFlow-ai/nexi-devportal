},"2464":{"id":"/docs/deploy/operations-114","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"volume `broker-secrets`"},"2465":{"id":"/docs/deploy/operations-115","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"PVC `nexus-core-secrets`"},"2466":{"id":"/docs/deploy/operations-116","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"the sealed files of Tier-2 credentials (absent once you use `vault://`)"},"2467":{"id":"/docs/deploy/operations-117","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"The master keys"},"2468":{"id":"/docs/deploy/operations-118","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"the `.env` file, stored like a password"},"2469":{"id":"/docs/deploy/operations-119","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"`nexus-keys` exported to your secret manager / offline"},"2470":{"id":"/docs/deploy/operations-120","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"**without them, the backup above contains credentials nobody can read**"},"2471":{"id":"/docs/deploy/operations-121","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"NATS store"},"2472":{"id":"/docs/deploy/operations-122","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"volume `natsdata` — optional"},"2473":{"id":"/docs/deploy/operations-123","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"PVC of `nexus-nats` — optional"},"2474":{"id":"/docs/deploy/operations-124","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"in-flight jobs; losing it fails running flows, never stored state"},"2475":{"id":"/docs/deploy/operations-125","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"Keycloak realm"},"2476":{"id":"/docs/deploy/operations-126","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"included in `nexus_keycloak`"},"2477":{"id":"/docs/deploy/operations-127","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"same"},"2478":{"id":"/docs/deploy/operations-128","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"users' password hashes, sessions, brokers"},"2479":{"id":"/docs/deploy/operations-129","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#backups-and-restore","content":"Restore = restore Postgres, restore the credential volume, put the same master keys in place, start the stack, run the\nsmoke. Test it once on a scratch machine before you need it."},"2480":{"id":"/docs/deploy/operations-130","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"Every process answers a health probe with a body that names its drivers — the same body the smoke report collects:"},"2481":{"id":"/docs/deploy/operations-131","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"Process"},"2482":{"id":"/docs/deploy/operations-132","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"Probe"},"2483":{"id":"/docs/deploy/operations-133","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"Body says"},"2484":{"id":"/docs/deploy/operations-134","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"core-api"},"2485":{"id":"/docs/deploy/operations-135","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"`GET /api/v1/health`"},"2486":{"id":"/docs/deploy/operations-136","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"environment, drivers, identity mode"},"2487":{"id":"/docs/deploy/operations-137","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"chat-api"},"2488":{"id":"/docs/deploy/operations-138","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"`GET /api/v1/health` (through web: `/api/v1/chat/health`)"},"2489":{"id":"/docs/deploy/operations-139","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"features on, `job_bus_driver`, `sandbox.driver`, flow-runtime counters (`handled`, `failed`, `expired_capabilities`)"},"2490":{"id":"/docs/deploy/operations-140","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"tasks-api"},"2491":{"id":"/docs/deploy/operations-141","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"`GET /api/v1/health` (through web: `/api/v1/tasks/health`)"},"2492":{"id":"/docs/deploy/operations-142","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"drivers, outbox backlog"},"2493":{"id":"/docs/deploy/operations-143","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"sandbox-manager"},"2494":{"id":"/docs/deploy/operations-144","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"`GET /health` (internal)"},"2495":{"id":"/docs/deploy/operations-145","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"`driver`, `image_digest`, `engine_reachable`, `handled`, `failed`, `pending`"},"2496":{"id":"/docs/deploy/operations-146","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"keycloak"},"2497":{"id":"/docs/deploy/operations-147","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"`GET /idp/health/ready` on the management port (internal)"},"2498":{"id":"/docs/deploy/operations-148","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"ready"},"2499":{"id":"/docs/deploy/operations-149","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"web"},"2500":{"id":"/docs/deploy/operations-150","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"`GET /chat` → 200"},"2501":{"id":"/docs/deploy/operations-151","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"the page renders"},"2502":{"id":"/docs/deploy/operations-152","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"Watch the flow-runtime and sandbox counters over time: a rising `failed` with a flat `handled` is the first sign of a\nmodel provider or a connection going bad. What people did — every sign-in, every approval, every tool call — is in\nNexCore's audit trail (Read the audit trail); what an agent turn did, step by\nstep, is in its execution trace in NexChat."},"2503":{"id":"/docs/deploy/operations-153","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#health-and-what-to-watch","content":"Logs go to stdout as structured lines; collect them with whatever your platform uses (`docker compose logs`,\nFluent Bit, CloudWatch). No secret is ever written to a log — a redaction failure is a bug to report."},"2504":{"id":"/docs/deploy/operations-154","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#hardening-that-ships-in-the-images","content":"You do not configure these; you may verify them."},"2505":{"id":"/docs/deploy/operations-155","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#hardening-that-ships-in-the-images","content":"Every image runs as a **non-root user** (`uid 10001`; the sandbox as `65532`), on a **read-only root filesystem**\nwith a small `/tmp&#x60; tmpfs, with &#x2A;*`no-new-privileges`**, and `tini` as pid 1 for clean signal handling."},"2506":{"id":"/docs/deploy/operations-156","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#hardening-that-ships-in-the-images","content":"No image contains a shell you can reach from the product: there is no exec path from a chat to a container."},"2507":{"id":"/docs/deploy/operations-157","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#hardening-that-ships-in-the-images","content":"The `web` image bakes the API origins as the contract's service names; the browser never receives a service\naddress."},"2508":{"id":"/docs/deploy/operations-158","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#hardening-that-ships-in-the-images","content":"On Kubernetes: default-deny NetworkPolicies with exactly the contract's edges; `nexus-sandbox` under Pod Security\n*restricted* with deny-all and a ResourceQuota; the manager's Role can create Jobs and read logs, never read\nSecrets or exec."},"2509":{"id":"/docs/deploy/operations-159","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#hardening-that-ships-in-the-images","content":"On Compose: only `web` and the loopback admin ports are published; `sandbox-manager` is the only container with the\nDocker socket, and the sandbox containers it starts have no network."},"2510":{"id":"/docs/deploy/operations-160","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#hosting-this-documentation","content":"This portal is a **static site** with no runtime dependency on Nexi: build it, put the `out/` directory on any web\nserver or bucket, and it works. It is optional in every deployment profile."},"2511":{"id":"/docs/deploy/operations-161","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#hosting-this-documentation","content":"The only feature that touches a Nexi is the **API playground**. The portal's small server (`npm start`)\n&#x2A;*forwards `/api/v1/*`** to the origin in `NEXUS_API_ORIGIN` — and `/api/v1/graph/*` to `NEXUS_GRAPH_ORIGIN`, because\nNexGraph's web origin is the one that routes the Graph API (default `http://127.0.0.1:3214`; on a deployment where one\norigin serves everything, set it to the same value or `off`) — so a request from the playground reaches Nexi as a\nsame-origin call and Nexi needs no CORS grant. The reader's *sign-in* travels along only when the portal is served\non **the same host name** as Nexi (a different port is fine — a browser keeps cookies per host name, not per\nport): `https://nexus.example.com:8443` next to `https://nexus.example.com` works; `docs.nexus.example.com` does not\nsee the cookie, and readers there paste a token they minted in NexCore instead (**Get my token now** on the\nAPI reference, or `curl` as described on Authenticate your API calls).\nWith `NEXUS_API_ORIGIN=off` nothing is forwarded; the playground then calls the server listed in the contract\ndirectly, which requires the portal's origin in the API's `CORS_ORIGINS`. Set `NEXT_PUBLIC_NEXUS_CORE_URL` at build\ntime so *Open NexCore* points at yours."},"2512":{"id":"/docs/deploy/operations-162","page_id":"/docs/deploy/operations","tags":[],"type":"text","url":"/docs/deploy/operations#hosting-this-documentation","content":"Back to the ladder: Deploy Nexi. Who may do what inside a running Nexi — including what an operator cannot see: Access rights."},"2513":{"id":"/docs/design-system","page_id":"/docs/design-system","type":"page","content":"Design system","breadcrumbs":["Nexi Docs","Design system"],"tags":[],"url":"/docs/design-system"},"2514":{"id":"/docs/design-system-0","page_id":"/docs/design-system","tags":[],"type":"text","url":"/docs/design-system","content":"The one look of the Nexi suite — its principles, tokens, shell, components and patterns — with every component rendered live in the workshop."},"2515":{"id":"/docs/design-system-1","page_id":"/docs/design-system","type":"heading","tags":[],"url":"/docs/design-system#how-to-read-a-component-page","content":"How to read a component page"},"2516":{"id":"/docs/design-system-2","page_id":"/docs/design-system","type":"heading","tags":[],"url":"/docs/design-system#the-rule-in-one-sentence","content":"The rule in one sentence"},"2517":{"id":"/docs/design-system-3","page_id":"/docs/design-system","tags":[],"type":"text","url":"/docs/design-system","content":"Every Nexi application is built from one kit and one set of rules. This section is that system, written once: the\npages are generated from the Design System Register, and every component is shown as it really renders, in the\n**component workshop** — a living catalogue of every component in every state, in Light and Graphite, in English and\nUkrainian."},"2518":{"id":"/docs/design-system-4","page_id":"/docs/design-system","tags":[],"type":"text","url":"/docs/design-system","content":"Principles — what the suite looks and behaves like, in fourteen sentences."},"2519":{"id":"/docs/design-system-5","page_id":"/docs/design-system","tags":[],"type":"text","url":"/docs/design-system","content":"Foundations — colour, type, spacing and density, radius and borders, elevation, motion, icons,\nviewports. Every number is a token; the workshop reads the live values."},"2520":{"id":"/docs/design-system-6","page_id":"/docs/design-system","tags":[],"type":"text","url":"/docs/design-system","content":"Layout and shell — one shell, one page frame, one way to go two levels deep, one right-hand\npanel."},"2521":{"id":"/docs/design-system-7","page_id":"/docs/design-system","tags":[],"type":"text","url":"/docs/design-system","content":"Patterns — the compositions that cover nearly every screen."},"2522":{"id":"/docs/design-system-8","page_id":"/docs/design-system","tags":[],"type":"text","url":"/docs/design-system","content":"Components — one page per component: contract, states, accessibility, stories."},"2523":{"id":"/docs/design-system-9","page_id":"/docs/design-system","tags":[],"type":"text","url":"/docs/design-system","content":"Copy and language — how the suite speaks, in two languages."},"2524":{"id":"/docs/design-system-10","page_id":"/docs/design-system","tags":[],"type":"text","url":"/docs/design-system","content":"Accessibility — what every component guarantees."},"2525":{"id":"/docs/design-system-11","page_id":"/docs/design-system","tags":[],"type":"text","url":"/docs/design-system","content":"For builders — how to add a component, write its story, and keep a new application inside the\nsystem."},"2526":{"id":"/docs/design-system-12","page_id":"/docs/design-system","tags":[],"type":"text","url":"/docs/design-system#how-to-read-a-component-page","content":"Each page carries the register id (`DS-3001` and the like), the kit export a screen imports, the sentence that *is*\nthe component's contract, the list of its states, and the stories that prove it. A story embedded on the page is the\nreal component rendered from the same code the applications ship — not a picture. *Open in the workshop* shows the\nsame story with the theme, language and density switches."},"2527":{"id":"/docs/design-system-13","page_id":"/docs/design-system","tags":[],"type":"text","url":"/docs/design-system#the-rule-in-one-sentence","content":"A screen is composed of registered components; a new idiom proposes a register row before code; a component without\na story does not exist."},"2528":{"id":"/docs/design-system/accessibility","page_id":"/docs/design-system/accessibility","type":"page","content":"Accessibility","breadcrumbs":["Nexi Docs","Design system","Writing and access"],"tags":[],"url":"/docs/design-system/accessibility"},"2529":{"id":"/docs/design-system/accessibility-0","page_id":"/docs/design-system/accessibility","tags":[],"type":"text","url":"/docs/design-system/accessibility","content":"What every component guarantees — names, focus, patterns, contrast, motion — and how it is tested."},"2530":{"id":"/docs/design-system/accessibility-1","page_id":"/docs/design-system/accessibility","type":"heading","tags":[],"url":"/docs/design-system/accessibility#what-every-component-guarantees","content":"What every component guarantees"},"2531":{"id":"/docs/design-system/accessibility-2","page_id":"/docs/design-system/accessibility","type":"heading","tags":[],"url":"/docs/design-system/accessibility#how-it-is-tested","content":"How it is tested"},"2532":{"id":"/docs/design-system/accessibility-3","page_id":"/docs/design-system/accessibility","type":"heading","tags":[],"url":"/docs/design-system/accessibility#where-the-rules-live","content":"Where the rules live"},"2533":{"id":"/docs/design-system/accessibility-4","page_id":"/docs/design-system/accessibility","tags":[],"type":"text","url":"/docs/design-system/accessibility","content":"Accessibility is not a review at the end; it is a property of every component in the kit, verified every time a story\nrenders. The target is **WCAG 2.2 AA**."},"2534":{"id":"/docs/design-system/accessibility-5","page_id":"/docs/design-system/accessibility","tags":[],"type":"text","url":"/docs/design-system/accessibility#what-every-component-guarantees","content":"**An accessible name.** Every interactive element has one — text, a label, or `aria-label` on an icon-only control.\nAn icon is decoration (`aria-hidden`); the name is on the control."},"2535":{"id":"/docs/design-system/accessibility-6","page_id":"/docs/design-system/accessibility","tags":[],"type":"text","url":"/docs/design-system/accessibility#what-every-component-guarantees","content":"**Visible focus.** Keyboard focus is a 2 px ring on every control, in both themes, never removed."},"2536":{"id":"/docs/design-system/accessibility-7","page_id":"/docs/design-system/accessibility","tags":[],"type":"text","url":"/docs/design-system/accessibility#what-every-component-guarantees","content":"**The WAI-ARIA pattern.** Tabs, menus, switches, trees, comboboxes, dialogs and separators follow the authoring\npractices: roving tab index, arrow keys, Escape closes and returns focus, outside click closes."},"2537":{"id":"/docs/design-system/accessibility-8","page_id":"/docs/design-system/accessibility","tags":[],"type":"text","url":"/docs/design-system/accessibility#what-every-component-guarantees","content":"**Target size.** A control a finger or a pointer must hit is at least 24 × 24 px."},"2538":{"id":"/docs/design-system/accessibility-9","page_id":"/docs/design-system/accessibility","tags":[],"type":"text","url":"/docs/design-system/accessibility#what-every-component-guarantees","content":"**Contrast.** Text and the borders that carry meaning hold 4.5 : 1 against their surface in Light and Graphite; the\ndata palette holds 3 : 1 against both."},"2539":{"id":"/docs/design-system/accessibility-10","page_id":"/docs/design-system/accessibility","tags":[],"type":"text","url":"/docs/design-system/accessibility#what-every-component-guarantees","content":"**Status is never colour alone.** A chip, a dot or a tint always comes with a label or an icon that says the same."},"2540":{"id":"/docs/design-system/accessibility-11","page_id":"/docs/design-system/accessibility","tags":[],"type":"text","url":"/docs/design-system/accessibility#what-every-component-guarantees","content":"**Motion can be turned off.** One shell transition and one progress pulse exist; `prefers-reduced-motion` stops\nboth."},"2541":{"id":"/docs/design-system/accessibility-12","page_id":"/docs/design-system/accessibility","tags":[],"type":"text","url":"/docs/design-system/accessibility#what-every-component-guarantees","content":"**The state ladder.** Every screen renders loading, empty, error, denied, offline and not-found states through the\nkit, each announced to assistive technology; a spinner never covers stale content."},"2542":{"id":"/docs/design-system/accessibility-13","page_id":"/docs/design-system/accessibility","tags":[],"type":"text","url":"/docs/design-system/accessibility#how-it-is-tested","content":"Every story in the workshop is also a test: it renders, its interaction runs, and an accessibility engine checks the\nresult — a serious or critical finding fails the build. The *Accessibility* panel in the workshop shows the same\nfindings interactively for any story, in any theme or language."},"2543":{"id":"/docs/design-system/accessibility-14","page_id":"/docs/design-system/accessibility","tags":[],"type":"text","url":"/docs/design-system/accessibility#where-the-rules-live","content":"The principle is DS-0008 — Keyboard and screen reader first;\neach component page has an *Accessibility* section with its own contract."},"2544":{"id":"/docs/design-system/components","page_id":"/docs/design-system/components","type":"page","content":"Components","breadcrumbs":["Nexi Docs","Design system","Components"],"tags":[],"url":"/docs/design-system/components"},"2545":{"id":"/docs/design-system/components-0","page_id":"/docs/design-system/components","tags":[],"type":"text","url":"/docs/design-system/components","content":"Every component of the kit: its contract, its states, its accessibility and its stories."},"2546":{"id":"/docs/design-system/components-1","page_id":"/docs/design-system/components","tags":[],"type":"text","url":"/docs/design-system/components","content":"The workbench kit: forty-six exports every suite app composes instead of writing its own. Each row is one component, its contract and the states its stories show."},"2547":{"id":"/docs/design-system/components-2","page_id":"/docs/design-system/components","tags":[],"type":"text","url":"/docs/design-system/components","content":"Id"},"2548":{"id":"/docs/design-system/components-3","page_id":"/docs/design-system/components","tags":[],"type":"text","url":"/docs/design-system/components","content":"Component"},"2549":{"id":"/docs/design-system/components-4","page_id":"/docs/design-system/components","tags":[],"type":"text","url":"/docs/design-system/components","content":"Export"},"2550":{"id":"/docs/design-system/components-5","page_id":"/docs/design-system/components","tags":[],"type":"text","url":"/docs/design-system/components","content":"States"},"2551":{"id":"/docs/design-system/components-6","page_id":"/docs/design-system/components","tags":[],"type":"text","url":"/docs/design-system/components","content":"DS-3001"},"2552":{"id":"/docs/design-system/components-7","page_id":"/docs/design-system/components","tags":[],"type":"text","url":"/docs/design-system/components","content":"Butto