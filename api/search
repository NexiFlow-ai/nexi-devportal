:{"id":"/docs/api/bi/semantic-8","page_id":"/docs/api/bi/semantic","tags":[],"type":"text","url":"/docs/api/bi/semantic#model-dataset","content":"Model a dataset: derive one entity from the dataset's current version — every column a field, string columns dimensions, the first period/date column the time dimension — and merge it into the Project's model (created when none exists; an entity of the same name is replaced; version += 1). The one door the Data and Metrics screens use before a first metric; the full PUT remains for hand-authored models."},"902":{"id":"/docs/api/bi/system","page_id":"/docs/api/bi/system","type":"page","content":"System","breadcrumbs":["Nexi Docs","API reference","APIs","BI API"],"tags":[],"url":"/docs/api/bi/system"},"903":{"id":"/docs/api/bi/system-0","page_id":"/docs/api/bi/system","tags":[],"type":"text","url":"/docs/api/bi/system","content":"Health and the policy status of this NexBI."},"904":{"id":"/docs/api/bi/system-1","page_id":"/docs/api/bi/system","type":"heading","tags":[],"url":"/docs/api/bi/system#health","content":"Health"},"905":{"id":"/docs/api/bi/system-2","page_id":"/docs/api/bi/system","type":"heading","tags":[],"url":"/docs/api/bi/system#get-policy-status","content":"Get policy status"},"906":{"id":"/docs/api/bi/system-3","page_id":"/docs/api/bi/system","tags":[],"type":"text","url":"/docs/api/bi/system#health","content":"Liveness + database/worker/graph-api reachability; no PEP."},"907":{"id":"/docs/api/bi/system-4","page_id":"/docs/api/bi/system","tags":[],"type":"text","url":"/docs/api/bi/system#get-policy-status","content":"AUTHZ_MODE and signed-bundle status — never rule text."},"908":{"id":"/docs/api/bi/templates","page_id":"/docs/api/bi/templates","type":"page","content":"Templates and plans","breadcrumbs":["Nexi Docs","API reference","APIs","BI API"],"tags":[],"url":"/docs/api/bi/templates"},"909":{"id":"/docs/api/bi/templates-0","page_id":"/docs/api/bi/templates","tags":[],"type":"text","url":"/docs/api/bi/templates","content":"Dashboard templates from the signed pack; a plan shows which decision perspectives a template covers here before anything is created."},"910":{"id":"/docs/api/bi/templates-1","page_id":"/docs/api/bi/templates","type":"heading","tags":[],"url":"/docs/api/bi/templates#list-templates","content":"List templates"},"911":{"id":"/docs/api/bi/templates-2","page_id":"/docs/api/bi/templates","type":"heading","tags":[],"url":"/docs/api/bi/templates#create-plan","content":"Create plan"},"912":{"id":"/docs/api/bi/templates-3","page_id":"/docs/api/bi/templates","type":"heading","tags":[],"url":"/docs/api/bi/templates#edit-plan","content":"Edit plan"},"913":{"id":"/docs/api/bi/templates-4","page_id":"/docs/api/bi/templates","type":"heading","tags":[],"url":"/docs/api/bi/templates#instantiate-plan","content":"Instantiate plan"},"914":{"id":"/docs/api/bi/templates-5","page_id":"/docs/api/bi/templates","tags":[],"type":"text","url":"/docs/api/bi/templates#list-templates","content":"Dashboard templates from installed packs (nexus-base: 4 in P0)."},"915":{"id":"/docs/api/bi/templates-6","page_id":"/docs/api/bi/templates","tags":[],"type":"text","url":"/docs/api/bi/templates#create-plan","content":"Dashboard Plan: resolve the template's slots against the semantic model and datasets → available · missing_metric · missing_data; a bi.dashboard_plan record (slots = action space)."},"916":{"id":"/docs/api/bi/templates-7","page_id":"/docs/api/bi/templates","tags":[],"type":"text","url":"/docs/api/bi/templates#edit-plan","content":"Keep/drop/reorder slots → outcome plan_edited (human_explicit)."},"917":{"id":"/docs/api/bi/templates-8","page_id":"/docs/api/bi/templates","tags":[],"type":"text","url":"/docs/api/bi/templates#instantiate-plan","content":"*Створити чернетку*: an ordinary draft dashboard with based_on_plan_ref (no template runtime)."},"918":{"id":"/docs/api/chat/agents","page_id":"/docs/api/chat/agents","type":"page","content":"Agents","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/agents"},"919":{"id":"/docs/api/chat/agents-0","page_id":"/docs/api/chat/agents","tags":[],"type":"text","url":"/docs/api/chat/agents","content":"Draft, edit, publish and bind tools to agents."},"920":{"id":"/docs/api/chat/agents-1","page_id":"/docs/api/chat/agents","type":"heading","tags":[],"url":"/docs/api/chat/agents#list-global-agents","content":"List global agents"},"921":{"id":"/docs/api/chat/agents-2","page_id":"/docs/api/chat/agents","type":"heading","tags":[],"url":"/docs/api/chat/agents#list-project-agents","content":"List project agents"},"922":{"id":"/docs/api/chat/agents-3","page_id":"/docs/api/chat/agents","type":"heading","tags":[],"url":"/docs/api/chat/agents#create-agent-draft","content":"Create agent draft"},"923":{"id":"/docs/api/chat/agents-4","page_id":"/docs/api/chat/agents","type":"heading","tags":[],"url":"/docs/api/chat/agents#get-agent","content":"Get agent"},"924":{"id":"/docs/api/chat/agents-5","page_id":"/docs/api/chat/agents","type":"heading","tags":[],"url":"/docs/api/chat/agents#update-agent","content":"Update agent"},"925":{"id":"/docs/api/chat/agents-6","page_id":"/docs/api/chat/agents","type":"heading","tags":[],"url":"/docs/api/chat/agents#get-agent-run","content":"Get agent run"},"926":{"id":"/docs/api/chat/agents-7","page_id":"/docs/api/chat/agents","type":"heading","tags":[],"url":"/docs/api/chat/agents#list-agent-versions","content":"List agent versions"},"927":{"id":"/docs/api/chat/agents-8","page_id":"/docs/api/chat/agents","type":"heading","tags":[],"url":"/docs/api/chat/agents#publish-agent","content":"Publish agent"},"928":{"id":"/docs/api/chat/agents-9","page_id":"/docs/api/chat/agents","type":"heading","tags":[],"url":"/docs/api/chat/agents#unbind-agent-tool","content":"Unbind agent tool"},"929":{"id":"/docs/api/chat/agents-10","page_id":"/docs/api/chat/agents","type":"heading","tags":[],"url":"/docs/api/chat/agents#bind-agent-tool","content":"Bind agent tool"},"930":{"id":"/docs/api/chat/agents-11","page_id":"/docs/api/chat/agents","tags":[],"type":"text","url":"/docs/api/chat/agents#list-global-agents","content":"Workspace-level published agents for global chat (project_id = null)"},"931":{"id":"/docs/api/chat/agents-12","page_id":"/docs/api/chat/agents","tags":[],"type":"text","url":"/docs/api/chat/agents#list-project-agents","content":"Agents of this Project (project-scoped + workspace-level, PEP-filtered)\n\nDefault (`include=published`) is the picker view — published, governance ≠ blocked. `include=all` is the\nmanagement view (Agents list screen) and also returns drafts, disabled and blocked agents with their\ngovernance projection; it requires `can_edit` on the Project."},"932":{"id":"/docs/api/chat/agents-13","page_id":"/docs/api/chat/agents","tags":[],"type":"text","url":"/docs/api/chat/agents#create-agent-draft","content":"AI-first create — intent → draft (status=draft)\n\nBody is `AgentDraftRequest`: `intent` alone is enough — a first-party \"Draft agent\" Skill produces name /\npurpose / instructions (deterministic fixture drafter until the Agent Runtime lands in S6). Explicit fields\noverride the draft. Nothing is published without an explicit `publish`; no tools are bound by a create.\nThe definition is owned and written by NexChat (`nexus://agent/<id>`). NexCore does not author agents\n(403 for non-human / NexCore identities): it attaches a governance record\n(`core.agent_governance`) that the PEP enforces on invoke and publish. Idempotent on `idempotency_key`."},"933":{"id":"/docs/api/chat/agents-14","page_id":"/docs/api/chat/agents","tags":[],"type":"text","url":"/docs/api/chat/agents#get-agent","content":"Agent detail (READ on the owning Project; 404 when invisible)"},"934":{"id":"/docs/api/chat/agents-15","page_id":"/docs/api/chat/agents","tags":[],"type":"text","url":"/docs/api/chat/agents#update-agent","content":"Edit a definition (WRITE on the Project; version N+1 + snapshot; status unchanged)"},"935":{"id":"/docs/api/chat/agents-16","page_id":"/docs/api/chat/agents","tags":[],"type":"text","url":"/docs/api/chat/agents#get-agent-run","content":"The AgentRun record of a turn with its ToolInvocations — initiator or Project editor"},"936":{"id":"/docs/api/chat/agents-17","page_id":"/docs/api/chat/agents","tags":[],"type":"text","url":"/docs/api/chat/agents#list-agent-versions","content":"Version snapshots (newest first) for the Versions tab"},"937":{"id":"/docs/api/chat/agents-18","page_id":"/docs/api/chat/agents","tags":[],"type":"text","url":"/docs/api/chat/agents#publish-agent","content":"Publish (PepAction=publish; Project owner only; refused when governance.state=blocked; emits `nexus.chat.agent.published.v1`): \"editor → 403.: `governance.state = blocked` → 403 with `agent.blocked.governance`.\"\nPublishing a published agent republishes the current version (idempotent)."},"938":{"id":"/docs/api/chat/agents-19","page_id":"/docs/api/chat/agents","tags":[],"type":"text","url":"/docs/api/chat/agents#unbind-agent-tool","content":"Remove the binding (WRITE on the Project)"},"939":{"id":"/docs/api/chat/agents-20","page_id":"/docs/api/chat/agents","tags":[],"type":"text","url":"/docs/api/chat/agents#bind-agent-tool","content":"Create / replace the agent's ToolBinding for one tool (human authors only)\n\nThe tool must be *available* to the agent's Project (see GET /chat/projects/{id}/tools) — otherwise 422\nwith `tool.unavailable.<reason>`. Constraints may only narrow the definition (`approval` tightens,\n`constraints.max_classification` ≤ `classification_max`); integration/custom tools need a `connection_id`.\nEmits `nexus.chat.agent.tool.bound.v1`."},"940":{"id":"/docs/api/chat/artifacts","page_id":"/docs/api/chat/artifacts","type":"page","content":"Artifacts","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/artifacts"},"941":{"id":"/docs/api/chat/artifacts-0","page_id":"/docs/api/chat/artifacts","tags":[],"type":"text","url":"/docs/api/chat/artifacts","content":"Tables, documents and files an agent produced, with versions."},"942":{"id":"/docs/api/chat/artifacts-1","page_id":"/docs/api/chat/artifacts","type":"heading","tags":[],"url":"/docs/api/chat/artifacts#list-project-artifacts","content":"List project artifacts"},"943":{"id":"/docs/api/chat/artifacts-2","page_id":"/docs/api/chat/artifacts","type":"heading","tags":[],"url":"/docs/api/chat/artifacts#create-artifact","content":"Create artifact"},"944":{"id":"/docs/api/chat/artifacts-3","page_id":"/docs/api/chat/artifacts","type":"heading","tags":[],"url":"/docs/api/chat/artifacts#get-artifact","content":"Get artifact"},"945":{"id":"/docs/api/chat/artifacts-4","page_id":"/docs/api/chat/artifacts","type":"heading","tags":[],"url":"/docs/api/chat/artifacts#rename-artifact","content":"Rename artifact"},"946":{"id":"/docs/api/chat/artifacts-5","page_id":"/docs/api/chat/artifacts","type":"heading","tags":[],"url":"/docs/api/chat/artifacts#delete-artifact-not-allowed","content":"Delete artifact not allowed"},"947":{"id":"/docs/api/chat/artifacts-6","page_id":"/docs/api/chat/artifacts","type":"heading","tags":[],"url":"/docs/api/chat/artifacts#archive-artifact","content":"Archive artifact"},"948":{"id":"/docs/api/chat/artifacts-7","page_id":"/docs/api/chat/artifacts","type":"heading","tags":[],"url":"/docs/api/chat/artifacts#restore-artifact","content":"Restore artifact"},"949":{"id":"/docs/api/chat/artifacts-8","page_id":"/docs/api/chat/artifacts","type":"heading","tags":[],"url":"/docs/api/chat/artifacts#list-artifact-references","content":"List artifact references"},"950":{"id":"/docs/api/chat/artifacts-9","page_id":"/docs/api/chat/artifacts","type":"heading","tags":[],"url":"/docs/api/chat/artifacts#publish-artifact","content":"Publish artifact"},"951":{"id":"/docs/api/chat/artifacts-10","page_id":"/docs/api/chat/artifacts","type":"heading","tags":[],"url":"/docs/api/chat/artifacts#embed-artifact-citations","content":"Embed artifact citations"},"952":{"id":"/docs/api/chat/artifacts-11","page_id":"/docs/api/chat/artifacts","type":"heading","tags":[],"url":"/docs/api/chat/artifacts#note-artifact-version","content":"Note artifact version"},"953":{"id":"/docs/api/chat/artifacts-12","page_id":"/docs/api/chat/artifacts","type":"heading","tags":[],"url":"/docs/api/chat/artifacts#list-artifact-versions","content":"List artifact versions"},"954":{"id":"/docs/api/chat/artifacts-13","page_id":"/docs/api/chat/artifacts","type":"heading","tags":[],"url":"/docs/api/chat/artifacts#create-artifact-version","content":"Create artifact version"},"955":{"id":"/docs/api/chat/artifacts-14","page_id":"/docs/api/chat/artifacts","type":"heading","tags":[],"url":"/docs/api/chat/artifacts#export-artifact","content":"Export artifact"},"956":{"id":"/docs/api/chat/artifacts-15","page_id":"/docs/api/chat/artifacts","tags":[],"type":"text","url":"/docs/api/chat/artifacts#list-project-artifacts","content":"Artifacts of a Project (metadata only, `updated_at` desc; READ on the Project ∩ state ∩ ceiling)\n\n1.139.0: visibility is applied **before** every parameter —\na reader's `status=draft` or `status=archived` is `200 []`, never 403; rows above the actor's clearance are\nabsent from the page **and** from `X-Nexus-Artifacts-Total`. Another Project's artifacts are never listed.\nAn unknown value for `type` · `created_by_kind` · `status` is 422, never ignored. `q` matches the title only\n(case- and diacritic-insensitive prefix / word), never content. Default `status` is *not archived*."},"957":{"id":"/docs/api/chat/artifacts-16","page_id":"/docs/api/chat/artifacts","tags":[],"type":"text","url":"/docs/api/chat/artifacts#create-artifact","content":"Create Artifact (document/chart/table) with first version: chart/table content MUST validate against ChartSpec/TableSpec; document is Lexical JSON\nsanitised server-side (allow-listed node types, safe link schemes, size limits). LLM output is untrusted —\nthe agent runtime parses into the spec, validation failure ⇒ 422 and the answer renders without artifact\n(never raw HTML fallback). WRITE on the Project (editor+ / delegated agent); the artifact takes the\nProject's classification unless a higher one is given (never lower). Idempotent on `idempotency_key`\n(replay ⇒ 200 with the same artifact)."},"958":{"id":"/docs/api/chat/artifacts-17","page_id":"/docs/api/chat/artifacts","tags":[],"type":"text","url":"/docs/api/chat/artifacts#get-artifact","content":"Artifact metadata + current version (READ on the owning Project; an archived artifact answers with `status = archived` to whoever could see its pre-archive status)"},"959":{"id":"/docs/api/chat/artifacts-18","page_id":"/docs/api/chat/artifacts","tags":[],"type":"text","url":"/docs/api/chat/artifacts#rename-artifact","content":"Rename (metadata — no version)\n\n1.139.0 ( door, contract fixed in S1). Project WRITE, humans only (an agent actor is 404).\nChanges `title`, moves `updated_at`, emits `nexus.chat.artifact.renamed.v1`; a repeat with the same\n`idempotency_key` is 200 with the same artifact. A reader is 404 (not-found sameness)."},"960":{"id":"/docs/api/chat/artifacts-19","page_id":"/docs/api/chat/artifacts","tags":[],"type":"text","url":"/docs/api/chat/artifacts#delete-artifact-not-allowed","content":"Not allowed — there is no delete of an artifact; the only exits are `archive` and `restore`"},"961":{"id":"/docs/api/chat/artifacts-20","page_id":"/docs/api/chat/artifacts","tags":[],"type":"text","url":"/docs/api/chat/artifacts#archive-artifact","content":"Archive (reversible)\n\n1.139.0 ( door, contract fixed in S1). Sets `status = archived`, `archived_at · archived_by ·\narchived_by_label · status_before_archive`; emits `nexus.chat.artifact.archived.v1`. Rights: a draft needs\nProject WRITE, a published artifact needs ADMINISTER; humans only. Idempotent (200 on a repeat). A caller\nwithout the right is 404 — never 403 with a reason. Every write on an archived artifact afterwards is\n409 ARTIFACT_ARCHIVED; reads and exports continue; consumers keep resolving."},"962":{"id":"/docs/api/chat/artifacts-21","page_id":"/docs/api/chat/artifacts","tags":[],"type":"text","url":"/docs/api/chat/artifacts#restore-artifact","content":"Restore to `status_before_archive` \n\n1.139.0. Returns the artifact to `draft` or `published` as it was; clears the archive fields; emits\n`nexus.chat.artifact.restored.v1`. The right is the one the pre-archive status needed. Idempotent."},"963":{"id":"/docs/api/chat/artifacts-22","page_id":"/docs/api/chat/artifacts","tags":[],"type":"text","url":"/docs/api/chat/artifacts#list-artifact-references","content":"What refers to this artifact — a live union read as the person (served from )"},"964":{"id":"/docs/api/chat/artifacts-23","page_id":"/docs/api/chat/artifacts","tags":[],"type":"text","url":"/docs/api/chat/artifacts#publish-artifact","content":"Publish to the Project (Project source → `artifact.published` → NexGraph capture )\n\nExists since (documented in 1.139.0). A person's door only — nothing auto-publishes. `status` → `published`, `published_at/by/version` set once; a second call is 200 with the id in\n`already_published` and the Project-source pin repaired. Project WRITE. An archived artifact is\n409 ARTIFACT_ARCHIVED; a notebook is 415."},"965":{"id":"/docs/api/chat/artifacts-24","page_id":"/docs/api/chat/artifacts","tags":[],"type":"text","url":"/docs/api/chat/artifacts#embed-artifact-citations","content":"Embed the answer's citations into a document artifact (documented in 1.139.0)"},"966":{"id":"/docs/api/chat/artifacts-25","page_id":"/docs/api/chat/artifacts","tags":[],"type":"text","url":"/docs/api/chat/artifacts#note-artifact-version","content":"The optional change note, after the fact (documented in 1.139.0)"},"967":{"id":"/docs/api/chat/artifacts-26","page_id":"/docs/api/chat/artifacts","tags":[],"type":"text","url":"/docs/api/chat/artifacts#list-artifact-versions","content":"All versions, ascending (content included — versions are small validated specs)"},"968":{"id":"/docs/api/chat/artifacts-27","page_id":"/docs/api/chat/artifacts","tags":[],"type":"text","url":"/docs/api/chat/artifacts#create-artifact-version","content":"New immutable version (Canvas save / Ask NEXUS rewrite result)\n\nWRITE on the Project. `base_version` must equal `current_version`, otherwise 409 (someone else saved first). Body type must match the artifact type (422). An archived artifact is 409 ARTIFACT_ARCHIVED (1.139.0)."},"969":{"id":"/docs/api/chat/artifacts-28","page_id":"/docs/api/chat/artifacts","tags":[],"type":"text","url":"/docs/api/chat/artifacts#export-artifact","content":"1.18.0 — export a Notebook artifact as .ipynb (nbformat 4) generated server-side from the canonical nexus-notebook-v1 body (own exporter; forbidden MIME outputs refused, classification banner as the first markdown cell). PepAction=export on the Project (READ is not enough). Stored as a blob (retention_class=export, Notebook.export.ipynb_ref) on first export and re-used for the same version."},"970":{"id":"/docs/api/chat/blobs","page_id":"/docs/api/chat/blobs","type":"page","content":"Blobs","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/blobs"},"971":{"id":"/docs/api/chat/blobs-0","page_id":"/docs/api/chat/blobs","tags":[],"type":"text","url":"/docs/api/chat/blobs","content":"Binary content behind attachments and artifacts."},"972":{"id":"/docs/api/chat/blobs-1","page_id":"/docs/api/chat/blobs","type":"heading","tags":[],"url":"/docs/api/chat/blobs#get-blob","content":"Get blob"},"973":{"id":"/docs/api/chat/blobs-2","page_id":"/docs/api/chat/blobs","type":"heading","tags":[],"url":"/docs/api/chat/blobs#get-blob-content","content":"Get blob content"},"974":{"id":"/docs/api/chat/blobs-3","page_id":"/docs/api/chat/blobs","tags":[],"type":"text","url":"/docs/api/chat/blobs#get-blob","content":"1.18.0 — BlobMeta of one stored blob (media type, size, sha256, classification, who / what wrote it, retention class). PepAction=read on the owning Project and clearance for the blob's classification — 404 otherwise (no existence leak). Never a location."},"975":{"id":"/docs/api/chat/blobs-4","page_id":"/docs/api/chat/blobs","tags":[],"type":"text","url":"/docs/api/chat/blobs#get-blob-content","content":"1.18.0 — stream the bytes of a blob. PepAction=read on the owning Project and clearance for the blob's classification; the digest is re-checked while streaming (mismatch → 500 BLOB_CORRUPT + audit, never partial trust). Served as an attachment with the sniffed media type — never rendered inline as HTML / script. This is the ONLY way bytes leave the store; there is no presigned or public URL. (finding 7): a blob that is an execution's code / stdout / stderr (the record's code_ref / stdout_ref / stderr_ref) follows the …/output rule — owner | editor; a viewer gets 403 SANDBOX_OUTPUT_RESTRICTED (metadata too)."},"976":{"id":"/docs/api/chat/blueprints","page_id":"/docs/api/chat/blueprints","type":"page","content":"Blueprints","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/blueprints"},"977":{"id":"/docs/api/chat/blueprints-0","page_id":"/docs/api/chat/blueprints","tags":[],"type":"text","url":"/docs/api/chat/blueprints","content":"The effective ceilings a Project inherits from its organization."},"978":{"id":"/docs/api/chat/blueprints-1","page_id":"/docs/api/chat/blueprints","type":"heading","tags":[],"url":"/docs/api/chat/blueprints#get-project-effective-blueprint","content":"Get project effective blueprint"},"979":{"id":"/docs/api/chat/blueprints-2","page_id":"/docs/api/chat/blueprints","type":"heading","tags":[],"url":"/docs/api/chat/blueprints#instantiate-flow-template","content":"Instantiate flow template"},"980":{"id":"/docs/api/chat/blueprints-3","page_id":"/docs/api/chat/blueprints","tags":[],"type":"text","url":"/docs/api/chat/blueprints#get-project-effective-blueprint","content":"Effective Blueprint for the Project (base → domain → regulatory → organization → project merged by NexCore). Drives \"Default capabilities inherited from …\", default Goal Loop, tool/model/sandbox defaults in pickers. Read-only projection of GET /blueprints/effective on core-api."},"981":{"id":"/docs/api/chat/blueprints-4","page_id":"/docs/api/chat/blueprints","tags":[],"type":"text","url":"/docs/api/chat/blueprints#instantiate-flow-template","content":"Template → instance (built in, consumed by S9). Resolves `requires` against the Project's bindings (the effective Blueprint once lands), applies its policies and returns a draft WorkflowSpec 1.2 (template.is_template=false, `template.source_*` set) for Flow Studio. When `pattern_id` is given the template is the pattern's and `origin.pattern_uri` / `origin.pattern_version` are stamped. Unresolved requirements → `origin.open_questions[]` on the draft (P0 templates have none) or 422 `unresolved_binding` when `strict=true`. Idempotent per key. Never publishes or runs."},"982":{"id":"/docs/api/chat/builder","page_id":"/docs/api/chat/builder","type":"page","content":"Tools","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/builder"},"983":{"id":"/docs/api/chat/builder-0","page_id":"/docs/api/chat/builder","type":"heading","tags":[],"url":"/docs/api/chat/builder#discover-tools-for-project","content":"Discover tools for project"},"984":{"id":"/docs/api/chat/builder-1","page_id":"/docs/api/chat/builder","type":"heading","tags":[],"url":"/docs/api/chat/builder#try-tool-for-project","content":"Try tool for project"},"985":{"id":"/docs/api/chat/builder-2","page_id":"/docs/api/chat/builder","tags":[],"type":"text","url":"/docs/api/chat/builder#discover-tools-for-project","content":"1.20.0 (U7) — the Tool Builder's import step from NexChat. Proxies NexCore `POST /tools/discover` as the platform service identity AFTER the Project `builder` PEP (owner / editor; humans only — 403 AUTHOR_NOT_HUMAN); `persist` defaults to false (dry run → candidate list with side-effect badges); the fetch of `openapi_url` / `a2a_card_url` happens in NexCore through the egress pipeline (private hosts refused before connecting — the dialog shows *This address is not allowed (private network)* with the code under details). `project_id` is required so the proposals are attributed to the Project's collection."},"986":{"id":"/docs/api/chat/builder-3","page_id":"/docs/api/chat/builder","tags":[],"type":"text","url":"/docs/api/chat/builder#try-tool-for-project","content":"1.20.0 (U7) — *Try it*. Proxies NexCore `POST /tools/{tool_id}/try` after the Project `builder` PEP (`project_id` in the body); read-only operations only (409 TRY_SIDE_EFFECT_REFUSED), result redacted per clearance, recorded as a ToolInvocation the dialog links (*Recorded as invocation …*). Humans only."},"987":{"id":"/docs/api/chat/context","page_id":"/docs/api/chat/context","type":"page","content":"Context and knowledge","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/context"},"988":{"id":"/docs/api/chat/context-0","page_id":"/docs/api/chat/context","tags":[],"type":"text","url":"/docs/api/chat/context","content":"Pinned sources, attachments and answer provenance."},"989":{"id":"/docs/api/chat/context-1","page_id":"/docs/api/chat/context","type":"heading","tags":[],"url":"/docs/api/chat/context#list-context-items","content":"List context items"},"990":{"id":"/docs/api/chat/context-2","page_id":"/docs/api/chat/context","type":"heading","tags":[],"url":"/docs/api/chat/context#pin-context-item","content":"Pin context item"},"991":{"id":"/docs/api/chat/context-3","page_id":"/docs/api/chat/context","type":"heading","tags":[],"url":"/docs/api/chat/context#create-attachment","content":"Create attachment"},"992":{"id":"/docs/api/chat/context-4","page_id":"/docs/api/chat/context","type":"heading","tags":[],"url":"/docs/api/chat/context#get-attachment","content":"Get attachment"},"993":{"id":"/docs/api/chat/context-5","page_id":"/docs/api/chat/context","type":"heading","tags":[],"url":"/docs/api/chat/context#list-project-datasets","content":"List project datasets"},"994":{"id":"/docs/api/chat/context-6","page_id":"/docs/api/chat/context","type":"heading","tags":[],"url":"/docs/api/chat/context#get-dataset","content":"Get dataset"},"995":{"id":"/docs/api/chat/context-7","page_id":"/docs/api/chat/context","type":"heading","tags":[],"url":"/docs/api/chat/context#get-dataset-schema","content":"Get dataset schema"},"996":{"id":"/docs/api/chat/context-8","page_id":"/docs/api/chat/context","type":"heading","tags":[],"url":"/docs/api/chat/context#get-answer-provenance","content":"Get answer provenance"},"997":{"id":"/docs/api/chat/context-9","page_id":"/docs/api/chat/context","type":"heading","tags":[],"url":"/docs/api/chat/context#get-grounding-figure","content":"Get grounding figure"},"998":{"id":"/docs/api/chat/context-10","page_id":"/docs/api/chat/context","tags":[],"type":"text","url":"/docs/api/chat/context#list-context-items","content":"Pinned context items (Context drawer)"},"999":{"id":"/docs/api/chat/context-11","page_id":"/docs/api/chat/context","tags":[],"type":"text","url":"/docs/api/chat/context#pin-context-item","content":"Pin to context (not knowledge verification)"},"1000":{"id":"/docs/api/chat/context-12","page_id":"/docs/api/chat/context","tags":[],"type":"text","url":"/docs/api/chat/context#create-attachment","content":"Attach a text document to the Project (1.15.0 ) — WRITE; also pins a `file` ContextItem. Text-like media only; the text never comes back over HTTP."},"1001":{"id":"/docs/api/chat/context-13","page_id":"/docs/api/chat/context","tags":[],"type":"text","url":"/docs/api/chat/context#get-attachment","content":"Attachment metadata — READ on its Project and clearance for its own level (404 otherwise, no existence leak)"},"1002":{"id":"/docs/api/chat/context-14","page_id":"/docs/api/chat/context","tags":[],"type":"text","url":"/docs/api/chat/context#list-project-datasets","content":"1.48.0: the Datasets the analysis kept in this Project — READ on the Project; a row the actor may not read (reader rule on its source) is absent, never 403. Metadata only: schema · counts · lineage · status. Filters: ?source=<attachment uri> · ?status=current|stale|superseded."},"1003":{"id":"/docs/api/chat/context-15","page_id":"/docs/api/chat/context","tags":[],"type":"text","url":"/docs/api/chat/context#get-dataset","content":"1.48.0: Dataset metadata — READ on its Project and clearance for its classification (404 otherwise, no existence leak). Rows never come back over HTTP; a sandbox reads them through the manager."},"1004":{"id":"/docs/api/chat/context-16","page_id":"/docs/api/chat/context","tags":[],"type":"text","url":"/docs/api/chat/context#get-dataset-schema","content":"1.48.0: the Dataset's fields (name · kind · nullable · role) — what the composer's Sources shows on hover. Same door as getDataset."},"1005":{"id":"/docs/api/chat/context-17","page_id":"/docs/api/chat/context","tags":[],"type":"text","url":"/docs/api/chat/context#get-answer-provenance","content":"Why this answer? — sources, tools, graph facts, model, agent, skills, timestamp. 1.44.0 — a knowledge-grounded answer lists sources[kind=knowledge] (the bundle + the items the answer cited with their [n] markers) and evidence_bundle_ref; the drawer reads the retrieval story (items[].why, explanation.steps[]) from graph-api getEvidenceBundle, which re-evaluates access at read time."},"1006":{"id":"/docs/api/chat/context-18","page_id":"/docs/api/chat/context","tags":[],"type":"text","url":"/docs/api/chat/context#get-grounding-figure","content":"1.44.0 (A1, d — PROPOSED) — the same-origin image door behind a knowledge answer's inline figures. chat-api forwards the call to graph-api GET /graph/projects/{project_id}/objects/{uri}/figure under the actor's own session assertion (never a service-wide token) and streams the bytes back with the sniffed image media type, Content-Disposition attachment semantics for non-image sniffs, Cache-Control private and a size cap. The Markdown renderer allows <img> for this path only — a URL the model writes is never rendered; the answer's {{figure:<ref>}} placeholders are validated against the bundle before they become this path (990). 404 for hidden, missing, non-figure and never-bundled items alike."},"1007":{"id":"/docs/api/chat/flows","page_id":"/docs/api/chat/flows","type":"page","content":"Flows and runs","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/flows"},"1008":{"id":"/docs/api/chat/flows-0","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows","content":"Draft, validate, publish and run flows; follow every step."},"1009":{"id":"/docs/api/chat/flows-1","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#list-project-flows","content":"List project flows"},"1010":{"id":"/docs/api/chat/flows-2","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#create-flow-draft","content":"Create flow draft"},"1011":{"id":"/docs/api/chat/flows-3","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#get-flow","content":"Get flow"},"1012":{"id":"/docs/api/chat/flows-4","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#save-flow-draft","content":"Save flow draft"},"1013":{"id":"/docs/api/chat/flows-5","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#list-flow-versions","content":"List flow versions"},"1014":{"id":"/docs/api/chat/flows-6","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#modify-flow-with-ai","content":"Modify flow with AI"},"1015":{"id":"/docs/api/chat/flows-7","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#validate-flow","content":"Validate flow"},"1016":{"id":"/docs/api/chat/flows-8","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#publish-flow","content":"Publish flow"},"1017":{"id":"/docs/api/chat/flows-9","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#disable-flow","content":"Disable flow"},"1018":{"id":"/docs/api/chat/flows-10","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#list-flow-runs","content":"List flow runs"},"1019":{"id":"/docs/api/chat/flows-11","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#start-flow-run","content":"Start flow run"},"1020":{"id":"/docs/api/chat/flows-12","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#get-flow-run","content":"Get flow run"},"1021":{"id":"/docs/api/chat/flows-13","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#list-flow-run-steps","content":"List flow run steps"},"1022":{"id":"/docs/api/chat/flows-14","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#cancel-flow-run","content":"Cancel flow run"},"1023":{"id":"/docs/api/chat/flows-15","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#retry-flow-run","content":"Retry flow run"},"1024":{"id":"/docs/api/chat/flows-16","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#pause-flow-run","content":"Pause flow run"},"1025":{"id":"/docs/api/chat/flows-17","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#resume-flow-run","content":"Resume flow run"},"1026":{"id":"/docs/api/chat/flows-18","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#receive-webhook","content":"Receive webhook"},"1027":{"id":"/docs/api/chat/flows-19","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#list-project-hooks","content":"List project hooks"},"1028":{"id":"/docs/api/chat/flows-20","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#get-flow-trigger-state","content":"Get flow trigger state"},"1029":{"id":"/docs/api/chat/flows-21","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#rotate-hook-secret","content":"Rotate hook secret"},"1030":{"id":"/docs/api/chat/flows-22","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#instantiate-flow-template","content":"Instantiate flow template"},"1031":{"id":"/docs/api/chat/flows-23","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#list-patterns","content":"List patterns"},"1032":{"id":"/docs/api/chat/flows-24","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#get-pattern","content":"Get pattern"},"1033":{"id":"/docs/api/chat/flows-25","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#recommend-patterns","content":"Recommend patterns"},"1034":{"id":"/docs/api/chat/flows-26","page_id":"/docs/api/chat/flows","type":"heading","tags":[],"url":"/docs/api/chat/flows#import-flow","content":"Import flow"},"1035":{"id":"/docs/api/chat/flows-27","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#list-project-flows","content":"Flows of a Project (screen 15) — PepAction=view on project; returns latest version per workflow_id with status + last run summary"},"1036":{"id":"/docs/api/chat/flows-28","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#create-flow-draft","content":"AI-first create — natural-language intent → Create Flow Skill → validated draft WorkflowSpec + plan + questions. Nothing is published or executed. PepAction=create on project (relation can_edit). Idempotent via body.idempotency_key."},"1037":{"id":"/docs/api/chat/flows-29","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#get-flow","content":"Latest version (or ?version=N). Published versions are immutable."},"1038":{"id":"/docs/api/chat/flows-30","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#save-flow-draft","content":"Manual edit from Flow Studio (screen 17) — full WorkflowSpec for the current draft version. Rejected with 409 if the target version is published (create a new draft instead). `layout` is stored as-is; execution fields are re-validated."},"1039":{"id":"/docs/api/chat/flows-31","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#list-flow-versions","content":"Version rows (newest first) for the Versions tab — published rows are immutable, the current draft row is re-saved in place"},"1040":{"id":"/docs/api/chat/flows-32","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#modify-flow-with-ai","content":"Ask-NEXUS-to-modify-this-flow composer (screen 17) — Create Flow Skill with base_workflow_uri/base_version → NEW draft version; the author confirms before it replaces the editor state. Never mutates a published version."},"1041":{"id":"/docs/api/chat/flows-33","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#validate-flow","content":"Semantic validation (FlowValidationCode) + policy pre-check of referenced agents/skills/tools (blocked → agent_blocked, classification_violation). Reports approvals that policy will inject at publish."},"1042":{"id":"/docs/api/chat/flows-34","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#publish-flow","content":"Publish draft version (PepAction=publish; relation owner or can_edit per Project policy). Runs validate; errors block. Policy injects approval nodes before external writes when policy.approval_for_external_writes. Version becomes immutable; trigger subscription/schedule activated; emits `nexus.chat.flow.published.v1`."},"1043":{"id":"/docs/api/chat/flows-35","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#disable-flow","content":"Stop new runs (status=disabled); running instances finish or are cancelled per ?cancel_running. Used by owners and by NexCore governance block."},"1044":{"id":"/docs/api/chat/flows-36","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#list-flow-runs","content":"Runs of a flow (newest first) — status, waiting_on, failure summary. Outputs redacted per policy.sensitive_outputs."},"1045":{"id":"/docs/api/chat/flows-37","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#start-flow-run","content":"Manual start or \"Test flow\" (test_mode=true — mutating nodes stubbed, no external writes, no approvals created; outputs marked simulated). PepAction=invoke. Server writes FlowRun + first FlowRunStep in one transaction, then publishes `nexus.jobs.run.start.v1` via outbox (1.13.0; was `nexus.jobs.flow.step.ready.v1`). Duplicate idempotency_key returns the existing run (200)."},"1046":{"id":"/docs/api/chat/flows-38","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#get-flow-run","content":"Run state (durable, from PostgreSQL — never reconstructed from NATS)"},"1047":{"id":"/docs/api/chat/flows-39","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#list-flow-run-steps","content":"Node attempts in order (timeline / debugging). 1.29.0 (hotfix 2026-09-19) — each node's newest completed row carries `output` (the payload `output_ref` points to), redacted per `policy.sensitive_outputs` for non-owners like `FlowRun.outputs`; readable by whoever may read the run (Project READ, classification ≤ clearance)."},"1048":{"id":"/docs/api/chat/flows-40","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#cancel-flow-run","content":"Cooperative cancel — status=cancelled for queued/waiting; running step finishes its attempt then stops (no new dispatch). Pending approval task in NexTasks is withdrawn. Completed external writes are NOT undone automatically (see compensation)."},"1049":{"id":"/docs/api/chat/flows-41","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#retry-flow-run","content":"Operator retry of a run in failed / needs_intervention from the failed node (new attempt with fresh idempotency_key suffix; previous external_ref shown for reconciliation). PepAction=invoke + relation owner."},"1050":{"id":"/docs/api/chat/flows-42","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#pause-flow-run","content":"1.13.0 — cooperative pause. Sets pause_requested_by; the worker finishes the *current* step and schedules nothing; status becomes `paused` with current_node_ids = the nodes that would have run next. A waiting run stays `waiting` with the flag set and pauses when it is woken. PepAction=invoke + relation owner|editor."},"1051":{"id":"/docs/api/chat/flows-43","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#resume-flow-run","content":"1.13.0 — clears the pause flag and re-publishes `nexus.jobs.run.continue.v1` for every id in current_node_ids (attempt 1, msg id dedupes a double click). Only `paused` runs (a `waiting` run with the flag set just drops the flag). PepAction=invoke + relation owner|editor."},"1052":{"id":"/docs/api/chat/flows-44","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#receive-webhook","content":"1.20.0 — the inbound webhook that starts ONE published flow (its `trigger.kind = webhook`, `trigger.webhook.hook_id`). PUBLIC (no bearer) — the signature IS the authentication. Headers `X-Nexus-Timestamp` (unix seconds) and `X-Nexus-Signature` (`sha256=<hex HMAC-SHA256 over \"<timestamp>.<raw body>\">` with the hook secret the broker resolves from `secret_ref`; constant-time compare; the previous secret stays valid for tolerance_s after a rotation). Body ≤ 256 KiB, `application/json` only. Accepted → the flow starts as its publisher's snapshot (`run_as_agent_uri` / owner), `FlowRun.trigger = {kind: webhook, source_ref: nexus://chat/webhook_receipt/<id>}`, `inputs.event = {headers (allow-listed: content-type, user-agent, x-nexus-*), body}`; 202 `{run_id}`; `nexus.chat.webhook.received.v1`. Refusals carry NO detail beyond the code — 401 WEBHOOK_SIGNATURE_INVALID · 401 WEBHOOK_STALE (|now − timestamp| > tolerance_s) · 409 WEBHOOK_REPLAY (same hook + signature inside replay_window_s) · 404 HOOK_NOT_FOUND (unknown, deprecated or disarmed hook) · 413 WEBHOOK_TOO_LARGE · 429 WEBHOOK_RATE_LIMITED (60 / min per hook). Every attempt is a WebhookReceipt (replay cache + audit; never the body)."},"1053":{"id":"/docs/api/chat/flows-45","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#list-project-hooks","content":"1.20.0 — the Project's webhook hooks (one per flow with a webhook trigger, any version state): URL path, signature scheme, `secret_ref` (never the value), arm state, last receipt. PepAction=builder (owner / editor) on the Project; humans only."},"1054":{"id":"/docs/api/chat/flows-46","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#get-flow-trigger-state","content":"1.20.1 — the arm state of the flow's `event` / `schedule` trigger — armed version, declared subject or cron + zone, next / last fire, runs started. Published flows are armed; a draft or a disabled flow reads `disarmed`. Project readers (PEP READ on the Project). The `webhook` kind reads through GET /chat/projects/{project_id}/hooks; `manual` / `api` / `chat` → 404 TRIGGER_NOT_ARMABLE."},"1055":{"id":"/docs/api/chat/flows-47","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#rotate-hook-secret","content":"1.20.0 (pattern) — generate (or rotate) the HMAC secret of this flow's webhook trigger. The secret is generated SERVER-SIDE (32 random bytes), stored through the Credential Broker under `secret_ref` and SHOWN ONCE — returned only in this response; no endpoint ever returns it again (the draft's `trigger.webhook.secret_ref` is set for the builder). Rotation keeps the previous secret valid for `tolerance_s`. Humans with `builder` on the Project (owner / editor); 409 TRIGGER_NOT_WEBHOOK when the current draft's trigger is not a webhook; audited (`flow.hook_secret.rotated`, never the value)."},"1056":{"id":"/docs/api/chat/flows-48","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#instantiate-flow-template","content":"Template → instance (built in, consumed by S9). Resolves `requires` against the Project's bindings (the effective Blueprint once lands), applies its policies and returns a draft WorkflowSpec 1.2 (template.is_template=false, `template.source_*` set) for Flow Studio. When `pattern_id` is given the template is the pattern's and `origin.pattern_uri` / `origin.pattern_version` are stamped. Unresolved requirements → `origin.open_questions[]` on the draft (P0 templates have none) or 422 `unresolved_binding` when `strict=true`. Idempotent per key. Never publishes or runs."},"1057":{"id":"/docs/api/chat/flows-49","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#list-patterns","content":"Pattern library. Read-only registry populated from the installed base pack (later installed packs); filtered by the Project's Blueprint `allowed_node_kinds` when `project_id` is given. Business copy + mini-diagram + characteristics — never a template body (GET /chat/patterns/{id} carries it). No model call."},"1058":{"id":"/docs/api/chat/flows-50","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#get-pattern","content":"One pattern with its WorkflowSpec template (read-only; the template is `is_template=true` and can never run). What the preview canvas and *Runs as-is with* render."},"1059":{"id":"/docs/api/chat/flows-51","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#recommend-patterns","content":"Describe → 0–3 recommended patterns (014). Stage 1 is deterministic over the closed `use_when` vocabulary; stage 2 is the Skill `nexus://skill/skl_recommend_pattern` on the `classifier` role through the runtime — it may reorder or drop, never add. Output ids are checked against the registry; below `min_confidence` (0.55) the list is empty and the client shows the library. Creates nothing."},"1060":{"id":"/docs/api/chat/flows-52","page_id":"/docs/api/chat/flows","tags":[],"type":"text","url":"/docs/api/chat/flows#import-flow","content":"WorkflowSpec file → Draft. The body is UNTRUSTED — ≤ 512 KiB, schema-validated with the server validator, no external `$ref`, `secret_literal` scan; identity, tenancy, version, governance, `origin.generated_by_run` and `template.is_template` are stripped / re-stamped from the Project; `origin.imported_from {filename, sha256}` is set. Any validator error creates nothing and returns the codes. Requires `flow.create` on the Project."},"1061":{"id":"/docs/api/chat/goal-loops","page_id":"/docs/api/chat/goal-loops","type":"page","content":"Goal loops and capability requests","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/goal-loops"},"1062":{"id":"/docs/api/chat/goal-loops-0","page_id":"/docs/api/chat/goal-loops","tags":[],"type":"text","url":"/docs/api/chat/goal-loops","content":"Iterations of a loop node and the requests an agent files for more capability."},"1063":{"id":"/docs/api/chat/goal-loops-1","page_id":"/docs/api/chat/goal-loops","type":"heading","tags":[],"url":"/docs/api/chat/goal-loops#recompute-flow-run","content":"Recompute flow run"},"1064":{"id":"/docs/api/chat/goal-loops-2","page_id":"/docs/api/chat/goal-loops","type":"heading","tags":[],"url":"/docs/api/chat/goal-loops#decide-research-source","content":"Decide research source"},"1065":{"id":"/docs/api/chat/goal-loops-3","page_id":"/docs/api/chat/goal-loops","type":"heading","tags":[],"url":"/docs/api/chat/goal-loops#list-flow-run-iterations","content":"List flow run iterations"},"1066":{"id":"/docs/api/chat/goal-loops-4","page_id":"/docs/api/chat/goal-loops","type":"heading","tags":[],"url":"/docs/api/chat/goal-loops#stop-flow-run-loop","content":"Stop flow run loop"},"1067":{"id":"/docs/api/chat/goal-loops-5","page_id":"/docs/api/chat/goal-loops","type":"heading","tags":[],"url":"/docs/api/chat/goal-loops#list-capability-requests","content":"List capability requests"},"1068":{"id":"/docs/api/chat/goal-loops-6","page_id":"/docs/api/chat/goal-loops","type":"heading","tags":[],"url":"/docs/api/chat/goal-loops#get-capability-request","content":"Get capability request"},"1069":{"id":"/docs/api/chat/goal-loops-7","page_id":"/docs/api/chat/goal-loops","type":"heading","tags":[],"url":"/docs/api/chat/goal-loops#cancel-capability-request","content":"Cancel capability request"},"1070":{"id":"/docs/api/chat/goal-loops-8","page_id":"/docs/api/chat/goal-loops","tags":[],"type":"text","url":"/docs/api/chat/goal-loops#recompute-flow-run","content":"1.50.0 (Q-722) — compute again what an analysis run reused. Starts a *new* run of the same flow and version with the parent's inputs plus `recompute = stages` (the plan row ids the memory port must not reuse) and `parent_run_id` = this run; the reused rows' Datasets are marked `superseded` as the new run writes theirs; the parent's `analysis_reuse` decisions receive the outcome `recomputed` (`label_source human_implicit`, rule 85). PepAction=invoke on the flow (a human; owner · editor of the Project) — the same door as starting the run. 409 `RUN_ACTIVE` while the parent is not terminal; 422 when a stage id is not one the parent reused."},"1071":{"id":"/docs/api/chat/goal-loops-9","page_id":"/docs/api/chat/goal-loops","tags":[],"type":"text","url":"/docs/api/chat/goal-loops#decide-research-source","content":"1.121.0 ((3)) — the person's answer to a completed `web-research` run's `outputs.proposed_source` (*Add to knowledge · Not now*). `add` creates the Project's `web` binding through graph-api's normal source route **as the person** (graph-api's PEP decides `binding.create`; a twin the Project already reads is found, not doubled); `not_now` changes nothing. The hosts and URLs are the run's own outputs — the body carries only the choice. Either answer is one `research_source_proposal` decision (both arms, propensity 1.0) with its `human_explicit` outcome `source_added` · `source_dismissed` (rule 85). A person only — 403 `ACTOR_NOT_HUMAN` for an agent; 409 `RUN_NOT_COMPLETED` · `NO_SOURCE_PROPOSAL`; 403 `SOURCE_ADD_DENIED` when graph-api refuses the person; 503 `GRAPH_API_UNAVAILABLE`."},"1072":{"id":"/docs/api/chat/goal-loops-10","page_id":"/docs/api/chat/goal-loops","tags":[],"type":"text","url":"/docs/api/chat/goal-loops#list-flow-run-iterations","content":"1.14.0 — loop-container iterations of a run (badge \"3 / 10\", goal progress, criteria results, budget). Read from the durable flow_loop_iterations rows (the loop's state — never reconstructed from the bus); body node attempts remain in /steps with their `iteration`. Same visibility as GET /chat/flow-runs/{run_id}."},"1073":{"id":"/docs/api/chat/goal-loops-11","page_id":"/docs/api/chat/goal-loops","tags":[],"type":"text","url":"/docs/api/chat/goal-loops#stop-flow-run-loop","content":"1.14.0 — human stop of the active loop container. Sets FlowRun.loop_stop_requested_by; the current body attempt finishes, the open pass closes with exit_reason=human_stop / stopped_by and the run follows the loop's when=needs_human edge (never silently completes the goal). PepAction=invoke + relation owner|editor. Cooperative — the response shows the flag set, the exit arrives with the next step."},"1074":{"id":"/docs/api/chat/goal-loops-12","page_id":"/docs/api/chat/goal-loops","tags":[],"type":"text","url":"/docs/api/chat/goal-loops#list-capability-requests","content":"1.19.0 — capability gaps raised by agents (a loop / agent `needs_capability` exit, a flow step on an existing but unbound tool, a sandbox package violation) in the actor's Projects. Approval itself is a NexTasks task (`approval_task_ref`); this is the NexChat read model behind the capability card (U6) and the Studio Runs wait reason. PepAction=read on each request's Project; RLS on tenant_id. `expires_at` = created + 14 d."},"1075":{"id":"/docs/api/chat/goal-loops-13","page_id":"/docs/api/chat/goal-loops","tags":[],"type":"text","url":"/docs/api/chat/goal-loops#get-capability-request","content":"1.19.0 — one request with registry matches (`requires_binding`), the drafted recommendation (`draft_uri` = a Skill draft the owner reviews per; tool / flow drafts are P1 and carry no `draft_uri`), risk, review state, the NexTasks approval ref, and after the decision `bound_uri` + `decided_by` (a human — approve = bind, the binding is created by chat-api as the decider, never by the agent). `need` is untrusted text — quoted, never executed. Same visibility as the run that raised it (404 otherwise, no existence leak)."},"1076":{"id":"/docs/api/chat/goal-loops-14","page_id":"/docs/api/chat/goal-loops","tags":[],"type":"text","url":"/docs/api/chat/goal-loops#cancel-capability-request","content":"1.19.0 — withdraw the request (Project owner or the human `requested_by.on_behalf_of_actor_id`; humans only — an agent or service principal is 403 AUTHOR_NOT_HUMAN, …03). `status = cancelled`, the linked NexTasks approval is cancelled too, `nexus.chat.capability_request.decided.v1 reason=cancelled` is emitted and the parked step fails typed `capability_rejected` (a loop follows its needs_human exit). Approval / bind / publish happen ONLY through NexTasks + registry governance — no approve endpoint exists here."},"1077":{"id":"/docs/api/chat/goals","page_id":"/docs/api/chat/goals","type":"page","content":"Goals","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/goals"},"1078":{"id":"/docs/api/chat/goals-0","page_id":"/docs/api/chat/goals","type":"heading","tags":[],"url":"/docs/api/chat/goals#get-goal","content":"Get goal"},"1079":{"id":"/docs/api/chat/goals-1","page_id":"/docs/api/chat/goals","type":"heading","tags":[],"url":"/docs/api/chat/goals#get-goal-board","content":"Get goal board"},"1080":{"id":"/docs/api/chat/goals-2","page_id":"/docs/api/chat/goals","type":"heading","tags":[],"url":"/docs/api/chat/goals#get-goal-plan-version","content":"Get goal plan version"},"1081":{"id":"/docs/api/chat/goals-3","page_id":"/docs/api/chat/goals","type":"heading","tags":[],"url":"/docs/api/chat/goals#get-goal-trace","content":"Get goal trace"},"1082":{"id":"/docs/api/chat/goals-4","page_id":"/docs/api/chat/goals","type":"heading","tags":[],"url":"/docs/api/chat/goals#amend-goal","content":"Amend goal"},"1083":{"id":"/docs/api/chat/goals-5","page_id":"/docs/api/chat/goals","type":"heading","tags":[],"url":"/docs/api/chat/goals#pause-goal","content":"Pause goal"},"1084":{"id":"/docs/api/chat/goals-6","page_id":"/docs/api/chat/goals","type":"heading","tags":[],"url":"/docs/api/chat/goals#resume-goal","content":"Resume goal"},"1085":{"id":"/docs/api/chat/goals-7","page_id":"/docs/api/chat/goals","type":"heading","tags":[],"url":"/docs/api/chat/goals#cancel-goal","content":"Cancel goal"},"1086":{"id":"/docs/api/chat/goals-8","page_id":"/docs/api/chat/goals","type":"heading","tags":[],"url":"/docs/api/chat/goals#waive-goal-criterion","content":"Waive goal criterion"},"1087":{"id":"/docs/api/chat/goals-9","page_id":"/docs/api/chat/goals","type":"heading","tags":[],"url":"/docs/api/chat/goals#reply-to-goal","content":"Reply to goal"},"1088":{"id":"/docs/api/chat/goals-10","page_id":"/docs/api/chat/goals","type":"heading","tags":[],"url":"/docs/api/chat/goals#list-thread-goals","content":"List thread goals"},"1089":{"id":"/docs/api/chat/goals-11","page_id":"/docs/api/chat/goals","tags":[],"type":"text","url":"/docs/api/chat/goals#get-goal","content":"The goal \n\n1.140.0 ( S1). PEP: OpenFGA on (project, actor) and the goal's owner — outside the\nactor's Projects the goal is 404, never 403 (the thread idiom); service and agent identities are refused on every\nwrite (403, recorded). No request text in any payload.\nReturns the GoalProcess with its current status; the card's projection is on the message (`turn_view.goal`)."},"1090":{"id":"/docs/api/chat/goals-12","page_id":"/docs/api/chat/goals","tags":[],"type":"text","url":"/docs/api/chat/goals#get-goal-board","content":"The board (*Why?* · the `goal` arm's read window)\n\n1.140.0 ( S1). PEP: OpenFGA on (project, actor) and the goal's owner — outside the\nactor's Projects the goal is 404, never 403 (the thread idiom); service and agent identities are refused on every\nwrite (403, recorded). No request text in any payload.\nAppend-only entries, newest first; `before` · `limit` paging; refs and ≤ 280-char summaries only."},"1091":{"id":"/docs/api/chat/goals-13","page_id":"/docs/api/chat/goals","tags":[],"type":"text","url":"/docs/api/chat/goals#get-goal-plan-version","content":"Plan version n with *what changed* \n\n1.140.0 ( S1). PEP: OpenFGA on (project, actor) and the goal's owner — outside the\nactor's Projects the goal is 404, never 403 (the thread idiom); service and agent identities are refused on every\nwrite (403, recorded). No request text in any payload."},"1092":{"id":"/docs/api/chat/goals-14","page_id":"/docs/api/chat/goals","tags":[],"type":"text","url":"/docs/api/chat/goals#get-goal-trace","content":"*Why?* — the goal section of the turn-trace view \n\n1.140.0 ( S1). PEP: OpenFGA on (project, actor) and the goal's owner — outside the\nactor's Projects the goal is 404, never 403 (the thread idiom); service and agent identities are refused on every\nwrite (403, recorded). No request text in any payload.\n*You asked · Understood as · Plan vN · Considered each cycle (every action and why not) · Did · Waited on · Ended* —\nfrom the goal_* decision records (rule 85), the checkpoints and the events; labels and refs only."},"1093":{"id":"/docs/api/chat/goals-15","page_id":"/docs/api/chat/goals","tags":[],"type":"text","url":"/docs/api/chat/goals#amend-goal","content":"Preview, then apply an amendment \n\n1.140.0 ( S1). PEP: OpenFGA on (project, actor) and the goal's owner — outside the\nactor's Projects the goal is 404, never 403 (the thread idiom); service and agent identities are refused on every\nwrite (403, recorded). No request text in any payload.\nWithout `apply`: returns the GoalAmendment `proposed` with its deterministic impact preview (cancels · supersedes ·\ncannot undo) — the card shows *Apply · Not now* once. With `apply: true` and the `amendment_id`: applies it\n(plan version n+1, reason amendment), writes `goal_amended` (human_explicit). Owner or Project owner only."},"1094":{"id":"/docs/api/chat/goals-16","page_id":"/docs/api/chat/goals","tags":[],"type":"text","url":"/docs/api/chat/goals#pause-goal","content":"Pause (a goal operation; the composer's Stop stays a turn operation)\n\n1.140.0 ( S1). PEP: OpenFGA on (project, actor) and the goal's owner — outside the\nactor's Projects the goal is 404, never 403 (the thread idiom); service and agent identities are refused on every\nwrite (403, recorded). No request text in any payload.\nCooperative: in-flight child runs finish their current step; nothing new is dispatched; status `paused`; writes\n`goal_paused` (human_explicit). Idempotent."},"1095":{"id":"/docs/api/chat/goals-17","page_id":"/docs/api/chat/goals","tags":[],"type":"text","url":"/docs/api/chat/goals#resume-goal","content":"Resume \n\n1.140.0 ( S1). PEP: OpenFGA on (project, actor) and the goal's owner — outside the\nactor's Projects the goal is 404, never 403 (the thread idiom); service and agent identities are refused on every\nwrite (403, recorded). No request text in any payload.\nRe-decides every pending side-effect step's rights before any dispatch; a denial parks the step `blocked`. Writes\n`goal_resumed`. Only `paused` goals."},"1096":{"id":"/docs/api/chat/goals-18","page_id":"/docs/api/chat/goals","tags":[],"type":"text","url":"/docs/api/chat/goals#cancel-goal","content":"Stop the goal \n\n1.140.0 ( S1). PEP: OpenFGA on (project, actor) and the goal's owner — outside the\nactor's Projects the goal is 404, never 403 (the thread idiom); service and agent identities are refused on every\nwrite (403, recorded). No request text in any payload.\nEnds it `cancelled`: pending steps cancelled, in-flight child runs stopped cooperatively, completed side effects\nkept with their compensation rows, the understanding and every published result kept. Writes `goal_cancelled`."},"1097":{"id":"/docs/api/chat/goals-19","page_id":"/docs/api/chat/goals","tags":[],"type":"text","url":"/docs/api/chat/goals#waive-goal-criterion","content":"Waive an open criterion \n\n1.140.0 ( S1). PEP: OpenFGA on (project, actor) and the goal's owner — outside the\nactor's Projects the goal is 404, never 403 (the thread idiom); service and agent identities are refused on every\nwrite (403, recorded). No request text in any payload.\nThe owner marks a criterion `waived` on the coverage report (`criterion_waived`, human_explicit) — the engine\nre-evaluates completion; never a machine's call."},"1098":{"id":"/docs/api/chat/goals-20","page_id":"/docs/api/chat/goals","tags":[],"type":"text","url":"/docs/api/chat/goals#reply-to-goal","content":"Answer an open question or a *Continue · Finish · Stop* choice \n\n1.140.0 ( S1). PEP: OpenFGA on (project, actor) and the goal's owner — outside the\nactor's Projects the goal is 404, never 403 (the thread idiom); service and agent identities are refused on every\nwrite (403, recorded). No request text in any payload.\nThe pick idiom's answer for a goal in `waiting_user`: a closed `choice` or a bounded `text` (the only free text —\nwritten to the board as `origin: person`). Wakes the supervisor run."},"1099":{"id":"/docs/api/chat/goals-21","page_id":"/docs/api/chat/goals","tags":[],"type":"text","url":"/docs/api/chat/goals#list-thread-goals","content":"Live and finished goals of a thread (*About this conversation*)\n\n1.140.0 ( S1). PEP: OpenFGA on (project, actor) and the goal's owner — outside the\nactor's Projects the goal is 404, never 403 (the thread idiom); service and agent identities are refused on every\nwrite (403, recorded). No request text in any payload."},"1100":{"id":"/docs/api/chat/hooks","page_id":"/docs/api/chat/hooks","type":"page","content":"Webhooks and triggers","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/hooks"},"1101":{"id":"/docs/api/chat/hooks-0","page_id":"/docs/api/chat/hooks","tags":[],"type":"text","url":"/docs/api/chat/hooks","content":"Inbound hooks that start a published flow."},"1102":{"id":"/docs/api/chat/hooks-1","page_id":"/docs/api/chat/hooks","type":"heading","tags":[],"url":"/docs/api/chat/hooks#receive-webhook","content":"Receive webhook"},"1103":{"id":"/docs/api/chat/hooks-2","page_id":"/docs/api/chat/hooks","type":"heading","tags":[],"url":"/docs/api/chat/hooks#list-project-hooks","content":"List project hooks"},"1104":{"id":"/docs/api/chat/hooks-3","page_id":"/docs/api/chat/hooks","type":"heading","tags":[],"url":"/docs/api/chat/hooks#rotate-hook-secret","content":"Rotate hook secret"},"1105":{"id":"/docs/api/chat/hooks-4","page_id":"/docs/api/chat/hooks","tags":[],"type":"text","url":"/docs/api/chat/hooks#receive-webhook","content":"1.20.0 — the inbound webhook that starts ONE published flow (its `trigger.kind = webhook`, `trigger.webhook.hook_id`). PUBLIC (no bearer) — the signature IS the authentication. Headers `X-Nexus-Timestamp` (unix seconds) and `X-Nexus-Signature` (`sha256=<hex HMAC-SHA256 over \"<timestamp>.<raw body>\">` with the hook secret the broker resolves from `secret_ref`; constant-time compare; the previous secret stays valid for tolerance_s after a rotation). Body ≤ 256 KiB, `application/json` only. Accepted → the flow starts as its publisher's snapshot (`run_as_agent_uri` / owner), `FlowRun.trigger = {kind: webhook, source_ref: nexus://chat/webhook_receipt/<id>}`, `inputs.event = {headers (allow-listed: content-type, user-agent, x-nexus-*), body}`; 202 `{run_id}`; `nexus.chat.webhook.received.v1`. Refusals carry NO detail beyond the code — 401 WEBHOOK_SIGNATURE_INVALID · 401 WEBHOOK_STALE (|now − timestamp| > tolerance_s) · 409 WEBHOOK_REPLAY (same hook + signature inside replay_window_s) · 404 HOOK_NOT_FOUND (unknown, deprecated or disarmed hook) · 413 WEBHOOK_TOO_LARGE · 429 WEBHOOK_RATE_LIMITED (60 / min per hook). Every attempt is a WebhookReceipt (replay cache + audit; never the body)."},"1106":{"id":"/docs/api/chat/hooks-5","page_id":"/docs/api/chat/hooks","tags":[],"type":"text","url":"/docs/api/chat/hooks#list-project-hooks","content":"1.20.0 — the Project's webhook hooks (one per flow with a webhook trigger, any version state): URL path, signature scheme, `secret_ref` (never the value), arm state, last receipt. PepAction=builder (owner / editor) on the Project; humans only."},"1107":{"id":"/docs/api/chat/hooks-6","page_id":"/docs/api/chat/hooks","tags":[],"type":"text","url":"/docs/api/chat/hooks#rotate-hook-secret","content":"1.20.0 (pattern) — generate (or rotate) the HMAC secret of this flow's webhook trigger. The secret is generated SERVER-SIDE (32 random bytes), stored through the Credential Broker under `secret_ref` and SHOWN ONCE — returned only in this response; no endpoint ever returns it again (the draft's `trigger.webhook.secret_ref` is set for the builder). Rotation keeps the previous secret valid for `tolerance_s`. Humans with `builder` on the Project (owner / editor); 409 TRIGGER_NOT_WEBHOOK when the current draft's trigger is not a webhook; audited (`flow.hook_secret.rotated`, never the value)."},"1108":{"id":"/docs/api/chat/messages","page_id":"/docs/api/chat/messages","type":"page","content":"Messages","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/messages"},"1109":{"id":"/docs/api/chat/messages-0","page_id":"/docs/api/chat/messages","tags":[],"type":"text","url":"/docs/api/chat/messages","content":"Send a message, read the answer stream, regenerate."},"1110":{"id":"/docs/api/chat/messages-1","page_id":"/docs/api/chat/messages","type":"heading","tags":[],"url":"/docs/api/chat/messages#list-messages","content":"List messages"},"1111":{"id":"/docs/api/chat/messages-2","page_id":"/docs/api/chat/messages","type":"heading","tags":[],"url":"/docs/api/chat/messages#send-message","content":"Send message"},"1112":{"id":"/docs/api/chat/messages-3","page_id":"/docs/api/chat/messages","type":"heading","tags":[],"url":"/docs/api/chat/messages#regenerate-message","content":"Regenerate message"},"1113":{"id":"/docs/api/chat/messages-4","page_id":"/docs/api/chat/messages","tags":[],"type":"text","url":"/docs/api/chat/messages#list-messages","content":"Messages of a thread in order (creator or can_view on its Project)"},"1114":{"id":"/docs/api/chat/messages-5","page_id":"/docs/api/chat/messages","tags":[],"type":"text","url":"/docs/api/chat/messages#send-message","content":"Send a human turn and receive the assistant turn (WRITE on thread; model re-checked against; answers with the deterministic `fixture` responder — no model call)\n\nOne transaction persists both messages and their `nexus.chat.message.created.v1` events (+ `nexus.chat.agent_run.completed.v1`).\nIf the requested model is unavailable for the Project or the agent is blocked, the assistant message is stored with\n`status=failed` and a coarse `user_message_key`; the request still returns 201. Replays of `idempotency_key` return the same turn (200)."},"1115":{"id":"/docs/api/chat/messages-6","page_id":"/docs/api/chat/messages","tags":[],"type":"text","url":"/docs/api/chat/messages#regenerate-message","content":"Regenerate the last assistant turn through the Agent Runtime — the superseded answer stays\n\nAnswers the same user message again with the history that turn had (same agent, skill and model pick). Only the\n*last* assistant message of the thread may be regenerated (`422 REGENERATE_NOT_LAST`). The new assistant message is\nappended; its AgentRun records `source.parent_message_id` = the superseded message. Replays return the same turn (200)."},"1116":{"id":"/docs/api/chat/models","page_id":"/docs/api/chat/models","type":"page","content":"Models","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/models"},"1117":{"id":"/docs/api/chat/models-0","page_id":"/docs/api/chat/models","tags":[],"type":"text","url":"/docs/api/chat/models","content":"Which models a Project may use right now."},"1118":{"id":"/docs/api/chat/models-1","page_id":"/docs/api/chat/models","type":"heading","tags":[],"url":"/docs/api/chat/models#get-global-model-availability","content":"Get global model availability"},"1119":{"id":"/docs/api/chat/models-2","page_id":"/docs/api/chat/models","type":"heading","tags":[],"url":"/docs/api/chat/models#get-model-availability","content":"Get model availability"},"1120":{"id":"/docs/api/chat/models-3","page_id":"/docs/api/chat/models","tags":[],"type":"text","url":"/docs/api/chat/models#get-global-model-availability","content":"Models for global chat (project_id = null) — UserRights ∩ DeploymentPolicy over the platform default classification"},"1121":{"id":"/docs/api/chat/models-4","page_id":"/docs/api/chat/models","tags":[],"type":"text","url":"/docs/api/chat/models#get-model-availability","content":"Models the composer may offer = UserRights ∩ ProjectPolicy ∩ AgentPolicy ∩ DeploymentPolicy. Computed server-side by OPA over the Project classification, agent policy and\ndeployment profile. Unavailable models are returned as disabled rows with a coarse reason and i18n key\n(UI: \"Unavailable for this Project\"). The response never contains provider credentials or rule text.\nRe-checked on every agent run — the picker is a hint, not authority."},"1122":{"id":"/docs/api/chat/patterns","page_id":"/docs/api/chat/patterns","type":"page","content":"Patterns","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/patterns"},"1123":{"id":"/docs/api/chat/patterns-0","page_id":"/docs/api/chat/patterns","tags":[],"type":"text","url":"/docs/api/chat/patterns","content":"Ready-made flow shapes and a recommender for the right one."},"1124":{"id":"/docs/api/chat/patterns-1","page_id":"/docs/api/chat/patterns","type":"heading","tags":[],"url":"/docs/api/chat/patterns#list-patterns","content":"List patterns"},"1125":{"id":"/docs/api/chat/patterns-2","page_id":"/docs/api/chat/patterns","type":"heading","tags":[],"url":"/docs/api/chat/patterns#get-pattern","content":"Get pattern"},"1126":{"id":"/docs/api/chat/patterns-3","page_id":"/docs/api/chat/patterns","type":"heading","tags":[],"url":"/docs/api/chat/patterns#recommend-patterns","content":"Recommend patterns"},"1127":{"id":"/docs/api/chat/patterns-4","page_id":"/docs/api/chat/patterns","tags":[],"type":"text","url":"/docs/api/chat/patterns#list-patterns","content":"Pattern library. Read-only registry populated from the installed base pack (later installed packs); filtered by the Project's Blueprint `allowed_node_kinds` when `project_id` is given. Business copy + mini-diagram + characteristics — never a template body (GET /chat/patterns/{id} carries it). No model call."},"1128":{"id":"/docs/api/chat/patterns-5","page_id":"/docs/api/chat/patterns","tags":[],"type":"text","url":"/docs/api/chat/patterns#get-pattern","content":"One pattern with its WorkflowSpec template (read-only; the template is `is_template=true` and can never run). What the preview canvas and *Runs as-is with* render."},"1129":{"id":"/docs/api/chat/patterns-6","page_id":"/docs/api/chat/patterns","tags":[],"type":"text","url":"/docs/api/chat/patterns#recommend-patterns","content":"Describe → 0–3 recommended patterns (014). Stage 1 is deterministic over the closed `use_when` vocabulary; stage 2 is the Skill `nexus://skill/skl_recommend_pattern` on the `classifier` role through the runtime — it may reorder or drop, never add. Output ids are checked against the registry; below `min_confidence` (0.55) the list is empty and the client shows the library. Creates nothing."},"1130":{"id":"/docs/api/chat/projects","page_id":"/docs/api/chat/projects","type":"page","content":"Projects","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/projects"},"1131":{"id":"/docs/api/chat/projects-0","page_id":"/docs/api/chat/projects","tags":[],"type":"text","url":"/docs/api/chat/projects","content":"A Project is the room where people, threads, knowledge and capabilities meet."},"1132":{"id":"/docs/api/chat/projects-1","page_id":"/docs/api/chat/projects","type":"heading","tags":[],"url":"/docs/api/chat/projects#list-projects","content":"List projects"},"1133":{"id":"/docs/api/chat/projects-2","page_id":"/docs/api/chat/projects","type":"heading","tags":[],"url":"/docs/api/chat/projects#create-project","content":"Create project"},"1134":{"id":"/docs/api/chat/projects-3","page_id":"/docs/api/chat/projects","type":"heading","tags":[],"url":"/docs/api/chat/projects#get-project","content":"Get project"},"1135":{"id":"/docs/api/chat/projects-4","page_id":"/docs/api/chat/projects","type":"heading","tags":[],"url":"/docs/api/chat/projects#update-project","content":"Update project"},"1136":{"id":"/docs/api/chat/projects-5","page_id":"/docs/api/chat/projects","type":"heading","tags":[],"url":"/docs/api/chat/projects#unpin-project","content":"Unpin project"},"1137":{"id":"/docs/api/chat/projects-6","page_id":"/docs/api/chat/projects","type":"heading","tags":[],"url":"/docs/api/chat/projects#pin-project","content":"Pin project"},"1138":{"id":"/docs/api/chat/projects-7","page_id":"/docs/api/chat/projects","type":"heading","tags":[],"url":"/docs/api/chat/projects#project-archive-impact","content":"Project archive impact"},"1139":{"id":"/docs/api/chat/projects-8","page_id":"/docs/api/chat/projects","type":"heading","tags":[],"url":"/docs/api/chat/projects#archive-project","content":"Archive project"},"1140":{"id":"/docs/api/chat/projects-9","page_id":"/docs/api/chat/projects","type":"heading","tags":[],"url":"/docs/api/chat/projects#restore-project","content":"Restore project"},"1141":{"id":"/docs/api/chat/projects-10","page_id":"/docs/api/chat/projects","type":"heading","tags":[],"url":"/docs/api/chat/projects#search-workspace","content":"Search workspace"},"1142":{"id":"/docs/api/chat/projects-11","page_id":"/docs/api/chat/projects","type":"heading","tags":[],"url":"/docs/api/chat/projects#list-project-members","content":"List project members"},"1143":{"id":"/docs/api/chat/projects-12","page_id":"/docs/api/chat/projects","type":"heading","tags":[],"url":"/docs/api/chat/projects#add-project-member","content":"Add project member"},"1144":{"id":"/docs/api/chat/projects-13","page_id":"/docs/api/chat/projects","type":"heading","tags":[],"url":"/docs/api/chat/projects#remove-project-member","content":"Remove project member"},"1145":{"id":"/docs/api/chat/projects-14","page_id":"/docs/api/chat/projects","type":"heading","tags":[],"url":"/docs/api/chat/projects#upsert-project-member","content":"Upsert project member"},"1146":{"id":"/docs/api/chat/projects-15","page_id":"/docs/api/chat/projects","tags":[],"type":"text","url":"/docs/api/chat/projects#list-projects","content":"Projects visible to the actor in the current workspace (OpenFGA-filtered)"},"1147":{"id":"/docs/api/chat/projects-16","page_id":"/docs/api/chat/projects","tags":[],"type":"text","url":"/docs/api/chat/projects#create-project","content":"Create Project (minimal) or create Project from an existing chat. Body is ProjectCreateRequest. Advanced settings are rejected by schema.\nWhen `from_thread` is present: the server evaluates the thread move policy (see /threads/{id}/move);\neffective classification = max(requested, source thread classification). Response lands the user in\nthe new Project chat (UI navigates to `/projects/{id}`)."},"1148":{"id":"/docs/api/chat/projects-17","page_id":"/docs/api/chat/projects","tags":[],"type":"text","url":"/docs/api/chat/projects#get-project","content":"Project detail (header, counts, instructions for editors)"},"1149":{"id":"/docs/api/chat/projects-18","page_id":"/docs/api/chat/projects","tags":[],"type":"text","url":"/docs/api/chat/projects#update-project","content":"Progressive configuration (name, description, accent, instructions, status)\n\nRequires `editor`+ (instructions/status require `owner`). `classification` is NOT patchable here —\nreclassification is a governed P1 operation with approval. Uses `version` for optimistic concurrency."},"1150":{"id":"/docs/api/chat/projects-19","page_id":"/docs/api/chat/projects","tags":[],"type":"text","url":"/docs/api/chat/projects#unpin-project","content":"Unpin this Project for *me* (1.16.0 ) — idempotent"},"1151":{"id":"/docs/api/chat/projects-20","page_id":"/docs/api/chat/projects","tags":[],"type":"text","url":"/docs/api/chat/projects#pin-project","content":"Pin this Project for *me* (1.16.0)\n\nA personal sidebar preference, like `last_opened_at`: stored per (project, actor), never shared and never a\nProject property. Requires READ on the Project; only human actors may pin (agents / services get 403).\nIdempotent — pinning twice is one pin. Response is the Project with `pinned: true`."},"1152":{"id":"/docs/api/chat/projects-21","page_id":"/docs/api/chat/projects","tags":[],"type":"text","url":"/docs/api/chat/projects#project-archive-impact","content":"What goes with this Project if archived, and what blocks it (1.17.0)\n\nFeeds the confirmation dialog: chats · agents · skills · flows that disappear from NexChat with the Project,\nand the flow runs still running (`blocked` — archive is refused until they end or are stopped). Requires\nADMINISTER on the Project, the same right the archive needs, so the dialog is offered to the same people.\nCounts are the whole Project, not only what the caller may read."},"1153":{"id":"/docs/api/chat/projects-22","page_id":"/docs/api/chat/projects","tags":[],"type":"text","url":"/docs/api/chat/projects#archive-project","content":"Archive this Project — NexChat never deletes (1.17.0)\n\nADMINISTER on the Project (owner / workspace admin) **and a human actor** — agents and services get 403\n`ARCHIVE_HUMAN_ONLY`, audited. Sets `status = archived` + `archived_at`. Everything inside is hidden *by\nderivation*: chats, agents, skills, flows, pins and attachments are not mutated, every list endpoint,\nthe sidebar, drawers, search and composer pickers leave them out because their Project is archived, and\nevery write into them answers 409 `PROJECT_ARCHIVED`. Members may still GET the Project and its content by\nid (read-only, with *Restore*). Refused with 409 `PROJECT_HAS_ACTIVE_RUNS` while a flow run of the Project\nis still running — fail closed, nothing is cancelled on the caller's behalf. Emits\n`nexus.chat.project.archived.v1` with the counts; NexCore administrators keep archived Projects (later\nslice). `PATCH {status: archived}` is the same operation with the same rules."},"1154":{"id":"/docs/api/chat/projects-23","page_id":"/docs/api/chat/projects","tags":[],"type":"text","url":"/docs/api/chat/projects#restore-project","content":"Restore an archived Project — the exact inverse (1.17.0 )\n\nSame actor rule as archive. Nothing inside was touched, so nothing inside needs restoring. 409\n`PROJECT_NAME_TAKEN` if an active Project took the name meanwhile (rename is not possible while archived —\narchive that namesake or restore under NexCore administration, later slice). Emits\n`nexus.chat.project.restored.v1`."},"1155":{"id":"/docs/api/chat/projects-24","page_id":"/docs/api/chat/projects","tags":[],"type":"text","url":"/docs/api/chat/projects#search-workspace","content":"Workspace-wide search (1.16.0, phase 2)\n\nSearches the actor's Projects, chats (global + inside visible Projects), agents, skills, flows and canvas\nartifacts by title / secondary text. Each group reuses the *list* use case of its bounded context, so the\nvisibility filter (OpenFGA relation, clearance, governance block) is exactly the one of the list endpoints —\nsearch never widens what the actor could already see. Drafts of agents / skills / flows appear only for\nactors with WRITE on the Project. Never searches message text in this slice. Results are grouped by type\nin vocabulary order and capped per type; `truncated` names the groups that had more."},"1156":{"id":"/docs/api/chat/projects-25","page_id":"/docs/api/chat/projects","tags":[],"type":"text","url":"/docs/api/chat/projects#list-project-members","content":"Memberships projection (owner/editor/viewer/agent_member)"},"1157":{"id":"/docs/api/chat/projects-26","page_id":"/docs/api/chat/projects","tags":[],"type":"text","url":"/docs/api/chat/projects#add-project-member","content":"Grant or replace a relation (owner / workspace admin only). Writes the tuple in the same transaction as the projection row.\n\n`granted_by`/`granted_at` are server-set. `owner` cannot be granted here (transfer is a P1 governed op)\nand the owner's own relation is immutable. Agents must be `agent_member` with `delegated_by`."},"1158":{"id":"/docs/api/chat/projects-27","page_id":"/docs/api/chat/projects","tags":[],"type":"text","url":"/docs/api/chat/projects#remove-project-member","content":"Revoke a relation (owner / workspace admin only). The owner cannot be removed (409)."},"1159":{"id":"/docs/api/chat/projects-28","page_id":"/docs/api/chat/projects","tags":[],"type":"text","url":"/docs/api/chat/projects#upsert-project-member","content":"Idempotent variant of addProjectMember keyed by subject (same body; `subject_id` must match the path)"},"1160":{"id":"/docs/api/chat/routes","page_id":"/docs/api/chat/routes","type":"page","content":"Routing","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/routes"},"1161":{"id":"/docs/api/chat/routes-0","page_id":"/docs/api/chat/routes","tags":[],"type":"text","url":"/docs/api/chat/routes","content":"Which agent answered, why, and how to change it."},"1162":{"id":"/docs/api/chat/routes-1","page_id":"/docs/api/chat/routes","type":"heading","tags":[],"url":"/docs/api/chat/routes#list-project-capabilities","content":"List project capabilities"},"1163":{"id":"/docs/api/chat/routes-2","page_id":"/docs/api/chat/routes","type":"heading","tags":[],"url":"/docs/api/chat/routes#get-route-decision","content":"Get route decision"},"1164":{"id":"/docs/api/chat/routes-3","page_id":"/docs/api/chat/routes","type":"heading","tags":[],"url":"/docs/api/chat/routes#confirm-route","content":"Confirm route"},"1165":{"id":"/docs/api/chat/routes-4","page_id":"/docs/api/chat/routes","type":"heading","tags":[],"url":"/docs/api/chat/routes#reroute-message","content":"Reroute message"},"1166":{"id":"/docs/api/chat/routes-5","page_id":"/docs/api/chat/routes","tags":[],"type":"text","url":"/docs/api/chat/routes#list-project-capabilities","content":"1.28.0 — the capability catalog READ MODEL of a Project as the CapabilityResolver sees it before the policy filter — `RoutableCapability` rows projected from the published Agents the Project can reach (platform pack + its own) and its published Flows, each with derived routing defaults, `requirements` and a runtime `availability` probe (model roles · tools · connections · sandbox). Interim visibility = Project READ + `published` + governance not blocked; Core CapabilityPublication replaces it at. Served from a per-Project projection rebuilt when older than `stale_after_s` (≤ 30 s) or after an agent / flow lifecycle event; `?rebuild=true` forces one. Carries no credentials, endpoints, likes or usage counters. A Project the caller may not read is a 404. Creates nothing."},"1167":{"id":"/docs/api/chat/routes-6","page_id":"/docs/api/chat/routes","tags":[],"type":"text","url":"/docs/api/chat/routes#get-route-decision","content":"*Why this route?*: the RouteDecision behind `ChatMessage.route.route_id` — structured evidence only. Readable by a member of the thread's Project (or the thread owner in Global Chat); another tenant's id → 404. Every read is audited."},"1168":{"id":"/docs/api/chat/routes-7","page_id":"/docs/api/chat/routes","tags":[],"type":"text","url":"/docs/api/chat/routes#confirm-route","content":"*Run <Flow>?* → **Run** / **Not now**. `decision=run` starts the Flow turn exactly as the composer's Flow selection would (`flow_id` + inputs) and marks the record `confirmed`; `decision=decline` marks it `declined` and the General agent answers the original text. No FlowRun exists before `run`; the PDP re-checks `flow.execute` here."},"1169":{"id":"/docs/api/chat/routes-8","page_id":"/docs/api/chat/routes","tags":[],"type":"text","url":"/docs/api/chat/routes#reroute-message","content":"*Try another route*: re-send the same user text with one of the record's eligible runners-up pinned. `capability_uri` must be in `RouteDecision.candidates[]` (eligible, executable) — anything else is 422, never a silent elevation. The previous answer stays; the old record becomes `superseded`, the new one carries `supersedes` and `decision.explicit=true`."},"1170":{"id":"/docs/api/chat/sandbox","page_id":"/docs/api/chat/sandbox","type":"page","content":"Sandbox","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/sandbox"},"1171":{"id":"/docs/api/chat/sandbox-0","page_id":"/docs/api/chat/sandbox","tags":[],"type":"text","url":"/docs/api/chat/sandbox","content":"Executions of model-generated code and their output."},"1172":{"id":"/docs/api/chat/sandbox-1","page_id":"/docs/api/chat/sandbox","type":"heading","tags":[],"url":"/docs/api/chat/sandbox#get-sandbox-execution","content":"Get sandbox execution"},"1173":{"id":"/docs/api/chat/sandbox-2","page_id":"/docs/api/chat/sandbox","type":"heading","tags":[],"url":"/docs/api/chat/sandbox#get-sandbox-execution-output","content":"Get sandbox execution output"},"1174":{"id":"/docs/api/chat/sandbox-3","page_id":"/docs/api/chat/sandbox","type":"heading","tags":[],"url":"/docs/api/chat/sandbox#export-artifact","content":"Export artifact"},"1175":{"id":"/docs/api/chat/sandbox-4","page_id":"/docs/api/chat/sandbox","tags":[],"type":"text","url":"/docs/api/chat/sandbox#get-sandbox-execution","content":"1.18.0 — the SandboxExecution record of a tool call / code step — status, effective profile, resource usage, violations (coarse codes + message keys), artifact refs, notebook_artifact_uri, blob refs for stdout / stderr. PepAction=read on the run's Project (the reader rule is inherited — a viewer sees the record). References and numbers only — never code, stdout or a traceback; the text is behind …/output. (finding 7): code_ref / stdout_ref / stderr_ref are present for Project owners and editors only — the same readers as …/output; a viewer gets the record without them, and GET /chat/blobs/{id}/content applies the same rule to those blobs (typed 403 SANDBOX_OUTPUT_RESTRICTED). data_ref blobs behind table / chart artifacts stay readable by whoever may read the artifact."},"1176":{"id":"/docs/api/chat/sandbox-5","page_id":"/docs/api/chat/sandbox","tags":[],"type":"text","url":"/docs/api/chat/sandbox#get-sandbox-execution-output","content":"1.18.0 — the bounded, redacted stdout or stderr of an execution as text (what stdout_ref / stderr_ref point to). Redacted by nexus_security before storage, truncated at the profile's limits.max_output_mb; served with the Project's classification. PepAction=read on the run's Project AND relation owner | editor — a viewer / reader gets 403 (the record stays visible, its output does not). Never HTML; never a download link."},"1177":{"id":"/docs/api/chat/sandbox-6","page_id":"/docs/api/chat/sandbox","tags":[],"type":"text","url":"/docs/api/chat/sandbox#export-artifact","content":"1.18.0 — export a Notebook artifact as .ipynb (nbformat 4) generated server-side from the canonical nexus-notebook-v1 body (own exporter; forbidden MIME outputs refused, classification banner as the first markdown cell). PepAction=export on the Project (READ is not enough). Stored as a blob (retention_class=export, Notebook.export.ipynb_ref) on first export and re-used for the same version."},"1178":{"id":"/docs/api/chat/skills","page_id":"/docs/api/chat/skills","type":"page","content":"Skills","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/skills"},"1179":{"id":"/docs/api/chat/skills-0","page_id":"/docs/api/chat/skills","tags":[],"type":"text","url":"/docs/api/chat/skills","content":"Instruction packages an agent applies — reviewed by a human before publish."},"1180":{"id":"/docs/api/chat/skills-1","page_id":"/docs/api/chat/skills","type":"heading","tags":[],"url":"/docs/api/chat/skills#list-global-skills","content":"List global skills"},"1181":{"id":"/docs/api/chat/skills-2","page_id":"/docs/api/chat/skills","type":"heading","tags":[],"url":"/docs/api/chat/skills#list-project-skills","content":"List project skills"},"1182":{"id":"/docs/api/chat/skills-3","page_id":"/docs/api/chat/skills","type":"heading","tags":[],"url":"/docs/api/chat/skills#create-skill-draft","content":"Create skill draft"},"1183":{"id":"/docs/api/chat/skills-4","page_id":"/docs/api/chat/skills","type":"heading","tags":[],"url":"/docs/api/chat/skills#get-skill","content":"Get skill"},"1184":{"id":"/docs/api/chat/skills-5","page_id":"/docs/api/chat/skills","type":"heading","tags":[],"url":"/docs/api/chat/skills#update-skill","content":"Update skill"},"1185":{"id":"/docs/api/chat/skills-6","page_id":"/docs/api/chat/skills","type":"heading","tags":[],"url":"/docs/api/chat/skills#publish-skill","content":"Publish skill"},"1186":{"id":"/docs/api/chat/skills-7","page_id":"/docs/api/chat/skills","type":"heading","tags":[],"url":"/docs/api/chat/skills#review-skill","content":"Review skill"},"1187":{"id":"/docs/api/chat/skills-8","page_id":"/docs/api/chat/skills","tags":[],"type":"text","url":"/docs/api/chat/skills#list-global-skills","content":"Platform skills for the `/` picker in global chat"},"1188":{"id":"/docs/api/chat/skills-9","page_id":"/docs/api/chat/skills","tags":[],"type":"text","url":"/docs/api/chat/skills#list-project-skills","content":"Skills for `/` picker — platform + project (+ installed once lands)"},"1189":{"id":"/docs/api/chat/skills-10","page_id":"/docs/api/chat/skills","tags":[],"type":"text","url":"/docs/api/chat/skills#create-skill-draft","content":"AI-first create — intent → SKILL.md draft package (origin=project, status=draft, 0.1.0)"},"1190":{"id":"/docs/api/chat/skills-11","page_id":"/docs/api/chat/skills","tags":[],"type":"text","url":"/docs/api/chat/skills#get-skill","content":"Skill detail (platform skills are visible to everyone in the tenant)"},"1191":{"id":"/docs/api/chat/skills-12","page_id":"/docs/api/chat/skills","tags":[],"type":"text","url":"/docs/api/chat/skills#update-skill","content":"Edit a project skill (WRITE on the Project; patch version bump; platform skills are read-only)"},"1192":{"id":"/docs/api/chat/skills-13","page_id":"/docs/api/chat/skills","tags":[],"type":"text","url":"/docs/api/chat/skills#publish-skill","content":"Publish (owner only; minor version bump; refused when governance.state=blocked or when the current version has no approved human review — 422 `skill.publish.review_required`; emits `nexus.chat.skill.published.v1`)"},"1193":{"id":"/docs/api/chat/skills-14","page_id":"/docs/api/chat/skills","tags":[],"type":"text","url":"/docs/api/chat/skills#review-skill","content":"Human review of the exact current version. Owner only; agents / service identities refused; `approved` unlocks publish for that version, any later content change resets the review to `pending`."},"1194":{"id":"/docs/api/chat/threads","page_id":"/docs/api/chat/threads","type":"page","content":"Threads","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/threads"},"1195":{"id":"/docs/api/chat/threads-0","page_id":"/docs/api/chat/threads","tags":[],"type":"text","url":"/docs/api/chat/threads","content":"Conversations — global or inside a Project."},"1196":{"id":"/docs/api/chat/threads-1","page_id":"/docs/api/chat/threads","type":"heading","tags":[],"url":"/docs/api/chat/threads#list-global-threads","content":"List global threads"},"1197":{"id":"/docs/api/chat/threads-2","page_id":"/docs/api/chat/threads","type":"heading","tags":[],"url":"/docs/api/chat/threads#create-thread","content":"Create thread"},"1198":{"id":"/docs/api/chat/threads-3","page_id":"/docs/api/chat/threads","type":"heading","tags":[],"url":"/docs/api/chat/threads#get-thread","content":"Get thread"},"1199":{"id":"/docs/api/chat/threads-4","page_id":"/docs/api/chat/threads","type":"heading","tags":[],"url":"/docs/api/chat/threads#list-project-threads","content":"List project threads"},"1200":{"id":"/docs/api/chat/threads-5","page_id":"/docs/api/chat/threads","type":"heading","tags":[],"url":"/docs/api/chat/threads#move-thread","content":"Move thread"},"1201":{"id":"/docs/api/chat/threads-6","page_id":"/docs/api/chat/threads","type":"heading","tags":[],"url":"/docs/api/chat/threads#list-move-targets","content":"List move targets"},"1202":{"id":"/docs/api/chat/threads-7","page_id":"/docs/api/chat/threads","type":"heading","tags":[],"url":"/docs/api/chat/threads#branch-thread","content":"Branch thread"},"1203":{"id":"/docs/api/chat/threads-8","page_id":"/docs/api/chat/threads","type":"heading","tags":[],"url":"/docs/api/chat/threads#list-branches","content":"List branches"},"1204":{"id":"/docs/api/chat/threads-9","page_id":"/docs/api/chat/threads","type":"heading","tags":[],"url":"/docs/api/chat/threads#archive-thread","content":"Archive thread"},"1205":{"id":"/docs/api/chat/threads-10","page_id":"/docs/api/chat/threads","type":"heading","tags":[],"url":"/docs/api/chat/threads#restore-thread","content":"Restore thread"},"1206":{"id":"/docs/api/chat/threads-11","page_id":"/docs/api/chat/threads","type":"heading","tags":[],"url":"/docs/api/chat/threads#get-route-decision","content":"Get route decision"},"1207":{"id":"/docs/api/chat/threads-12","page_id":"/docs/api/chat/threads","type":"heading","tags":[],"url":"/docs/api/chat/threads#confirm-route","content":"Confirm route"},"1208":{"id":"/docs/api/chat/threads-13","page_id":"/docs/api/chat/threads","type":"heading","tags":[],"url":"/docs/api/chat/threads#reroute-message","content":"Reroute message"},"1209":{"id":"/docs/api/chat/threads-14","page_id":"/docs/api/chat/threads","tags":[],"type":"text","url":"/docs/api/chat/threads#list-global-threads","content":"Global chats of the actor (project_id = null) — private to their creator (+ workspace admin), newest first"},"1210":{"id":"/docs/api/chat/threads-15","page_id":"/docs/api/chat/threads","tags":[],"type":"text","url":"/docs/api/chat/threads#create-thread","content":"Create a thread — global (no project_id) or inside a Project (editor+, FGA can_add_thread)"},"1211":{"id":"/docs/api/chat/threads-16","page_id":"/docs/api/chat/threads","tags":[],"type":"text","url":"/docs/api/chat/threads#get-thread","content":"Thread visible to the actor (creator or can_view on its Project)"},"1212":{"id":"/docs/api/chat/threads-17","page_id":"/docs/api/chat/threads","tags":[],"type":"text","url":"/docs/api/chat/threads#list-project-threads","content":"Threads of a Project (can_view), newest first"},"1213":{"id":"/docs/api/chat/threads-18","page_id":"/docs/api/chat/threads","tags":[],"type":"text","url":"/docs/api/chat/threads#move-thread","content":"Move chat to a Project (governed)\n\n/007. Server checks: actor is editor+ on target AND owner/editor on source (or thread owner);\nOPA: target classification ≥ effective thread classification (no downgrade), source compatibility\n(pinned sources/attachments allowed in target), purpose. Deny → ThreadMoveResponse with coarse\nblockers (`classification_downgrade`, `target_access`, `source_incompatible`, `policy`) and\n`user_message_key`. `require_approval` → NexTasks approval task; thread stays in place until decided.\nAudit event `nexus.chat.thread.moved.v1` (allow) or `nexus.core.audit.recorded.v1` (deny) after commit."},"1214":{"id":"/docs/api/chat/threads-19","page_id":"/docs/api/chat/threads","tags":[],"type":"text","url":"/docs/api/chat/threads#list-move-targets","content":"Projects offered in the \"Move to project\" modal, each with a pre-evaluated allow/deny + message key\n\nPre-flight only (UI hint). The actual move re-evaluates policy server-side."},"1215":{"id":"/docs/api/chat/threads-20","page_id":"/docs/api/chat/threads","tags":[],"type":"text","url":"/docs/api/chat/threads#branch-thread","content":"Branch conversation from a message — main thread untouched"},"1216":{"id":"/docs/api/chat/threads-21","page_id":"/docs/api/chat/threads","tags":[],"type":"text","url":"/docs/api/chat/threads#list-branches","content":"Branches of a thread, newest first — each re-checked against the reader's rights"},"1217":{"id":"/docs/api/chat/threads-22","page_id":"/docs/api/chat/threads","tags":[],"type":"text","url":"/docs/api/chat/threads#archive-thread","content":"Archive this chat — never deleted (1.17.0)\n\nThe chat's creator, or anyone with ADMINISTER on the enclosing Project (global chats: the creator only);\nhumans only (403 `ARCHIVE_HUMAN_ONLY`, audited). Sets `archived_at`; the chat leaves RECENT, the Project's\nlist, the drawers and search, and refuses new turns (409 `THREAD_ARCHIVED`); GET by id still answers\n(read-only, with *Restore*). 409 `PROJECT_ARCHIVED` if the whole Project is archived — its chats go with\nit and come back with it. Emits `nexus.chat.thread.archived.v1`. No body: archiving is not versioned\nagainst concurrent edits — a chat has none."},"1218":{"id":"/docs/api/chat/threads-23","page_id":"/docs/api/chat/threads","tags":[],"type":"text","url":"/docs/api/chat/threads#restore-thread","content":"Restore an archived chat (1.17.0 ) — the exact inverse"},"1219":{"id":"/docs/api/chat/threads-24","page_id":"/docs/api/chat/threads","tags":[],"type":"text","url":"/docs/api/chat/threads#get-route-decision","content":"*Why this route?*: the RouteDecision behind `ChatMessage.route.route_id` — structured evidence only. Readable by a member of the thread's Project (or the thread owner in Global Chat); another tenant's id → 404. Every read is audited."},"1220":{"id":"/docs/api/chat/threads-25","page_id":"/docs/api/chat/threads","tags":[],"type":"text","url":"/docs/api/chat/threads#confirm-route","content":"*Run <Flow>?* → **Run** / **Not now**. `decision=run` starts the Flow turn exactly as the composer's Flow selection would (`flow_id` + inputs) and marks the record `confirmed`; `decision=decline` marks it `declined` and the General agent answers the original text. No FlowRun exists before `run`; the PDP re-checks `flow.execute` here."},"1221":{"id":"/docs/api/chat/threads-26","page_id":"/docs/api/chat/threads","tags":[],"type":"text","url":"/docs/api/chat/threads#reroute-message","content":"*Try another route*: re-send the same user text with one of the record's eligible runners-up pinned. `capability_uri` must be in `RouteDecision.candidates[]` (eligible, executable) — anything else is 422, never a silent elevation. The previous answer stays; the old record becomes `superseded`, the new one carries `supersedes` and `decision.explicit=true`."},"1222":{"id":"/docs/api/chat/tools","page_id":"/docs/api/chat/tools","type":"page","content":"Tools","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/tools"},"1223":{"id":"/docs/api/chat/tools-0","page_id":"/docs/api/chat/tools","tags":[],"type":"text","url":"/docs/api/chat/tools","content":"Discover what a Project may use and try a tool before binding it."},"1224":{"id":"/docs/api/chat/tools-1","page_id":"/docs/api/chat/tools","type":"heading","tags":[],"url":"/docs/api/chat/tools#get-tool-availability","content":"Get tool availability"},"1225":{"id":"/docs/api/chat/tools-2","page_id":"/docs/api/chat/tools","type":"heading","tags":[],"url":"/docs/api/chat/tools#unbind-agent-tool","content":"Unbind agent tool"},"1226":{"id":"/docs/api/chat/tools-3","page_id":"/docs/api/chat/tools","type":"heading","tags":[],"url":"/docs/api/chat/tools#bind-agent-tool","content":"Bind agent tool"},"1227":{"id":"/docs/api/chat/tools-4","page_id":"/docs/api/chat/tools","type":"heading","tags":[],"url":"/docs/api/chat/tools#discover-tools-for-project","content":"Discover tools for project"},"1228":{"id":"/docs/api/chat/tools-5","page_id":"/docs/api/chat/tools","type":"heading","tags":[],"url":"/docs/api/chat/tools#try-tool-for-project","content":"Try tool for project"},"1229":{"id":"/docs/api/chat/tools-6","page_id":"/docs/api/chat/tools","tags":[],"type":"text","url":"/docs/api/chat/tools#get-tool-availability","content":"Tools the Project's agents and flows may call = Registry ∩ ProjectPolicy ∩ Enablement ∩ Classification ∩ ConnectionHealth\n\n (S5a). NexChat reads the NexCore Tool Registry (GET /tools) and projects it onto the Project:\n`disabled` (enablement ≠ enabled), `classification` (project classification > tool.classification_max),\n`connection` (no healthy connection for integration/custom tools), `builder_only` (http.request / mcp.invoke\nhidden from business users), `unbound` (agent_id given and no ToolBinding — S5), `governance` (blocked).\nSame contract as model availability: coarse reason + i18n key, never endpoints, credentials or rule text.\nRegistry unreachable ⇒ 503 fail closed. The picker is a hint — every invocation is re-checked."},"1230":{"id":"/docs/api/chat/tools-7","page_id":"/docs/api/chat/tools","tags":[],"type":"text","url":"/docs/api/chat/tools#unbind-agent-tool","content":"Remove the binding (WRITE on the Project)"},"1231":{"id":"/docs/api/chat/tools-8","page_id":"/docs/api/chat/tools","tags":[],"type":"text","url":"/docs/api/chat/tools#bind-agent-tool","content":"Create / replace the agent's ToolBinding for one tool (human authors only)\n\nThe tool must be *available* to the agent's Project (see GET /chat/projects/{id}/tools) — otherwise 422\nwith `tool.unavailable.<reason>`. Constraints may only narrow the definition (`approval` tightens,\n`constraints.max_classification` ≤ `classification_max`); integration/custom tools need a `connection_id`.\nEmits `nexus.chat.agent.tool.bound.v1`."},"1232":{"id":"/docs/api/chat/tools-9","page_id":"/docs/api/chat/tools","tags":[],"type":"text","url":"/docs/api/chat/tools#discover-tools-for-project","content":"1.20.0 (U7) — the Tool Builder's import step from NexChat. Proxies NexCore `POST /tools/discover` as the platform service identity AFTER the Project `builder` PEP (owner / editor; humans only — 403 AUTHOR_NOT_HUMAN); `persist` defaults to false (dry run → candidate list with side-effect badges); the fetch of `openapi_url` / `a2a_card_url` happens in NexCore through the egress pipeline (private hosts refused before connecting — the dialog shows *This address is not allowed (private network)* with the code under details). `project_id` is required so the proposals are attributed to the Project's collection."},"1233":{"id":"/docs/api/chat/tools-10","page_id":"/docs/api/chat/tools","tags":[],"type":"text","url":"/docs/api/chat/tools#try-tool-for-project","content":"1.20.0 (U7) — *Try it*. Proxies NexCore `POST /tools/{tool_id}/try` after the Project `builder` PEP (`project_id` in the body); read-only operations only (409 TRY_SIDE_EFFECT_REFUSED), result redacted per clearance, recorded as a ToolInvocation the dialog links (*Recorded as invocation …*). Humans only."},"1234":{"id":"/docs/api/chat/triggers","page_id":"/docs/api/chat/triggers","type":"page","content":"Webhooks and triggers","breadcrumbs":["Nexi Docs","API reference","APIs","Chat API"],"tags":[],"url":"/docs/api/chat/triggers"},"1235":{"id":"/docs/api/chat/triggers-0","page_id":"/docs/api/chat/triggers","type":"heading","tags":[],"url":"/docs/api/chat/triggers#get-flow-trigger-state","content":"Get flow trigger state"},"1236":{"id":"/docs/api/chat/triggers-1","page_id":"/docs/api/chat/triggers","tags":[],"type":"text","url":"/docs/api/chat/triggers#get-flow-trigger-state","content":"1.20.1 — the arm state of the flow's `event` / `schedule` trigger — armed version, declared subject or cron + zone, next / last fire, runs started. Published flows are armed; a draft or a disabled flow reads `disarmed`. Project readers (PEP READ on the Project). The `webhook` kind reads through GET /chat/projects/{project_id}/hooks; `manual` / `api` / `chat` → 404 TRIGGER_NOT_ARMABLE."},"1237":{"id":"/docs/api/graph/datasets","page_id":"/docs/api/graph/datasets","type":"page","content":"Datasets","breadcrumbs":["Nexi Docs","API reference","APIs","Graph API"],"tags":[],"url":"/docs/api/graph/datasets"},"1238":{"id":"/docs/api/graph/datasets-0","page_id":"/docs/api/graph/datasets","tags":[],"type":"text","url":"/docs/api/graph/datasets","content":"Dataset versions published from the graph for NexBI."},"1239":{"id":"/docs/api/graph/datasets-1","page_id":"/docs/api/graph/datasets","type":"heading","tags":[],"url":"/docs/api/graph/datasets#list-dataset-versions","content":"List dataset versions"},"1240":{"id":"/docs/api/graph/datasets-2","page_id":"/docs/api/graph/datasets","type":"heading","tags":[],"url":"/docs/api/graph/datasets#publish-dataset-version","content":"Publish dataset version"},"1241":{"id":"/docs/api/graph/datasets-3","page_id":"/docs/api/graph/datasets","type":"heading","tags":[],"url":"/docs/api/graph/datasets#get-dataset-version","content":"Get dataset version"},"1242":{"id":"/docs/api/graph/datasets-4","page